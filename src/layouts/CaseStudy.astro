---
import Base from './Base.astro';
import ScrollProgress from '../components/ScrollProgress.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const { title, description, ogImage } = Astro.props;
---

<Base title={title} description={description} ogImage={ogImage} activeNav="work">
  <ScrollProgress />
  <slot />
</Base>

---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Cursor from '../components/Cursor.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  activeNav?: 'work' | 'about';
}

const {
  title,
  description = 'Product Designer specialising in complex enterprise systems, from AI companion apps and industrial safety platforms to API infrastructure.',
  ogImage = '/og/default.png',
  activeNav
} = Astro.props;

const siteUrl = Astro.site ?? 'https://sayantandutta.com';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
---

<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- OG / Social -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(ogImage, siteUrl)} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, siteUrl)} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <ClientRouter />

  <!-- Applied before paint: restore theme + mark JS available (gates scroll-reveal) -->
  <script is:inline>
    (function() {
      var saved = localStorage.getItem('theme');
      if (saved) document.documentElement.dataset.theme = saved;
      document.documentElement.classList.add('has-js');
    })();
  </script>
</head>
<body>
  <!-- a11y: WCAG 2.4.1 Bypass Blocks. Hidden until focused by keyboard. -->
  <a href="#main" class="skip-link">Skip to main content</a>

  <Cursor />
  <Nav activeNav={activeNav} />
  <!-- a11y: WCAG 1.3.1 + 2.4.1 — a single <main> landmark per page.
       tabindex="-1" lets the skip link programmatically focus this region
       on activation so the next Tab moves into page content, not the nav. -->
  <main id="main" tabindex="-1"><slot /></main>
  <Footer />

  <!-- Scroll reveal — Motion's inView() detects viewport entry; CSS runs the transition -->
  <script>
    import { inView } from 'motion';

    function initReveal() {
      document.querySelectorAll<HTMLElement>('.reveal:not(.visible)').forEach((el) => {
        inView(el, () => { el.classList.add('visible'); }, { margin: '0px 0px -30px 0px' });
      });
    }
    initReveal();
    document.addEventListener('astro:page-load', initReveal);
  </script>

  <!-- Nav scroll behaviour -->
  <script>
    // Module-scoped flag survives across astro:page-load fires (because the
    // module is only evaluated once). Without this, every nav re-runs initNav
    // and stacks another scroll listener on the window.
    let navBound = false;
    function initNav() {
      const nav = document.querySelector('.nav') as HTMLElement | null;
      if (!nav) return;
      nav.classList.toggle('scrolled', scrollY > 40);
      if (navBound) return;
      navBound = true;
      window.addEventListener('scroll', () => nav.classList.toggle('scrolled', scrollY > 40), { passive: true });
    }
    initNav();
    document.addEventListener('astro:page-load', initNav);
  </script>

  <!-- Theme toggle -->
  <script>
    // The toggle button persists across view transitions (transition:persist on
    // .nav), but this script can run again. Tag the button so we don't bind a
    // second click handler -- two handlers would toggle twice and cancel out.
    function initTheme() {
      const btn = document.getElementById('theme-toggle') as HTMLButtonElement | null;
      if (!btn) return;
      const html = document.documentElement;
      const current = (localStorage.getItem('theme') ?? html.dataset.theme ?? 'dark') as 'dark' | 'light';
      html.dataset.theme = current;
      updateButton(current);
      if (btn.dataset.bound === '1') return;
      btn.dataset.bound = '1';
      btn.addEventListener('click', () => {
        const next = html.dataset.theme === 'dark' ? 'light' : 'dark';
        html.dataset.theme = next;
        localStorage.setItem('theme', next);
        updateButton(next);
      });

      // a11y: keep the icon (decorative) and the aria-label (announced)
      // in sync. The label always describes the action, not the state.
      function updateButton(theme: string) {
        if (!btn) return;
        const icon = btn.querySelector('span[aria-hidden]') as HTMLElement | null;
        if (icon) icon.textContent = theme === 'dark' ? '☀' : '◑';
        btn.setAttribute('aria-label', theme === 'dark' ? 'Switch to light theme' : 'Switch to dark theme');
      }
    }
    initTheme();
    document.addEventListener('astro:page-load', initTheme);
  </script>
</body>
</html>

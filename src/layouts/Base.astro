---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Cursor from '../components/Cursor.astro';
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  activeNav?: 'work' | 'about';
}

const {
  title,
  description = 'Senior UX & Service Designer specialising in complex enterprise systems — from industrial safety platforms to API infrastructure.',
  ogImage = '/og/default.png',
  activeNav
} = Astro.props;

const siteUrl = Astro.site ?? 'https://sayantandutta.com';
const canonicalURL = new URL(Astro.url.pathname, siteUrl);
---

<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />

  <!-- OG / Social -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={new URL(ogImage, siteUrl)} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={new URL(ogImage, siteUrl)} />

  <!-- Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,600&family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500&family=JetBrains+Mono:wght@400;500&display=swap"
    rel="stylesheet"
  />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <ClientRouter />

  <!-- Applied before paint: restore theme + mark JS available (gates scroll-reveal) -->
  <script is:inline>
    (function() {
      var saved = localStorage.getItem('theme');
      if (saved) document.documentElement.dataset.theme = saved;
      document.documentElement.classList.add('has-js');
    })();
  </script>
</head>
<body>
  <Cursor />
  <Nav activeNav={activeNav} />
  <slot />
  <Footer />

  <!-- Scroll reveal — Motion's inView() detects viewport entry; CSS runs the transition -->
  <script>
    import { inView } from 'motion';

    function initReveal() {
      document.querySelectorAll<HTMLElement>('.reveal:not(.visible)').forEach((el) => {
        inView(el, () => { el.classList.add('visible'); }, { margin: '0px 0px -30px 0px' });
      });
    }
    initReveal();
    document.addEventListener('astro:page-load', initReveal);
  </script>

  <!-- Nav scroll behaviour -->
  <script>
    function initNav() {
      const nav = document.querySelector('.nav') as HTMLElement | null;
      if (!nav) return;
      window.addEventListener('scroll', () => nav.classList.toggle('scrolled', scrollY > 40), { passive: true });
      nav.classList.toggle('scrolled', scrollY > 40);
    }
    initNav();
    document.addEventListener('astro:page-load', initNav);
  </script>

  <!-- Theme toggle -->
  <script>
    function initTheme() {
      const btn = document.getElementById('theme-toggle');
      if (!btn) return;
      const html = document.documentElement;
      const saved = localStorage.getItem('theme') ?? 'dark';
      html.dataset.theme = saved;
      updateIcon(saved);

      btn.addEventListener('click', () => {
        const next = html.dataset.theme === 'dark' ? 'light' : 'dark';
        html.dataset.theme = next;
        localStorage.setItem('theme', next);
        updateIcon(next);
      });

      function updateIcon(theme: string) {
        if (btn) btn.textContent = theme === 'dark' ? '☀' : '◑';
      }
    }
    initTheme();
    document.addEventListener('astro:page-load', initTheme);
  </script>
</body>
</html>

---
/**
 * Wraps a screenshot in a subtle app-window frame so light product UI reads
 * as a real product on the dark theme. Editorial treatment: a thin monospace
 * label bar instead of cliché traffic-light dots.
 *
 * Usage:
 *   <BrowserFrame label="Analytics Dashboard">
 *     <Image src={shot} alt="..." />
 *   </BrowserFrame>
 */
interface Props {
  label: string;
}
const { label } = Astro.props;
---

<div class="browser-frame">
  <div class="browser-frame-bar">
    <span class="browser-frame-label">{label}</span>
    <span class="browser-frame-dots" aria-hidden="true">
      <span></span><span></span><span></span>
    </span>
  </div>
  <div class="browser-frame-body">
    <slot />
  </div>
</div>

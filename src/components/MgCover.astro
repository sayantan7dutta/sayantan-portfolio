---
/**
 * Branded mini cover for miiGenie — used in the MoreCaseStudies grid,
 * where the 3-phone trio would shrink into unreadable slivers (the
 * KinVault lesson). Deep teal field, wordmark, and a voice-waveform
 * motif in the brand's warm cream.
 */
---

<div class="mg-cover">
  <div class="mg-head">
    <span class="mg-brand">miiGenie</span>
    <span class="mg-badge">Current</span>
  </div>

  <div class="mg-wave" aria-hidden="true">
    <span></span><span></span><span></span><span></span><span></span><span></span><span></span>
  </div>

  <p class="mg-line">A voice-first AI companion for older adults</p>

  <div class="mg-foot">
    <span class="mg-meta">Founding Product Designer</span>
    <span class="mg-meta">iOS · Android</span>
  </div>
</div>

<style>
  .mg-cover {
    width: 100%;
    height: 100%;
    background: #0E5A5A;
    color: #F7F3EC;
    /* a11y: trimmed from 1.5/1.3rem to absorb the taller 11px-floor text */
    padding: 1.1rem 1.5rem 1rem;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    font-family: var(--font-body);
  }
  .mg-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .mg-brand {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: .01em;
  }
  .mg-badge {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: .14em;
    text-transform: uppercase;
    padding: .25rem .5rem;
    border: 1px solid rgba(247, 243, 236, .45);
    border-radius: 2px;
    color: #F7E3C8;
  }
  .mg-wave {
    display: flex;
    align-items: center;
    gap: .45rem;
    /* flex-shrink:0 — as a column flex child the wave was being crushed to
       0 height once the 11px-floor text grew. Shorter, but always drawn. */
    height: 16px;
    flex-shrink: 0;
  }
  .mg-wave span {
    width: 5px;
    border-radius: 3px;
    background: rgba(247, 243, 236, .85);
  }
  .mg-wave span:nth-child(1) { height: 30%; }
  .mg-wave span:nth-child(2) { height: 65%; }
  .mg-wave span:nth-child(3) { height: 100%; }
  .mg-wave span:nth-child(4) { height: 55%; }
  .mg-wave span:nth-child(5) { height: 85%; }
  .mg-wave span:nth-child(6) { height: 40%; }
  .mg-wave span:nth-child(7) { height: 22%; }
  .mg-line {
    font-family: var(--font-display);
    font-size: clamp(.9rem, 1.4vw, 1rem);
    font-weight: 500;
    line-height: 1.25;
    margin: 0;
    max-width: 22ch;
  }
  .mg-foot {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: .55rem;
    border-top: 1px solid rgba(247, 243, 236, .18);
  }
  .mg-meta {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: .1em;
    text-transform: uppercase;
    /* a11y: .65 alpha over the teal field was 4.04:1. .82 gives 5.40:1.
       axe reported this node as "unable to determine", not as a failure,
       so it only turned up in a manual contrast sweep. */
    color: rgba(247, 243, 236, .82);
  }
</style>

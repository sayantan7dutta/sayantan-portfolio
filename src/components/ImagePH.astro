---
interface Props {
  label: string;
  instructions?: string;
  aspect?: '16/10' | '16/7' | '4/3' | '4/5' | '16/9' | '1/1';
  icon?: string;
  fill?: boolean; // fill parent (no own aspect-ratio / border) — use inside a framed container
}

const {
  label,
  instructions,
  aspect = '16/10',
  icon = '+',
  fill = false,
} = Astro.props;

const style = fill ? 'width:100%;height:100%;border:none;' : `aspect-ratio:${aspect};`;
---

<div class="img-ph" style={style}>
  <div class="img-ph-icon">{icon}</div>
  <p class="img-ph-label">{label}</p>
  {instructions && <p class="img-ph-sub">{instructions}</p>}
</div>

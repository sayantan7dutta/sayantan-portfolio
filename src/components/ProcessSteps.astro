---
interface Step {
  title: string;
  body: string;
}

interface Props {
  steps: Step[];
}

const { steps } = Astro.props;
---

<div class="process-steps">
  {steps.map((step, i) => (
    <div class="ps reveal">
      <span class="ps-num">{String(i + 1).padStart(2, '0')}</span>
      <div>
        <h4 set:html={step.title} />
        <p set:html={step.body} />
      </div>
    </div>
  ))}
</div>

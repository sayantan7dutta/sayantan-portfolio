---
import { Image } from 'astro:assets';
import { otherCaseStudies } from '../data/caseStudies';
import SWOpsHero from './SWOpsHero.astro';

interface Props {
  current: string; // slug of the current case study
}

const { current } = Astro.props;
const others = otherCaseStudies(current);
---

<section class="more-cs">
  <div class="container">
    <span class="t-label">More case studies</span>
    <div class="more-cs-grid">
      {others.map((cs) => (
        <a href={`/work/${cs.slug}`} class="more-card reveal">
          <div class="more-card-thumb">
            {cs.slug === 'sherwin-williams' ? (
              <SWOpsHero />
            ) : cs.thumb ? (
              <Image src={cs.thumb} alt={cs.shortTitle} loading="lazy" />
            ) : cs.coverStat ? (
              <div class="more-card-stat-cover">
                <span class="more-card-stat-num">{cs.coverStat}</span>
                <span class="more-card-stat-lbl">{cs.coverLabel}</span>
              </div>
            ) : (
              <span class="more-card-thumb-ph">{cs.shortTitle}</span>
            )}
          </div>
          <div class="more-card-info">
            <p class="more-ctx">{cs.context}</p>
            <p class="more-title">{cs.shortTitle}</p>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
.more-card-stat-cover {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: .5rem;
  padding: 1.5rem;
  text-align: center;
}
.more-card-stat-num {
  font-family: var(--font-display);
  font-size: clamp(2rem, 4vw, 2.8rem);
  font-weight: 600;
  color: var(--accent);
  line-height: 1;
  display: block;
}
.more-card-stat-lbl {
  font-family: var(--font-mono);
  font-size: .55rem;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--text-3);
  line-height: 1.5;
  display: block;
  max-width: 22ch;
}
</style>

---
/**
 * Variant: PRODUCT PAGE
 *
 * Most of the work and most of the clients are B2B SaaS, so this presents the
 * practice in the grammar of the thing itself: a SaaS marketing site. Nav with
 * a CTA, a value proposition, a logo strip, customer stories with real numbers,
 * a process section, an FAQ, a closing band.
 *
 * The conceit only works if it is stated out loud — otherwise it is just
 * another landing page. The line under the hero does that.
 *
 * Nothing here claims a number that is not already on the main site.
 */
import Variant from '../../layouts/Variant.astro';
import { Image } from 'astro:assets';
import { projects, contact } from '../../lib/variants';
import heroShot from '../../assets/work/hazop/analytics-dashboard.jpg';

const clients = [
  { src: '/images/clients/ericsson.png', name: 'Ericsson' },
  { src: '/images/clients/sherwin-williams.png', name: 'Sherwin-Williams' },
  { src: '/images/clients/mcafee.png', name: 'McAfee' },
  { src: '/images/clients/itc.png', name: 'ITC' },
  { src: '/images/clients/cgap.png', name: 'CGAP' },
  { src: '/images/clients/soter-safety.png', name: 'Soter Safety Consulting' },
  { src: '/images/clients/pensaar.png', name: 'Pensaar Design' },
];

/** Every figure here appears on the main site. None are estimates. */
const proof = [
  { fig: '5', unit: 'yrs', label: 'in practice, four of them on enterprise SaaS' },
  { fig: '3', unit: 'yrs', label: 'on one API vertical at Ericsson, designer to lead' },
  { fig: '20+', unit: '', label: 'person research and design team I built ops for' },
  { fig: '30–40%', unit: '', label: 'less rework across six products after that' },
];

const stages = [
  {
    n: '01',
    name: 'Domain first',
    body: 'On HAZOP Edge I learned what a hazard and operability study actually is before drawing a single screen. Enterprise software fails when the designer never understood the job.',
  },
  {
    n: '02',
    name: 'Framing',
    body: 'Jobs to be done, user flows, journey mapping. The part where a vague request becomes a thing a three-person team can build in a quarter.',
  },
  {
    n: '03',
    name: 'A system, not screens',
    body: 'Component libraries, design tokens, an accessibility baseline. Ericsson ran three products off one system; miiGenie got its first one from me.',
  },
  {
    n: '04',
    name: 'Delivery, then operations',
    body: 'Sat in the product trio through build. Then, at Sherwin-Williams, fixed the handoff itself so findings reached design as a starting point rather than an afterthought.',
  },
];

const faqs = [
  {
    q: 'What kind of work do you take?',
    a: 'Enterprise and AI product work, and particularly the high-consequence end of it: hazard studies, API infrastructure, care products. Workflows where being wrong is expensive.',
  },
  {
    q: 'Do you work on contract?',
    a: 'Yes. My last three engagements — SparkSoft, Soter Safety Consulting and dAIs Genie — have all been UK contract roles as a founding product designer.',
  },
  {
    q: 'Do you do the research too, or only the design?',
    a: 'Both. On HAZOP Edge I ran it from first domain research through to MVP delivery. Research, synthesis, usability testing and heuristic evaluation are part of the job, not a separate engagement.',
  },
  {
    q: 'Can you set up design operations?',
    a: 'Yes, and I have. At Sherwin-Williams I rebuilt the file architecture, the research templates and the research-to-design handoff for a team of more than twenty across six digital products.',
  },
  {
    q: 'Where are you based?',
    a: `${contact.base}. I work with distributed teams and have done since 2020.`,
  },
];

const fonts =
  'https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;800&display=swap';
---

<Variant
  title="Sayantan Dutta · Product design for enterprise SaaS"
  description="Product designer for B2B SaaS and AI. Five years on high-consequence enterprise workflows, from industrial safety platforms to API infrastructure."
  variant="product-page"
  fonts={fonts}
  themeColor="#fbfaf8"
>

<header class="nav">
  <a class="brand" href="#top">
    <span class="mark" aria-hidden="true">SD</span>
    <span class="brand-name">Sayantan Dutta</span>
  </a>
  <nav class="nav-links" aria-label="Sections">
    <a href="#work">Work</a>
    <a href="#how">How I work</a>
    <a href="#faq">FAQ</a>
  </nav>
  <a class="btn btn-primary btn-sm" href={`mailto:${contact.email}`} data-ab="nav:cta">Start a conversation</a>
</header>

<main id="main">

  <!-- ═══ HERO ══════════════════════════════════════════════════════ -->
  <section class="hero" id="top">
    <div class="hero-copy">
      <p class="pill">Product designer · B2B SaaS &amp; AI · {contact.base}</p>
      <h1>Enterprise software people can get through the day with.</h1>
      <p class="sub">
        Five years designing the workflows nobody gets to abandon halfway:
        industrial hazard studies, API infrastructure, a voice companion older
        adults open every morning. Founding designer three times over.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href={`mailto:${contact.email}`} data-ab="hero:cta">Start a conversation</a>
        <a class="btn btn-ghost" href="#work" data-ab="hero:work">See the work <span aria-hidden="true">→</span></a>
      </div>
      <p class="wink">
        Yes — this is a SaaS landing page. It is the thing I have spent five years
        designing, so presenting the work in any other grammar felt like a dodge.
      </p>
    </div>

    <div class="hero-shot">
      <div class="chrome" aria-hidden="true">
        <span class="dot"></span><span class="dot"></span><span class="dot"></span>
        <span class="url">hazop-edge · analytics</span>
      </div>
      <Image src={heroShot} alt="HAZOP Edge analytics dashboard" widths={[720, 1200]} sizes="(max-width: 980px) 92vw, 620px" />
    </div>
  </section>

  <!-- ═══ LOGOS ═════════════════════════════════════════════════════ -->
  <section class="logos" aria-label="Clients">
    <p class="logos-h">Design work delivered for</p>
    <ul>
      {clients.map((c) => (
        <li><img src={c.src} alt={c.name} loading="lazy" /></li>
      ))}
    </ul>
  </section>

  <!-- ═══ PROOF ═════════════════════════════════════════════════════ -->
  <section class="proof">
    {proof.map((p) => (
      <div class="stat">
        <p class="fig">{p.fig}<span class="unit">{p.unit}</span></p>
        <p class="stat-l">{p.label}</p>
      </div>
    ))}
  </section>

  <!-- ═══ WORK ══════════════════════════════════════════════════════ -->
  <section class="section" id="work">
    <div class="sec-head">
      <p class="eyebrow">Selected work</p>
      <h2>Six products, and what each one actually needed.</h2>
    </div>

    <ul class="stories">
      {projects.map((p, i) => (
        <li class={`story ${i === 0 ? 'story-lead' : ''}`}>
          <a href={p.href} data-ab={`story:${p.slug}`}>
            <div class="story-top">
              <span class={`badge badge-${p.status.toLowerCase()}`}>{p.status}</span>
              <span class="story-sector">{p.sector}</span>
            </div>
            <h3>{p.short}</h3>
            <p class="story-sum">{p.summary}</p>
            <p class="story-note">“{p.note}”</p>
            <div class="story-foot">
              <span>{p.org} · {p.role}</span>
              <span class="story-go">Read the case study <span aria-hidden="true">→</span></span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- ═══ PROCESS ═══════════════════════════════════════════════════ -->
  <section class="section band" id="how">
    <div class="sec-head">
      <p class="eyebrow">How I work</p>
      <h2>Four things, in this order, every time.</h2>
    </div>
    <ol class="stages">
      {stages.map((s) => (
        <li>
          <p class="stage-n">{s.n}</p>
          <h3>{s.name}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <!-- ═══ FAQ ═══════════════════════════════════════════════════════ -->
  <section class="section" id="faq">
    <div class="sec-head">
      <p class="eyebrow">Questions</p>
      <h2>The ones people actually ask.</h2>
    </div>
    <div class="faq">
      {faqs.map((f, i) => (
        <details open={i === 0}>
          <summary>
            <span>{f.q}</span>
            <span class="chev" aria-hidden="true"></span>
          </summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </section>

  <!-- ═══ CLOSE ═════════════════════════════════════════════════════ -->
  <section class="close">
    <h2>Got a workflow people dread using?</h2>
    <p>
      Send it over. I read everything, and I will tell you honestly whether
      I am the right person for it.
    </p>
    <div class="cta-row cta-centre">
      <a class="btn btn-primary btn-lg" href={`mailto:${contact.email}`} data-ab="close:email">{contact.email}</a>
      <a class="btn btn-ghost btn-lg" href={contact.resume} data-ab="close:cv">CV (PDF)</a>
    </div>
    <p class="close-links">
      <a href={contact.linkedin} target="_blank" rel="me noopener" data-ab="close:linkedin">LinkedIn ↗</a>
      <span aria-hidden="true">·</span>
      <span>{contact.base}</span>
    </p>
  </section>
</main>

<style>
  :root {
    --bg: #fbfaf8;
    --surface: #ffffff;
    --line: #e6e2db;
    --line-2: #d3cec4;
    --ink: #14171a;
    --ink-2: #4e5560;
    --faint: #7c8490;
    --brand: #0d6a58;
    --brand-ink: #08453a;
    --brand-wash: #eef5f2;
    --sans: 'Manrope', system-ui, sans-serif;
    --pad: clamp(1.1rem, 5vw, 4rem);
    --max: 1180px;
  }

  :global(body) { background: var(--bg); color: var(--ink); font-family: var(--sans); line-height: 1.6; }
  :global(.skip-link) { background: var(--brand); color: #fff; }
  :global(:focus-visible) { outline: 2px solid var(--brand); outline-offset: 3px; }

  h1, h2, h3 { letter-spacing: -.032em; line-height: 1.08; font-weight: 800; }
  .eyebrow { font-size: .72rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--brand); }

  .btn {
    display: inline-flex; align-items: center; gap: .45rem;
    min-height: 46px; padding: .7rem 1.25rem; border-radius: 8px;
    font-weight: 600; font-size: .95rem;
    transition: background .16s, border-color .16s, color .16s, transform .16s;
  }
  .btn:active { transform: translateY(1px); }
  .btn-primary { background: var(--brand); color: #fff; }
  .btn-primary:hover { background: var(--brand-ink); }
  .btn-ghost { border: 1px solid var(--line-2); color: var(--ink); }
  .btn-ghost:hover { border-color: var(--ink); }
  .btn-sm { min-height: 40px; padding: .5rem 1rem; font-size: .88rem; }
  .btn-lg { min-height: 54px; padding: .9rem 1.6rem; font-size: 1rem; }

  /* ── nav ── */
  .nav {
    position: sticky; top: 0; z-index: 300;
    display: flex; align-items: center; gap: 1.4rem;
    padding: .75rem var(--pad);
    background: color-mix(in oklab, var(--bg) 88%, transparent);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .brand { display: flex; align-items: center; gap: .6rem; font-weight: 800; letter-spacing: -.02em; }
  .mark {
    width: 30px; height: 30px; border-radius: 7px; display: grid; place-items: center;
    background: var(--brand); color: #fff; font-size: .72rem; font-weight: 800; letter-spacing: .02em;
  }
  .nav-links { display: flex; gap: 1.5rem; margin-left: auto; font-size: .92rem; font-weight: 500; color: var(--ink-2); }
  .nav-links a:hover { color: var(--ink); }
  .nav .btn { margin-left: 0; }
  @media (max-width: 780px) { .nav-links { display: none; } .nav .btn { margin-left: auto; } }

  /* ── hero ── */
  .hero {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 5vw, 4.5rem); align-items: center;
    max-width: var(--max); margin: 0 auto;
    padding: clamp(3rem, 8vw, 6rem) var(--pad) clamp(2.5rem, 6vw, 4rem);
  }
  @media (max-width: 980px) { .hero { grid-template-columns: 1fr; } }

  .pill {
    display: inline-block; padding: .32rem .8rem; border-radius: 40px;
    background: var(--brand-wash); color: var(--brand-ink);
    font-size: .76rem; font-weight: 600; letter-spacing: .01em;
  }
  .hero h1 { font-size: clamp(2.1rem, 4.6vw, 3.3rem); margin: 1.1rem 0 1.2rem; max-width: 15ch; text-wrap: balance; }
  .sub { font-size: clamp(1.02rem, 2.1vw, 1.16rem); color: var(--ink-2); max-width: 46ch; }
  .cta-row { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1.9rem; }
  .wink {
    margin-top: 2rem; padding-left: .9rem; border-left: 2px solid var(--line-2);
    font-size: .9rem; color: var(--faint); max-width: 44ch;
  }

  .hero-shot { border-radius: 12px; overflow: hidden; border: 1px solid var(--line); background: var(--surface); box-shadow: 0 30px 60px -34px rgba(20,23,26,.5); }
  .chrome { display: flex; align-items: center; gap: .4rem; padding: .6rem .85rem; border-bottom: 1px solid var(--line); background: #f6f4f1; }
  .dot { width: 9px; height: 9px; border-radius: 50%; background: var(--line-2); }
  .url { margin-left: .7rem; font-size: .72rem; color: var(--faint); font-weight: 500; }

  /* ── logos ── */
  .logos { max-width: var(--max); margin: 0 auto; padding: clamp(1.5rem, 4vw, 2.5rem) var(--pad); }
  .logos-h { text-align: center; font-size: .76rem; font-weight: 600; letter-spacing: .13em; text-transform: uppercase; color: var(--faint); margin-bottom: 1.6rem; }
  .logos ul { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: clamp(1.6rem, 5vw, 3.4rem); }
  .logos img { height: 28px; width: auto; object-fit: contain; }

  /* ── proof ── */
  .proof {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 1px; background: var(--line);
    max-width: var(--max); margin: clamp(2rem, 5vw, 3.5rem) auto;
    border: 1px solid var(--line); border-radius: 12px; overflow: hidden;
  }
  .stat { background: var(--surface); padding: clamp(1.4rem, 3vw, 2rem); }
  .fig { font-size: clamp(1.9rem, 4vw, 2.6rem); font-weight: 800; letter-spacing: -.04em; color: var(--brand); line-height: 1; }
  .unit { font-size: .5em; margin-left: .15em; color: var(--faint); }
  .stat-l { margin-top: .6rem; font-size: .88rem; color: var(--ink-2); }

  /* ── sections ── */
  .section { max-width: var(--max); margin: 0 auto; padding: clamp(3rem, 7vw, 5.5rem) var(--pad); }
  .band { background: var(--surface); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); max-width: none; }
  .band > * { max-width: var(--max); margin-inline: auto; }
  .sec-head { margin-bottom: clamp(2rem, 4vw, 3rem); }
  .sec-head h2 { font-size: clamp(1.6rem, 3.6vw, 2.5rem); margin-top: .6rem; max-width: 20ch; }

  /* ── stories ── */
  .stories { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.1rem; }
  .story-lead { grid-column: 1 / -1; }
  @media (max-width: 820px) { .stories { grid-template-columns: 1fr; } }

  .story a {
    display: block; height: 100%;
    background: var(--surface); border: 1px solid var(--line); border-radius: 12px;
    padding: clamp(1.3rem, 3vw, 2rem);
    transition: border-color .18s, box-shadow .18s, transform .18s;
  }
  .story a:hover { border-color: var(--line-2); box-shadow: 0 18px 34px -26px rgba(20,23,26,.45); transform: translateY(-2px); }
  .story-top { display: flex; align-items: center; gap: .7rem; flex-wrap: wrap; }
  .badge {
    font-size: .66rem; font-weight: 700; letter-spacing: .08em;
    padding: .2rem .5rem; border-radius: 5px;
    background: #eef0f2; color: var(--ink-2);
  }
  .badge-live { background: var(--brand-wash); color: var(--brand-ink); }
  .badge-concept, .badge-exhibited { background: #fdf1e6; color: #8a4f14; }
  .story-sector { font-size: .78rem; color: var(--faint); font-weight: 500; }
  .story h3 { font-size: clamp(1.15rem, 2.4vw, 1.5rem); margin: .9rem 0 .6rem; }
  .story-lead h3 { font-size: clamp(1.4rem, 3vw, 2rem); max-width: 24ch; }
  .story-sum { color: var(--ink-2); font-size: .95rem; max-width: 62ch; }
  .story-note {
    margin: 1rem 0 1.2rem; padding-left: .9rem; border-left: 2px solid var(--brand);
    font-size: .95rem; color: var(--ink); max-width: 52ch;
  }
  .story-foot { display: flex; flex-wrap: wrap; gap: .5rem 1rem; justify-content: space-between; align-items: baseline; border-top: 1px solid var(--line); padding-top: .9rem; font-size: .82rem; color: var(--faint); }
  .story-go { color: var(--brand); font-weight: 600; }

  /* ── stages ── */
  .stages { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: clamp(1.4rem, 3vw, 2.4rem); }
  .stages li { border-top: 2px solid var(--ink); padding-top: 1rem; }
  .stage-n { font-size: .78rem; font-weight: 700; color: var(--brand); letter-spacing: .08em; }
  .stages h3 { font-size: 1.1rem; margin: .45rem 0 .55rem; }
  .stages p { font-size: .92rem; color: var(--ink-2); }

  /* ── faq ── */
  .faq { border-top: 1px solid var(--line); max-width: 780px; }
  details { border-bottom: 1px solid var(--line); }
  summary {
    display: flex; align-items: center; justify-content: space-between; gap: 1.4rem;
    padding: 1.15rem .2rem; cursor: pointer; list-style: none;
    font-weight: 600; font-size: clamp(1rem, 2.1vw, 1.12rem);
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--brand); }
  .chev { width: 11px; height: 11px; border-right: 2px solid var(--faint); border-bottom: 2px solid var(--faint); transform: rotate(45deg) translate(-3px, -3px); flex: none; transition: transform .2s; }
  details[open] .chev { transform: rotate(225deg) translate(-2px, -2px); }
  details p { padding: 0 .2rem 1.3rem; color: var(--ink-2); max-width: 62ch; }

  /* ── close ── */
  .close {
    text-align: center; background: var(--surface);
    border-top: 1px solid var(--line);
    padding: clamp(3.5rem, 9vw, 6.5rem) var(--pad);
  }
  .close h2 { font-size: clamp(1.7rem, 4.4vw, 2.9rem); max-width: 18ch; margin: 0 auto .9rem; }
  .close > p { color: var(--ink-2); max-width: 46ch; margin: 0 auto; }
  .cta-centre { justify-content: center; }
  .close-links { margin-top: 1.6rem; font-size: .88rem; color: var(--faint); display: flex; gap: .6rem; justify-content: center; }
  .close-links a { color: var(--brand); font-weight: 600; }
</style>
</Variant>

  .hero-ops { border: 1px solid #272724; border-radius: 8px; padding: clamp(1.2rem, 2.6vw, 1.8rem); background: #121210; }
  .hops-band { font-size: var(--micro); font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: #6fae9b; }
  .hops-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(.6rem, 2vw, 1.2rem); margin: 1.1rem 0; }

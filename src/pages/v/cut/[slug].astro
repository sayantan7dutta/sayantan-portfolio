  @media (max-width: 560px) { .steps li { grid-template-columns: 1fr; gap: .4rem; } .step-n { padding-top: 0; } }

  /* ── service blueprint ──
     A real grid, not a picture of one, so it reflows and reads aloud. It
     scrolls sideways on narrow viewports, so the region is focusable and
     named for anyone arriving by keyboard. */
  .bp { margin-top: clamp(2rem, 5vw, 3rem); }
  .bp-scroll { overflow-x: auto; }
  .bp-scroll:focus-visible { outline: 3px solid var(--accent); outline-offset: 3px; }
  .bp-grid { display: grid; grid-template-columns: 11rem repeat(var(--cols, 4), minmax(9.5rem, 1fr)); gap: .4rem; min-width: 46rem; }
  .bp-corner { align-self: end; padding: .5rem .2rem; font-size: var(--micro); font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--faint); }
  .bp-stage { padding: .7rem .8rem; background: var(--paper-2); border-top: 2px solid var(--accent); font-weight: 700; font-size: .95rem; }
  .bp-num { display: block; font-size: var(--micro); font-weight: 700; letter-spacing: .12em; color: var(--accent); margin-bottom: .2rem; }
  .bp-vis { grid-column: 1 / -1; margin: .5rem 0; padding-top: .5rem; border-top: 1px dashed var(--edge);
    font-size: var(--micro); font-weight: 700; letter-spacing: .13em; text-transform: uppercase; color: var(--faint); }
  .bp-layer { padding: .7rem .2rem; }
  .bp-layer b { display: block; font-family: var(--read); font-size: 1rem; }
  .bp-layer span { font-size: var(--micro); font-weight: 700; letter-spacing: .13em; text-transform: uppercase; color: var(--faint); }
  .bp-cell { padding: .7rem .8rem; background: var(--paper-2); border-left: 2px solid var(--line); font-size: .85rem; color: var(--ink-2); }
  .bp figcaption { margin-top: .9rem; font-size: var(--micro); font-weight: 700; letter-spacing: .13em; text-transform: uppercase; color: var(--faint); }

  /* The hairlines are drawn by each card, not by a line-coloured background
     showing through the gaps. A grid of five in threes has an unfilled sixth
     cell, and under the old method that cell painted itself a solid block of
     line colour: it read as a card that had failed to load. Drawn per card,
     the leftover cell is simply the band behind it. */
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1px; margin-top: clamp(2rem, 5vw, 2.6rem); }
  /* Auto-fit decides the column count from available width, which is how a
     five-card set ends up four and one. The count is pinned instead, chosen
     in `colsFor` from how many cards there are. */
  .cards-m1 { grid-template-columns: 1fr; }
  .cards-m2 { grid-template-columns: repeat(2, 1fr); }
  @media (min-width: 1000px) {
    .cards-c2 { grid-template-columns: repeat(2, 1fr); }
    .cards-c3 { grid-template-columns: repeat(3, 1fr); }
    .cards-c4 { grid-template-columns: repeat(4, 1fr); }
  }
  @media (max-width: 520px) { .cards-m1, .cards-m2 { grid-template-columns: 1fr; } }
  .cards li { background: var(--paper); box-shadow: 0 0 0 1px var(--line); padding: clamp(1.2rem, 2.6vw, 1.7rem); transition: background var(--quick) var(--ease); }
  .cards li:hover { background: #fff; }
  .card-n { font-size: .72rem; font-weight: 700; letter-spacing: .1em; color: var(--accent); }
  /* The one that survived, marked. Colour alone would not say it, so the
     label carries the words. */
  .card-tag {
    display: inline-block; margin: .1rem 0 .5rem; padding: .22rem .5rem;
    font-size: var(--micro); font-weight: 700; letter-spacing: .1em;
    text-transform: uppercase; color: var(--paper); background: var(--accent); border-radius: 3px;
  }
  .card-kept { box-shadow: 0 0 0 1px var(--accent); }

  /* ── what people said ──
     Three cards, not one paragraph. Each quote keeps its own box and its own
     attribution, so a reader can tell where one voice stops and which group
     it came from. */
  .qts {
    display: grid; grid-template-columns: repeat(var(--n, 3), minmax(0, 1fr));
    gap: clamp(.9rem, 2vw, 1.3rem); margin-top: clamp(2rem, 5vw, 2.6rem);
  }
  @media (max-width: 900px) { .qts { grid-template-columns: 1fr; } }
  .qts li { border: 1px solid var(--line); border-left: 2px solid var(--accent); border-radius: 3px; padding: clamp(1.1rem, 2.6vw, 1.5rem); background: var(--paper); }
  .qts blockquote { margin: 0; }
  .qts p { font-family: var(--read); font-style: italic; font-size: .98rem; color: var(--ink); }
  .qts cite {
    display: block; margin-top: .9rem; font-style: normal; font-size: var(--micro);
    font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--faint);
  }

  /* ── the exhibition credential ──
     A tinted panel rather than another run of paragraphs, because this is
     the one claim on the page a reviewer can go and verify, and it should
     be legible in a glance on the way past. */
  .exh-band { padding-block: clamp(1.6rem, 4vw, 2.4rem) 0; }
  .exh {
    display: flex; gap: clamp(1.2rem, 3.5vw, 2.4rem); align-items: flex-start;
    padding: clamp(1.4rem, 4vw, 2.2rem);
    background: var(--paper-2); border: 1px solid var(--line); border-radius: 6px;
  }
  @media (max-width: 620px) { .exh { flex-direction: column; } }
  .exh-chip { flex-shrink: 0; width: clamp(78px, 10vw, 104px); background: #fff; border-radius: 4px; padding: 10px; }
  .exh-chip img { width: 100%; height: auto; display: block; }
  .exh-body { flex: 1; min-width: 0; }
  .exh-top { display: flex; align-items: center; flex-wrap: wrap; gap: .5rem .8rem; margin-bottom: .9rem; }
  .exh-tag {
    font-size: var(--micro); font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
    color: var(--accent); border: 1px solid var(--edge); border-radius: 2px; padding: .22rem .5rem;
  }
  .exh-fest { font-size: var(--micro); font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--faint); }
  .exh-lead {
    font-family: var(--read); font-size: clamp(1.15rem, 2.6vw, 1.75rem);
    font-weight: 600; letter-spacing: -.015em; line-height: 1.28;
  }
  .exh-lead em { font-style: italic; color: var(--accent); }
  .exh-sub { font-family: var(--read); font-size: .92rem; color: var(--ink-2); margin-top: .8rem; max-width: 60ch; }
  .exh-facts {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 1rem;
    margin-top: clamp(1.2rem, 3vw, 1.6rem); padding-top: clamp(1rem, 2.5vw, 1.3rem);
    border-top: 1px solid var(--line);
  }
  .exh-facts dt { font-size: var(--micro); font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--faint); }
  .exh-facts dd { margin-top: .3rem; font-size: .92rem; }

  /* ── the brand, shown ── */
  .brand { display: grid; gap: clamp(1.6rem, 4vw, 2.4rem); margin-top: clamp(2rem, 5vw, 2.6rem); }
  @media (min-width: 900px) { .brand { grid-template-columns: minmax(0, 20rem) minmax(0, 1fr); align-items: start; } }
  .brand figure { margin: 0; }
  .brand figcaption { margin-top: .7rem; font-size: .82rem; color: var(--faint); }
  /* Coffee, the darkest colour in Amble's own palette. The wordmark is drawn
     in parchment, so it is a light mark for a dark ground: on the parchment
     plate this first had, it was invisible. */
  .brand-plate {
    display: grid; place-items: center; padding: clamp(1.8rem, 5vw, 3rem);
    background: #654937; border-radius: 8px;
  }
  .brand-plate img { width: 100%; max-width: 230px; height: auto; display: block; }
  .brand-pal ul { display: flex; flex-wrap: wrap; gap: clamp(.7rem, 2vw, 1.1rem); }
  .brand-pal li { display: grid; gap: .35rem; min-width: 5.4rem; }
  .sw { display: block; height: 56px; border-radius: 5px; border: 1px solid rgba(20,19,15,.12); }
  .sw-n { font-size: .82rem; font-weight: 700; }
  /* Tabular figures so five hex codes line up rather than jitter. */
  .sw-h { font-size: .74rem; color: var(--faint); font-variant-numeric: tabular-nums; letter-spacing: .02em; }
  .cards h3 { font-size: 1.02rem; font-weight: 700; margin: .5rem 0 .5rem; letter-spacing: -.015em; }
  .cards p { font-family: var(--read); font-size: .92rem; color: var(--ink-2); }

  /* ── personas ── */
  /* Pinned rather than auto-fit: four profiles fitted three across between
     about 700 and 1000px, leaving the fourth alone on its own row. */
  .personas { display: grid; grid-template-columns: repeat(2, 1fr); gap: clamp(.9rem, 2vw, 1.3rem); margin-top: clamp(2rem, 5vw, 2.6rem); }
  @media (min-width: 1000px) { .personas { grid-template-columns: repeat(4, 1fr); } }
  @media (max-width: 480px) { .personas { grid-template-columns: 1fr; } }
  .personas li {
    border: 1px solid var(--line); border-top: 3px solid var(--accent);
    padding: clamp(1.1rem, 2.4vw, 1.5rem); background: var(--paper);
    transition: box-shadow var(--quick) var(--ease), transform var(--quick) var(--ease);
  }
  .personas li:hover { transform: translateY(-3px); box-shadow: 0 18px 30px -22px rgba(0,0,0,.4); }
  .pr-top { display: flex; justify-content: space-between; gap: .6rem; align-items: baseline; }
  .pr-role { font-size: var(--micro); font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--accent); }
  .pr-age { font-size: .74rem; color: var(--faint); }
  .personas h3 { font-size: .98rem; font-weight: 700; margin: .6rem 0 .45rem; letter-spacing: -.015em; }
  .pr-note { font-family: var(--read); font-size: .88rem; color: var(--ink-2); }

  /* ── stage table ── */
  /* Focusable, because on a narrow screen this is the only way to reach the
     right-hand columns without a mouse. */
  .tbl-scroll { overflow-x: auto; margin-top: clamp(2rem, 5vw, 2.6rem); }
  .tbl { width: 100%; border-collapse: collapse; min-width: 680px; }
  .tbl th, .tbl td { text-align: left; vertical-align: top; padding: .95rem .9rem; border-bottom: 1px solid var(--line); }
  .tbl th:first-child, .tbl td:first-child { padding-left: 0; }
  .tbl thead th { font-size: var(--micro); font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--faint); border-bottom: 1.5px solid var(--ink); }
  .tbl tbody tr { transition: background var(--quick) var(--ease); }
  .tbl tbody tr:hover { background: var(--paper-2); }
  /* `white-space: nowrap` with `width: 1%` suits a short row label, and the
     row header here is a whole sentence. Nowrap forced that sentence onto one
     line, which pushed the table to 1571px inside a 1096px scroller: 43% of
     it unreachable unless you knew to drag sideways, and the other two cells
     wrapped into a 701px-tall column of mostly empty paper. A short label
     still sits on one line on its own, because nothing makes it wrap. */
  .tbl tbody th { font-weight: 700; color: var(--accent); max-width: 22rem; }
  /* Auto table layout hands the narrowest column to whichever cell can wrap
     hardest, which left a sentence running down a 105px ribbon beside two
     comfortable ones. A floor on the first column keeps prose readable; a
     short label is unaffected, having nothing to wrap. */
  .tbl th:first-child { min-width: 13rem; }

  /* ── the rail ──
     Three titles across three years is a shape. The condensed version listed
     them in a sentence, which reads as a fact rather than a climb, so the
     main site's dated rail is back. The last node is filled, being where the
     work got to. */
  .rail {
    position: relative; display: grid; grid-template-columns: repeat(3, 1fr);
    gap: clamp(.8rem, 2vw, 1.4rem); margin-top: clamp(2rem, 5vw, 2.6rem);
  }
  .rail::before {
    content: ''; position: absolute; top: 5px; left: 8%; right: 8%;
    height: 1px; background: var(--line);
  }
  .rail li { position: relative; padding-top: 1.6rem; }
  .rail li::before {
    content: ''; position: absolute; top: 0; left: 0;
    width: 11px; height: 11px; border-radius: 50%;
    background: var(--paper); border: 1px solid var(--faint);
  }
  .rail .rail-now::before { background: var(--accent); border-color: var(--accent); }
  .rail-d {
    display: block; margin-bottom: .4rem; font-size: var(--micro); font-weight: 700;
    letter-spacing: .1em; text-transform: uppercase; color: var(--faint);
  }
  .rail-r { font-size: 1.02rem; font-weight: 700; letter-spacing: -.015em; }
  /* Stacked, the horizontal rail would run across nothing, so it goes. */
  @media (max-width: 620px) {
    .rail { grid-template-columns: 1fr; gap: 1.3rem; }
    .rail::before { display: none; }
  }
  @media (max-width: 760px) { .tbl th:first-child { min-width: 9rem; } }
  .tbl td { font-family: var(--read); font-size: .94rem; color: var(--ink-2); }
  .tbl td:last-child { color: var(--ink); }

  /* ── before / after columns ── */
  .compare { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1rem, 2.5vw, 2rem); margin-top: clamp(2rem, 5vw, 2.6rem); }
  @media (max-width: 720px) { .compare { grid-template-columns: 1fr; } }
  .cmp { padding: clamp(1.1rem, 2.4vw, 1.6rem); border: 1px solid var(--line); }
  .cmp-before { background: var(--paper-2); }
  .cmp-after { background: var(--paper); border-color: var(--accent); }
  .cmp h3 { font-size: var(--micro); font-weight: 700; letter-spacing: .15em; text-transform: uppercase; margin-bottom: .9rem; }
  .cmp-before h3 { color: var(--faint); }
  .cmp-after h3 { color: var(--accent); }
  .cmp li { font-size: .9rem; padding: .45rem 0 .45rem 1.1rem; position: relative; border-bottom: 1px solid var(--line); }
  .cmp li:last-child { border-bottom: 0; }
  .cmp li::before { content: ''; position: absolute; left: 0; top: .95em; width: 5px; height: 5px; border-radius: 50%; background: var(--faint); }
  .cmp-after li::before { background: var(--accent); }
  .cmp-before li { color: var(--faint); }

  /* ── next: three tiles across the band rather than three stacked rows ── */
  /* ── the carousel ──
     A native horizontal scroller with snap points. The arrows drive it, but
     they are not the only way through: the strip scrolls by wheel, trackpad
     and touch, and tabbing a card brings it into view on its own, so a
     keyboard reaches every case whether or not the arrows exist. */
  .car-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 1.5rem; }
  .car-nav { display: flex; gap: .5rem; flex-shrink: 0; }
  .car-btn {
    width: 44px; height: 44px; display: grid; place-items: center;
    border: 1.5px solid var(--edge); border-radius: 50%; background: transparent;
    color: var(--ink); font-size: 1rem; cursor: pointer;
    transition: background var(--quick) var(--ease), border-color var(--quick) var(--ease), opacity var(--quick) var(--ease);
  }
  .car-btn:hover:not(:disabled) { background: var(--ink); color: var(--paper); border-color: var(--ink); }
  /* Disabled rather than removed, so the row does not reflow at the ends. */
  .car-btn:disabled { opacity: .3; cursor: default; }

  .car {
    margin-top: clamp(2rem, 5vw, 2.6rem);
    overflow-x: auto; scroll-snap-type: x mandatory;
    scrollbar-width: thin; -webkit-overflow-scrolling: touch;
    /* room for the lift on hover and for the focus ring, which `overflow`
       would otherwise shave off the top and bottom of a card */
    padding: 6px 0 14px;
  }
  .car-track { display: flex; gap: clamp(1rem, 2.4vw, 1.6rem); list-style: none; margin: 0; padding: 0; }
  .car-card { flex: 0 0 clamp(248px, 72vw, 340px); scroll-snap-align: start; }
  @media (min-width: 760px) { .car-card { flex-basis: clamp(280px, 32vw, 340px); } }

  .car-card > a {
    display: flex; flex-direction: column; height: 100%;
    border: 1px solid var(--line); border-radius: 8px; overflow: hidden;
    background: var(--paper); text-decoration: none; color: inherit;
    transition: transform var(--slow) var(--ease), box-shadow var(--slow) var(--ease);
  }
  .car-card > a:hover { transform: translateY(-4px); box-shadow: 0 26px 46px -30px rgba(0,0,0,.5); }

  .car-vis { display: block; aspect-ratio: 16 / 10; overflow: hidden; background: var(--paper-2); }
  .car-vis img { width: 100%; height: 100%; object-fit: cover; object-position: top center; display: block; }
  /* A phone screen in a landscape window would be cropped to a sliver, so a
     tall source is shown whole, standing in the middle of the card. */
  .car-vis.is-fit { position: relative; padding: .6rem 0; background: var(--paper); }
  /* `height: 100%` cannot resolve against a grid area with no definite
     height, so the phone rendered 735px tall inside a 204px window and was
     simply clipped. An absolute box gives `max-height` something real to
     measure against, and the auto margins centre what is left. */
  .car-vis.is-fit img {
    position: absolute; inset: 0; margin: auto;
    width: auto; height: auto; max-width: 100%; max-height: 100%;
    object-fit: contain;
  }

  .car-vis.is-ops { background: #0e0c0b; display: flex; flex-direction: column; }
  .car-ops { display: flex; flex-direction: column; height: 100%; color: #f0ead6; }
  .car-ops-band {
    background: #DA291C; color: #fff; padding: .5rem .8rem;
    font-size: var(--micro); font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
  }
  .car-ops-stats { display: flex; flex-direction: column; justify-content: center; gap: .5rem; flex: 1; padding: .9rem; }
  .car-ops-stats span { font-size: .84rem; color: #cfc7b4; }
  .car-ops-stats b { color: #fff; font-weight: 700; }

  /* The type and the industry as two chips rather than a grey run-on line,
     which is how the same two facts are labelled on the case masthead. The
     year is gone: it was the third thing in a line of three and the least
     worth reading, and the case page states it anyway. */
  .car-chips { display: flex; flex-wrap: wrap; gap: .4rem; padding: 1rem 1.1rem 0; }
  .car-chip {
    font-size: var(--micro); font-weight: 700; letter-spacing: .1em;
    text-transform: uppercase; padding: .3rem .55rem; border-radius: 3px;
  }
  .car-chip-kind { background: var(--ink); color: var(--paper); }
  .car-chip-field { background: rgba(21, 89, 74, .13); color: var(--accent); }
  .car-t { display: block; padding: .5rem 1.1rem 0; font-size: 1.04rem; font-weight: 700; letter-spacing: -.015em; }
  .car-go {
    display: block; margin-top: auto; padding: .9rem 1.1rem 1.1rem;
    font-size: .84rem; font-weight: 600; color: var(--accent);
  }
  .car-card > a:hover .car-go { text-decoration: underline; }

  @media (max-width: 560px) {
    .car-head { flex-direction: column; align-items: flex-start; }
  }

  @media (prefers-reduced-motion: reduce) {
    .plate:hover, .personas li:hover { transform: none; }
    .wide-frame:hover img { transform: none; }
  }
</style>

  .statfig { margin-top: clamp(2rem, 5vw, 3rem); background: var(--accent); color: var(--paper); padding: clamp(2rem, 6vw, 3.5rem); text-align: center; border-radius: 8px; }
  .statfig span { display: block; font-size: clamp(2.4rem, 8vw, 4.4rem); font-weight: 800; letter-spacing: -.05em; line-height: 1; }
  .statfig figcaption { margin-top: .8rem; font-size: .9rem; opacity: .88; }

  /* ── numbered cards ── */
  /* ── ordered steps ── */
  .steps { margin-top: clamp(2rem, 5vw, 2.6rem); border-top: 1px solid var(--line); }
  .steps li { display: grid; grid-template-columns: 3.2rem minmax(0, 1fr); gap: 0 clamp(1rem, 3vw, 2rem);
    padding: clamp(1.3rem, 3vw, 1.8rem) 0; border-bottom: 1px solid var(--line); }
  .step-n { font-size: .72rem; font-weight: 700; letter-spacing: .1em; color: var(--accent); padding-top: .3rem; }

---
/**
 * Every case study in the Director's Cut language, from one template.
 *
 * Structure follows the hiring research: role, scope and status are scannable
 * before any prose, a status chip answers "is it live?", and where
 * src/lib/decisions.ts carries a trade-off it is given its own block.
 *
 * Layout: each section is a two-column spread — kicker and heading on the
 * left, the reading column on the right — so a long page keeps its measure
 * without leaving a third of every screen empty. Figures, tables and card
 * blocks sit outside that grid and run the full band, which is what gives
 * the page its rhythm.
 */
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Cut from '../../../layouts/Cut.astro';
import { projects } from '../../../lib/variants';
import { cutCases } from '../../../lib/cut-cases';

import mgBefore from '../../../assets/work/miigenie/before-home.png';
import mgAfter from '../../../assets/work/miigenie/home.png';
import mgListening from '../../../assets/work/miigenie/listening.png';
import mgCarer from '../../../assets/work/miigenie/carer-home.png';
import mgOnboarding from '../../../assets/work/miigenie/onboarding.png';
import mgError from '../../../assets/work/miigenie/error-state.png';
import mgConnect from '../../../assets/work/miigenie/connect.png';
import mgSiteHero from '../../../assets/work/miigenie/site-hero.jpg';
import mgSiteHow from '../../../assets/work/miigenie/site-how.jpg';
import mgSiteTrial from '../../../assets/work/miigenie/site-trial.jpg';
import hzScenario from '../../../assets/work/hazop/scenario-summary.jpg';
import hzAnalytics from '../../../assets/work/hazop/analytics-dashboard.jpg';
import soProducts from '../../../assets/work/soter-software/products.jpg';
import soHero from '../../../assets/work/soter-software/hero.jpg';
import soKnowledge from '../../../assets/work/soter-software/knowledge-centre.jpg';
import hzRisk from '../../../assets/work/hazop/risk-matrix.jpg';
import hzSites from '../../../assets/work/hazop/sites-dashboard.jpg';
import apDashboard from '../../../assets/work/api-lifecycle/dashboard.png';
import apDetails from '../../../assets/work/api-lifecycle/design-details.png';
import apCollab from '../../../assets/work/api-lifecycle/collaborator.png';
import kvVault from '../../../assets/work/kinvault/vault.jpg';
import kvTransfer from '../../../assets/work/kinvault/smart-transfer.jpg';
import kvReview from '../../../assets/work/kinvault/review.jpg';
import kvStatus from '../../../assets/work/kinvault/transfer-status.jpg';
import kvBillPay from '../../../assets/work/kinvault/bill-pay.jpg';
import kvDashboard from '../../../assets/work/kinvault/dashboard.jpg';
import amFamily from '../../../assets/work/amble/family.jpg';
import amRoutines from '../../../assets/work/amble/routines.jpg';
import amFuture from '../../../assets/work/amble/future.jpg';
import amBedroom from '../../../assets/work/amble/bedroom.jpg';
import amLaundry from '../../../assets/work/amble/laundry.jpg';
import amAirFilter from '../../../assets/work/amble/air-filter.jpg';
import amPoster1 from '../../../assets/work/amble/poster-1.jpg';
import amPoster2 from '../../../assets/work/amble/poster-2.jpg';
import amRodd from '../../../assets/work/amble/rodd.png';
import amWsa from '../../../assets/work/amble/wsa.png';
import amUos from '../../../assets/work/amble/uos.png';
import amLogo from '../../../assets/work/amble/logo.png';
import amLdf from '../../../assets/work/amble/ldf.png';
/* The carousel's thumbnails are the home page's, deliberately: a visitor who
   saw a project on the home grid should meet the same picture here. */
import thMiigenie from '../../../assets/work/miigenie/card-trio.png';
import thKinvault from '../../../assets/work/kinvault/card-trio.png';
import thHazop from '../../../assets/work/hazop/analytics-dashboard.jpg';
import thEricsson from '../../../assets/work/api-lifecycle/hero.png';
import thAmble from '../../../assets/work/amble/hero.jpg';

/** Per-case image slots, keyed by the `shot` names used in cut-cases.ts. */
const shots: Record<string, Record<string, any>> = {
  miigenie: {
    before: mgBefore, after: mgAfter,
    /* The voice loop as it is actually used: start, speak, get it wrong. */
    trio: [mgOnboarding, mgListening, mgError],
    pair: [mgConnect, mgCarer],
    /* `solo` renders a single phone; nothing claims it since My Day left
       the four-jobs section, which it had no relation to. */
    /* The marketing site, in browser shape rather than phone shape. */
    web: [mgSiteHero, mgSiteHow, mgSiteTrial],
  },
  hazop: { wide: hzScenario, scenes: [hzRisk, hzSites, hzAnalytics], web: [soHero, soProducts, soKnowledge] },
  'api-lifecycle': { wide: apDashboard, pair: [apDetails, apCollab] },
  kinvault: { wide: kvVault, wide2: kvTransfer, trio: [kvReview, kvStatus, kvBillPay] },
  amble: {
    wide: amFamily, wide2: amRoutines,
    scenes: [amFuture, amBedroom, amLaundry, amAirFilter],
    posters: [amPoster1, amPoster2],
    partners: [amRodd, amWsa, amUos],
  },
  'sherwin-williams': {},
};

/**
 * The opening image, one per case.
 *
 * The page used to open on a plain black band, which is a lot of nothing
 * before the first idea. It now opens the way the main site's cases do, with
 * the work itself beside the title.
 *
 * The device vocabulary is the home page's and deliberately so: phone work in
 * a phone, desktop work in a laptop, photography flat, and Sherwin in the
 * stats panel it gets everywhere else, having no UI to screenshot. Keeping
 * the two in step matters more than sharing the code, since the hero sits on
 * black and bleeds off the page while the home plates sit in light cards.
 */
type HeroArt = {
  device: 'phones' | 'laptop' | 'flat' | 'ops';
  img?: any;
  imgs?: any[];
  label?: string;
  alt?: string;
  alts?: string[];
};
const heroArt: Record<string, HeroArt> = {
  miigenie: {
    device: 'phones',
    imgs: [mgOnboarding, mgAfter, mgCarer],
    alts: [
      'The miiGenie onboarding screen',
      'The miiGenie home screen, with one large voice action',
      'The carer view, showing how the day went',
    ],
  },
  kinvault: {
    device: 'phones',
    /* review 2.27, vault 2.58, dashboard 2.43 tall-to-wide. Picked to stand
       at roughly the same height: bill-pay is 3.18 and left the third phone
       a hundred pixels above the first. */
    imgs: [kvReview, kvVault, kvDashboard],
    alts: [
      'The KinVault transfer review screen',
      'The KinVault vault, holding a family\u2019s documents',
      'The KinVault dashboard',
    ],
  },
  hazop: {
    device: 'laptop',
    img: hzAnalytics,
    label: 'HAZOP Edge',
    alt: 'The HAZOP Edge analytics dashboard',
  },
  'api-lifecycle': {
    device: 'laptop',
    img: apDashboard,
    label: 'API Console',
    alt: 'The Ericsson API Console dashboard',
  },
  amble: {
    device: 'flat',
    img: amFamily,
    alt: 'Amble, a bioengineered plant system growing through a 2065 home',
  },
  'sherwin-williams': { device: 'ops' },
};

export const getStaticPaths = (() =>
  cutCases.map((c) => ({ params: { slug: c.slug } }))) satisfies GetStaticPaths;

const { slug } = Astro.params;
const data = cutCases.find((c) => c.slug === slug)!;
const project = projects.find((p) => p.slug === slug)!;
const img = shots[slug] ?? {};
const art = heroArt[slug];

/** One picture per case for the carousel. Sherwin has no UI to show, so it
    keeps the stats panel it is given on the home page. */
const thumbs: Record<string, { img?: any; alt?: string; fit?: boolean }> = {
  /* Three screens rather than one, on their own dark ground. `fit` shows the
     whole picture instead of filling the frame with part of it: the point of
     these two is the set, so cropping one phone off defeats them. The card
     ground matches the artwork's own #0d0d0d, so the letterboxing does not
     show as a band. */
  miigenie: { img: thMiigenie, alt: 'Three miiGenie screens: onboarding, the home screen, and the carer view', fit: true },
  kinvault: { img: thKinvault, alt: 'Three KinVault screens: transfer review, a shared vault, and the dashboard', fit: true },
  hazop: { img: thHazop, alt: 'The HAZOP Edge analytics dashboard' },
  'api-lifecycle': { img: thEricsson, alt: 'The Ericsson API Console' },
  amble: { img: thAmble, alt: 'Amble, a plant system growing through a 2065 home' },
  'sherwin-williams': {},
};

/* Every other case, not the first three. Slicing to three left two of the
   six reachable only by going back to the home page, which is a dead end at
   the exact moment someone has finished reading and wants the next one. */
const others = projects.filter((p) => p.slug !== slug);

/**
 * Column count for a card grid, chosen so the last row is never a single
 * orphan. Prefer a count that divides exactly; otherwise the largest that
 * leaves at least two on the final row. Five cards go three and two, not
 * four and one.
 */
const colsFor = (n: number) =>
  [4, 3, 2].find((c) => n % c === 0) ?? [4, 3, 2].find((c) => n % c >= 2) ?? 2;

/**
 * Below about 1000px every grid falls to two columns, which puts the orphan
 * back on any odd count. Three or five cards stack instead: at that width a
 * card is wide and short, so a column of them reads fine and a half-empty
 * final row does not. Seven stay two across, since stacking all seven is the
 * worse of the two.
 */
const midColsFor = (n: number) => (n % 2 === 1 && n <= 5 ? 1 : 2);

---

<Cut
  title={`${project.short}, Sayantan Dutta`}
  description={data.lead}
  navTone="dark"
  active="work"
>

<main id="main">
<article>
  <!-- ═══ HEADER: scannable before any prose ════════════════════════ -->
  <header class={`pagehead ${art ? 'ph-split' : ''}`}>
    <div class="ph-copy">
      <p class="crumb"><a href="/v/cut#work" data-ab="case:back"><span aria-hidden="true">←</span> Work</a> <span class="sep" aria-hidden="true">/</span> {project.short}</p>
      <p class="meta-row">
        <span class={`status-chip st-${project.status.toLowerCase()}`}>{project.status}</span>
        <span class="kind-chip">{project.kind}</span>
        <span class="field-chip">{project.field}</span>
        <span class="period">{project.period}</span>
      </p>
      <h1>{project.title}</h1>
      <p class="lead">{data.lead}</p>
    </div>

    {art && (
      <div class="ph-art">
        {art.device === 'phones' && (
          <div class="hero-phones">
            {art.imgs!.map((t: any, i: number) => (
              <div class={`hero-phone hp-${i}`}>
                <div class="hero-phone-screen">
                  <Image src={t} alt={art.alts?.[i] ?? ''} widths={[320, 640]} sizes="190px" loading="eager" />
                </div>
              </div>
            ))}
          </div>
        )}

        {art.device === 'laptop' && (
          <div class="hero-laptop">
            <div class="hl-screen">
              <div class="hl-bar">
                <span class="hl-label">{art.label}</span>
                <span class="hl-dots" aria-hidden="true"><span></span><span></span><span></span></span>
              </div>
              <div class="hl-view">
                <Image src={art.img} alt={art.alt ?? ''} widths={[640, 1280]} sizes="(max-width: 900px) 92vw, 560px" loading="eager" />
              </div>
            </div>
          </div>
        )}

        {art.device === 'flat' && (
          <div class="hero-flat">
            <Image src={art.img} alt={art.alt ?? ''} widths={[640, 1280]} sizes="(max-width: 900px) 100vw, 560px" loading="eager" />
          </div>
        )}

        {art.device === 'ops' && (
          <div class="hero-ops">
            <p class="hops-band">Design Operations · Sherwin-Williams</p>
            <dl class="hops-stats">
              <div><dt>30 to 40%</dt><dd>less rework</dd></div>
              <div><dt>20+</dt><dd>people supported</dd></div>
              <div><dt>6</dt><dd>digital products</dd></div>
            </dl>
            <p class="hops-foot">File architecture, shared research templates, and a five-step handoff.</p>
          </div>
        )}
      </div>
    )}
  </header>

  <div class="case-facts">
    <dl class="glance">
      {data.glance.map((g) => <div><dt>{g.k}</dt><dd>{g.v}</dd></div>)}
    </dl>

    <ul class="scope">
      {data.scope.map((s) => <li>{s}</li>)}
    </ul>
  </div>

  {/* Met before the argument rather than after it. A festival selection is
      the one fact on this page a reviewer can check independently, and it
      was three sentences in the closing section. */}
  {data.exhibit && (
    <div class="band exh-band">
      <div class="exh" data-reveal>
        <div class="exh-chip">
          <Image src={amLdf} alt="" widths={[180, 360]} sizes="112px" loading="lazy" />
        </div>
        <div class="exh-body">
          <p class="exh-top">
            <span class="exh-tag">{data.exhibit.tag}</span>
            <span class="exh-fest">{data.exhibit.festival}</span>
          </p>
          {/* On one line on purpose: a newline between these expressions is
              rendered as a space, which put a gap before the full stop. */}
          <p class="exh-lead">{data.exhibit.lead.split(data.exhibit.emphasis)[0]}<em>{data.exhibit.emphasis}</em>{data.exhibit.lead.split(data.exhibit.emphasis)[1]}</p>
          <p class="exh-sub">{data.exhibit.sub}</p>
          <dl class="exh-facts">
            {data.exhibit.facts.map((f) => <div><dt>{f.k}</dt><dd>{f.v}</dd></div>)}
          </dl>
        </div>
      </div>
    </div>
  )}

  <!-- ═══ SECTIONS ══════════════════════════════════════════════════ -->
  {data.sections.map((sec) => (
    <section class="band">
      <div class="case-sec" data-reveal>
        <div class="cs-head">
          <p class="sec-k">{sec.kicker}</p>
          <h2>{sec.heading}</h2>
        </div>
        <div class="cs-body">
          {sec.body.map((p) => <p class="case-p">{p}</p>)}
          {sec.pull && <p class="case-pull">{sec.pull}</p>}
        </div>
      </div>

      {/* An ordered list, because it is a progression and the order carries
          the meaning. The dates are the list content; the rail behind them is
          drawn and hidden from assistive tech. */}
      {/* Participants in their own words, each with its source. */}
      {sec.quotes && (
        <ul class="qts" data-reveal style={`--n:${sec.quotes.length}`}>
          {sec.quotes.map((q, i) => (
            <li style={`--d:${i * 70}ms`}>
              <blockquote>
                <p>“{q.q}”</p>
                <cite>{q.who}</cite>
              </blockquote>
            </li>
          ))}
        </ul>
      )}

      {/* The brand, shown. The prose beside it names the wordmark and lists
          the palette, which asks the reader to picture five colours they
          cannot see; these are the colours. */}
      {sec.brand && (
        <div class="brand" data-reveal>
          {sec.brand.logo && (
            <figure class="brand-mark">
              <div class="brand-plate">
                <Image src={amLogo} alt="The Amble wordmark, lowercase, with a flower growing from the a and a leaf from the e" widths={[320, 640]} sizes="260px" loading="lazy" />
              </div>
              {sec.brand.logoCaption && <figcaption>{sec.brand.logoCaption}</figcaption>}
            </figure>
          )}
          {sec.brand.swatches && (
            <figure class="brand-pal">
              <ul>
                {sec.brand.swatches.map((c) => (
                  <li>
                    <span class="sw" style={`background:${c.hex}`} aria-hidden="true"></span>
                    <span class="sw-n">{c.name}</span>
                    <span class="sw-h">{c.hex}</span>
                  </li>
                ))}
              </ul>
              {sec.brand.swatchCaption && <figcaption>{sec.brand.swatchCaption}</figcaption>}
            </figure>
          )}
        </div>
      )}

      {sec.rail && (
        <ol class="rail" data-reveal>
          {sec.rail.map((n, i) => (
            <li class={i === sec.rail!.length - 1 ? 'rail-now' : ''}>
              <span class="rail-d">{n.d}</span>
              <span class="rail-r">{n.r}</span>
            </li>
          ))}
        </ol>
      )}

      {sec.shot === 'beforeAfter' && img.before && (
        <div class="ba" data-reveal>
          <figure>
            <p class="ba-tag is-before">Before · the build as I found it</p>
            <div class="ba-shot"><Image src={img.before} alt="The home screen before the redesign" widths={[260, 520]} sizes="220px" /></div>
            <figcaption>The screens worked, but flat and generic: dark tiles, little warmth, and no hierarchy guiding the eye to the main voice action</figcaption>
          </figure>
          <figure>
            <p class="ba-tag is-after">After · the designed system</p>
            <div class="ba-shot"><Image src={img.after} alt="The home screen after the redesign" widths={[260, 520]} sizes="220px" /></div>
            <figcaption>Warm cream and deep teal, large type, one clear voice action, help and reassurance held calmly at the foot</figcaption>
          </figure>
        </div>
      )}

      {/* One, two or three phones, each with its own caption. The caption is
          the accessible description, so the image steps out of the way. */}
      {['trio', 'pair', 'solo', 'web', 'scenes', 'posters'].includes(sec.shot ?? '') && img[sec.shot!] && (
        <div
          class={`trio ${
            ['web', 'scenes', 'posters'].includes(sec.shot!)
              ? 'landrow row-' + sec.shot
              : img[sec.shot!][0].width > img[sec.shot!][0].height
                ? 'landrow row-wide-pair'
                : ''
          }`}
          data-reveal
          style={`--n:${img[sec.shot!].length}`}
        >
          {img[sec.shot!].map((t: any, i: number) => (
            <figure style={`--d:${i * 80}ms`}>
              <div class="plate" style={`--ar:${t.width} / ${t.height}`}>
                <Image src={t} alt={sec.alts?.[i] ?? `A screen from ${project.short}`} widths={sec.shot === 'trio' || sec.shot === 'pair' || sec.shot === 'solo' ? [320, 640] : [420, 840]} sizes={sec.shot === 'web' ? '330px' : sec.shot === 'posters' ? '500px' : '260px'} loading="lazy" />
              </div>
              {sec.caps?.[i] && <figcaption>{sec.caps[i]}</figcaption>}
            </figure>
          ))}
        </div>
      )}

      {(sec.shot === 'wide' || sec.shot === 'wide2' || sec.shot === 'wide3') && img[sec.shot] && (
        <figure
          class={`wide ${img[sec.shot].height > img[sec.shot].width ? 'wide-tall' : ''}`}
          data-reveal
        >
          <div class="wide-frame">
              {/* The caption labels the screen; the alt says what is on it.
                  They are not interchangeable, so the figure carries both. */}
            <Image src={img[sec.shot]} alt={sec.alt ?? `A screen from ${project.short}`} widths={[820, 1600]} sizes="(max-width: 1100px) 92vw, 1060px" loading="lazy" />
          </div>
          {sec.caption && <figcaption>{sec.caption}</figcaption>}
        </figure>
      )}

      {sec.block?.kind === 'cards' && (
        <ol
          class={`cards cards-c${colsFor(sec.block.items.length)} cards-m${midColsFor(sec.block.items.length)}`}
          data-reveal
        >
          {sec.block.items.map((c, i) => (
            <li class={c.kept ? 'card-kept' : ''}>
              <span class="card-n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{c.t}</h3>
              {c.tag && <span class="card-tag">{c.tag}</span>}
              <p>{c.b}</p>
            </li>
          ))}
        </ol>
      )}

      {sec.shot === 'partners' && img.partners && (
        <ul class="partners" role="list" data-reveal aria-label="Project partners">
          {img.partners.map((logo: any, i: number) => (
            <li><Image src={logo} alt={sec.alts?.[i] ?? ''} widths={[200, 400]} sizes="150px" loading="lazy" /></li>
          ))}
        </ul>
      )}

      {/* A sequence reads as rows, not a grid: the steps are ordered, and a
          grid leaves an empty cell whenever the count is not a multiple of
          the column count. */}
      {sec.block?.kind === 'steps' && (
        <ol class="steps" data-reveal>
          {sec.block.items.map((st, i) => (
            <li>
              <span class="step-n">{String(i + 1).padStart(2, '0')}</span>
              <div class="step-body">
                <h3>{st.t}</h3>
                <p>{st.b}</p>
              </div>
            </li>
          ))}
        </ol>
      )}

      {sec.block?.kind === 'blueprint' && (
        <figure class="bp" data-reveal>
          <div class="bp-scroll" tabindex="0" role="region" aria-label={`${project.short} service blueprint, scrolls horizontally`}>
            <div class="bp-grid" style={`--cols:${sec.block.stages.length}`}>
              <div class="bp-corner">{sec.block.axis}</div>
              {sec.block.stages.map((st, i) => (
                <div class="bp-stage"><span class="bp-num">{String(i + 1).padStart(2, '0')}</span>{st}</div>
              ))}
              {sec.block.layers.map((ly, li) => (
                <>
                  {ly.divider && <p class="bp-vis">{ly.divider}</p>}
                  <div class="bp-layer"><b>{ly.name}</b><span>{ly.role}</span></div>
                  {ly.cells.map((c) => <div class="bp-cell">{c}</div>)}
                </>
              ))}
            </div>
          </div>
          {sec.block.caption && <figcaption>{sec.block.caption}</figcaption>}
        </figure>
      )}

      {sec.block?.kind === 'stats' && (
        <dl class="statrow" data-reveal>
          {sec.block.items.map((st) => (
            <div><dt>{st.n}</dt><dd>{st.l}</dd></div>
          ))}
        </dl>
      )}

      {sec.block?.kind === 'personas' && (
        <ul class="personas" data-reveal>
          {sec.block.items.map((pr) => (
            <li>
              <p class="pr-top"><span class="pr-role">{pr.role}</span><span class="pr-age">{pr.age}</span></p>
              <h3>{pr.name}</h3>
              <p class="pr-note">{pr.note}</p>
            </li>
          ))}
        </ul>
      )}

      {sec.block?.kind === 'journey' && (
        <div class="tbl-scroll" data-reveal tabindex="0" role="region" aria-label={sec.heading}>
          <table class="tbl">
            <thead><tr>{sec.block.cols.map((c) => <th scope="col">{c}</th>)}</tr></thead>
            <tbody>
              {sec.block.rows.map((r) => (
                <tr><th scope="row">{r[0]}</th><td>{r[1]}</td><td>{r[2]}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {sec.block?.kind === 'compare' && (
        <div class="compare" data-reveal>
          <div class="cmp cmp-before">
            <h3>{sec.block.before.h}</h3>
            <ul>{sec.block.before.items.map((i) => <li>{i}</li>)}</ul>
          </div>
          <div class="cmp cmp-after">
            <h3>{sec.block.after.h}</h3>
            <ul>{sec.block.after.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        </div>
      )}

      {sec.shot === 'figure' && (
        <figure class="statfig" data-reveal>
          <span>30 to 40%</span>
          <figcaption>less rework across six digital products, for a team of more than twenty</figcaption>
        </figure>
      )}
    </section>
  ))}

  <!-- ═══ REFLECTION ════════════════════════════════════════════════ -->
  <section class="band">
    <div class="case-sec" data-reveal>
      <div class="cs-head">
        <p class="sec-k">Learnings and reflections</p>
        <h2>{data.reflection.heading}</h2>
      </div>
      <div class="cs-body">
        {data.reflection.body.map((p) => <p class="case-p">{p}</p>)}
      </div>
    </div>
  </section>

  <!-- ═══ NEXT ══════════════════════════════════════════════════════ -->
  <section class="band">
    <div class="band-head car-head" data-reveal>
      <div>
        <p class="sec-k">Next</p>
        <h2>The rest of the work</h2>
      </div>
      <!-- The arrows ship hidden and JS reveals them, because JS is also what
           makes them do anything. Without it the strip is still a native
           horizontal scroller and every card is still a Tab stop, so nothing
           here is reachable only by clicking an arrow. -->
      <p class="car-nav">
        <button type="button" class="car-btn" data-car="prev" aria-label="Scroll to previous case studies" hidden>
          <span aria-hidden="true">←</span>
        </button>
        <button type="button" class="car-btn" data-car="next" aria-label="Scroll to more case studies" hidden>
          <span aria-hidden="true">→</span>
        </button>
      </p>
    </div>

    <div class="car" tabindex="0" role="region" aria-label="More case studies, a horizontally scrolling list">
      <ul class="car-track">
        {others.map((o, i) => {
          const th = thumbs[o.slug] ?? {};
          return (
            <li class="car-card" style={`--d:${i * 70}ms`}>
              <a href={`/v/cut/${o.slug}`} data-ab={`next:${o.slug}`}>
                <span class={`car-vis ${th.fit ? 'is-fit' : ''} ${th.img ? '' : 'is-ops'}`}>
                  {th.img ? (
                    <Image src={th.img} alt={th.alt ?? ''} widths={[420, 840]} sizes="330px" loading="lazy" />
                  ) : (
                    <span class="car-ops">
                      <span class="car-ops-band">Design Operations · Sherwin-Williams</span>
                      <span class="car-ops-stats">
                        <span><b>30 to 40%</b> less rework</span>
                        <span><b>20+</b> people supported</span>
                        <span><b>6</b> digital products</span>
                      </span>
                    </span>
                  )}
                </span>
                <span class="car-chips">
                  <span class="car-chip car-chip-kind">{o.kind}</span>
                  <span class="car-chip car-chip-field">{o.field}</span>
                </span>
                <span class="car-t">{o.title}</span>
                <span class="car-go">View case study <span aria-hidden="true">→</span></span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</article>
</main>

<script>
  /**
   * The carousel arrows. Progressive enhancement: they are rendered `hidden`
   * and only revealed here, because without this script they would do
   * nothing. The strip itself needs no JS at all, so a failure here costs
   * the arrows and nothing else.
   */
  const car = document.querySelector<HTMLElement>('.car');
  const prev = document.querySelector<HTMLButtonElement>('[data-car="prev"]');
  const next = document.querySelector<HTMLButtonElement>('[data-car="next"]');

  if (car && prev && next) {
    const scrollable = () => car.scrollWidth - car.clientWidth > 4;

    const sync = () => {
      // Nothing to scroll means nothing to offer: a control that cannot do
      // anything is worse than no control.
      const on = scrollable();
      prev.hidden = next.hidden = !on;
      if (!on) return;
      prev.disabled = car.scrollLeft <= 2;
      next.disabled = car.scrollLeft >= car.scrollWidth - car.clientWidth - 2;
    };

    // Someone who asked for less motion still gets the move, just not the glide.
    const motion = () => (matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth');

    /**
     * Scroll to a card's own left edge rather than by a measured step.
     * `scroll-snap-type: x mandatory` re-snaps while a smooth `scrollBy` is
     * still running and drags it back to where it started: the first arrow
     * press moved 353px and the next two moved one pixel between them.
     * Landing exactly on a snap point leaves nothing for the snap to undo.
     */
    const go = (dir: number) => {
      // Measured against the scroller, not via `offsetLeft`. `.car` is not a
      // positioned element, so `offsetLeft` reports each card's distance from
      // some ancestor instead: 51, 403, 756 where the scroller's own scale
      // starts at 0. Scrolling to 51 moved nothing and the snap took it back.
      const base = car.getBoundingClientRect().left;
      const here = car.scrollLeft;
      const edges = [...car.querySelectorAll<HTMLElement>('.car-card')].map((c) =>
        Math.round(c.getBoundingClientRect().left - base + here),
      );
      const target = dir > 0 ? edges.find((x) => x > here + 2) : [...edges].reverse().find((x) => x < here - 2);
      car.scrollTo({
        left: target ?? (dir > 0 ? car.scrollWidth : 0),
        behavior: motion() as ScrollBehavior,
      });
    };

    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    car.addEventListener('scroll', sync, { passive: true });
    addEventListener('resize', sync);
    sync();
  }
</script>


<style>
  /* ── the opening ───────────────────────────────────────────────────
     The case used to begin on an empty black band: a screen of nothing
     before the first idea. It now begins on the work, the way the main
     site's cases do. Copy keeps the black ground, so the headline contrast
     is unchanged; the image sits beside it and runs off the right edge of
     the page instead of sitting in a box.

     The grid names its lines so the copy lands on exactly the same left
     edge as every `.band` below it, while the art can span from the middle
     of the measure out to the page edge. Doing it with named lines rather
     than `100vw` keeps it right when a scrollbar is present, which `100vw`
     famously is not. */
  .pagehead.ph-split {
    display: grid;
    align-items: center;
    column-gap: clamp(1.4rem, 3.5vw, 3rem);
    padding: clamp(5rem, 11vw, 7.5rem) 0 clamp(3rem, 7vw, 4.5rem);
    grid-template-columns:
      [full-start] minmax(var(--pad), 1fr)
      [content-start] minmax(0, calc((var(--measure) - var(--pad) * 2) * 0.54))
      [mid] minmax(0, calc((var(--measure) - var(--pad) * 2) * 0.46))
      [content-end] minmax(var(--pad), 1fr) [full-end];
    overflow: hidden;
  }
  .ph-copy { grid-column: content-start / mid; min-width: 0; }
  /* The chips used to sit on one full-page line with a `·` before the dates.
     In a half-width column the row wraps, and the separator was being left
     hanging at the end of a line with nothing after it. The gap separates
     them well enough without it. */
  .ph-copy .period { color: #8a8a86; }
  .ph-art { grid-column: mid / full-end; min-width: 0; }
  /* Two kinds of art stop at the content edge rather than running out to the
     edge of the page. Sherwin's panel is made of sentences. The laptop holds
     a dashboard, and running a dashboard off the page cuts away the columns
     and charts that are the reason it is being shown at all: losing the right
     edge of a phone costs nothing, losing the right third of an analytics
     view costs the point. Both are sized to sit whole beside the title. */
  .ph-art:has(.hero-ops), .ph-art:has(.hero-laptop) { grid-column: mid / content-end; }

  /* Insurance: if a case ever has no hero art, the copy still needs the
     centred measure the removed `.pagehead-in` used to give it. */
  .pagehead:not(.ph-split) .ph-copy {
    max-width: calc(var(--measure) - var(--pad) * 2); margin-inline: auto;
  }

  /* The bleed is deliberate rather than incidental. Sized to the column
     alone, three phones happen to fit inside it at 1440 and the edge reads
     as a margin, which is the boxed look we are leaving behind. A negative
     right margin pushes the art past the page edge at every width, and the
     header clips it. */
  .hero-phones, .hero-flat { margin-right: calc(-1 * clamp(1.5rem, 5vw, 5rem)); }

  /* phones: the middle one lifted, as on the main site */
  .hero-phones { display: flex; align-items: flex-end; gap: clamp(.45rem, 1.2vw, .9rem); }
  .hero-phone {
    flex: 0 0 auto; width: clamp(118px, 14.5vw, 196px);
    background: #151512; border-radius: clamp(16px, 2vw, 24px); padding: 5px;
    box-shadow: 0 26px 54px -20px rgba(0, 0, 0, .8);
  }
  .hero-phone-screen { border-radius: clamp(12px, 1.6vw, 19px); overflow: hidden; background: #fff; }
  .hero-phone img { display: block; width: 100%; height: auto; }
  .hp-1 { margin-bottom: clamp(1rem, 3vw, 2.6rem); }

  /* laptop: the same chrome the home page uses, at hero scale */
  .hl-screen {
    background: #151512; border: 1px solid #272724; border-radius: 9px;
    overflow: hidden; box-shadow: 0 26px 54px -20px rgba(0, 0, 0, .8);
  }
  .hl-bar {
    display: flex; align-items: center; justify-content: space-between;
    padding: .5rem .8rem; border-bottom: 1px solid #272724; background: #1b1b18;
  }
  .hl-label { font-size: var(--micro); font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #8a8a86; }

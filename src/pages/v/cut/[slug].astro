  .ba-shot {
    width: 100%; display: flex; justify-content: center;
    padding: clamp(1.2rem, 3vw, 1.9rem) 0;
    background: var(--paper-2); border: 1px solid var(--line); border-radius: 6px;
  }
  .ba-shot img { width: 58%; max-width: 220px; height: auto; border-radius: 14px; box-shadow: 0 10px 30px rgba(0,0,0,.28); }
  .ba figcaption { margin-top: .9rem; max-width: 34ch; }
  @media (max-width: 620px) { .ba { grid-template-columns: 1fr; } }

  /* The figures a case ends on. */
  .statrow {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
    gap: 1px; background: var(--line); border: 1px solid var(--line);
    margin-top: clamp(2rem, 5vw, 3rem);
  }
  .statrow > div { background: var(--paper-2); padding: clamp(1.3rem, 3vw, 1.9rem); }
  .statrow dt { font-size: clamp(1.9rem, 5vw, 2.8rem); font-weight: 800; letter-spacing: -.045em; line-height: 1; color: var(--accent); }
  .statrow dd { margin-top: .6rem; font-family: var(--read); font-size: .88rem; color: var(--ink-2); }
  /* Column count comes from how many phones the section has, so a pair does
     not sit in a three-wide grid with a hole on the end. */
  .trio { display: grid; grid-template-columns: repeat(var(--n, 3), minmax(0, 250px)); gap: clamp(1rem, 3vw, 2rem); margin-top: clamp(2rem, 5vw, 3rem); }
  .trio figcaption { margin-top: .8rem; font-size: .82rem; color: var(--faint); }
  /* Browser shape, not phone shape: the plate keeps the capture's own ratio
     and a smaller radius, and the columns are wider because a page needs
     more room than a screen does. */
  /* Browser shape, not phone shape. The ratio lives on the plate rather than
     the image: these captures are not all the same height, and an `auto`
     ratio on a lazy image reserves nothing, so the row shifted as each one
     arrived. A fixed plate gives three matching tiles and no shift. */
  /* Landscape rows: browser captures, concept scenes and exhibition posters.
     The ratio lives on the plate so a lazy image reserves its space and a set
     of mixed-height sources still lines up. */
  /* Each plate takes its own source's ratio. A fixed ratio per row was
     chosen to stop lazy images shifting the layout, and it does, but it also
     crops to fill: Amble's laundry and air-filter are portrait photographs
     and a 16/9 plate was throwing away 58% and 55% of them, and HAZOP's
     dashboards lost a fifth. `--ar` comes from the file at build time, so the
     space is still reserved ahead of the image and nothing is cut. */
  .landrow .plate { border-radius: 6px; aspect-ratio: var(--ar); }
  .landrow .plate img { width: 100%; height: 100%; aspect-ratio: auto; object-fit: cover; object-position: center; }
  .landrow { align-items: start; }
  .row-web { grid-template-columns: repeat(var(--n, 3), minmax(0, 330px)); }
  .row-web .plate img { object-position: top center; }
  .row-scenes { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 820px; }
  /* The plate's phone ratio is the default because most captures here are
     phone screens, but Ericsson's pair are 1800x1036 desktop captures. Poured
     into a 788x1778 window and cropped to fill, a whole console UI came out
     as a narrow vertical slice of its own top edge. Landscape sources get a
     landscape plate, decided from the file rather than named per case, so the
     next landscape screenshot added cannot reintroduce this. */
  .row-wide-pair { grid-template-columns: repeat(2, minmax(0, 1fr)); max-width: 880px; }
  .row-posters { grid-template-columns: repeat(2, minmax(0, 320px)); }
  @media (max-width: 620px) { .row-scenes, .row-posters { grid-template-columns: 1fr; max-width: 320px; } }

  /* Partner marks: greyed until hovered, like the tool grid on About. */
  .partners { display: flex; flex-wrap: wrap; align-items: center; gap: clamp(1.4rem, 4vw, 3rem); margin-top: clamp(2rem, 5vw, 2.6rem); }
  .partners img { width: auto; max-width: 150px; max-height: 54px; object-fit: contain; filter: grayscale(1) opacity(.55); transition: filter var(--quick) var(--ease); }
  .partners li:hover img { filter: none; }
  @media (max-width: 720px) { .ba, .trio { grid-template-columns: 1fr; max-width: 280px; } }
  .ba figcaption { margin-top: .8rem; font-size: .82rem; color: var(--faint); max-width: 34ch; }

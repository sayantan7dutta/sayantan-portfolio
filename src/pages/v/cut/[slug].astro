  /* flat: a photograph needs no frame */
  .hero-flat { border-radius: 8px; overflow: hidden; box-shadow: 0 26px 54px -20px rgba(0, 0, 0, .8); }
  .hero-flat img { display: block; width: 100%; height: auto; }

  /* ops: Sherwin has no UI to show, so it gets the panel it gets elsewhere.

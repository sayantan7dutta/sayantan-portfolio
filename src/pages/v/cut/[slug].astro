---
/**
 * Every case study in the Director's Cut language, from one template.
 *
 * Structure follows the hiring research: role, scope and status are scannable
 * before any prose, a status chip answers "is it live?", and where
 * src/lib/decisions.ts carries a trade-off it is given its own block.
 *
 * Layout: each section is a two-column spread — kicker and heading on the
 * left, the reading column on the right — so a long page keeps its measure
 * without leaving a third of every screen empty. Figures, tables and card
 * blocks sit outside that grid and run the full band, which is what gives
 * the page its rhythm.
 */
import type { GetStaticPaths } from 'astro';
import { Image } from 'astro:assets';
import Cut from '../../../layouts/Cut.astro';
import { projects } from '../../../lib/variants';
import { cutCases } from '../../../lib/cut-cases';
import { decisions } from '../../../lib/decisions';

import mgBefore from '../../../assets/work/miigenie/before-home.png';
import mgAfter from '../../../assets/work/miigenie/home.png';
import mgListening from '../../../assets/work/miigenie/listening.png';
import mgMyDay from '../../../assets/work/miigenie/my-day.png';
import mgCarer from '../../../assets/work/miigenie/carer-home.png';
import mgOnboarding from '../../../assets/work/miigenie/onboarding.png';
import mgError from '../../../assets/work/miigenie/error-state.png';
import mgConnect from '../../../assets/work/miigenie/connect.png';
import mgSiteHero from '../../../assets/work/miigenie/site-hero.jpg';
import mgSiteHow from '../../../assets/work/miigenie/site-how.jpg';
import mgSiteTrial from '../../../assets/work/miigenie/site-trial.jpg';
import hzScenario from '../../../assets/work/hazop/scenario-summary.jpg';
import hzAnalytics from '../../../assets/work/hazop/analytics-dashboard.jpg';
import soProducts from '../../../assets/work/soter-software/products.jpg';
import apDashboard from '../../../assets/work/api-lifecycle/dashboard.png';
import apDetails from '../../../assets/work/api-lifecycle/design-details.png';
import kvVault from '../../../assets/work/kinvault/vault.jpg';
import kvTransfer from '../../../assets/work/kinvault/smart-transfer.jpg';
import amFamily from '../../../assets/work/amble/family.jpg';
import amRoutines from '../../../assets/work/amble/routines.jpg';

/** Per-case image slots, keyed by the `shot` names used in cut-cases.ts. */
const shots: Record<string, Record<string, any>> = {
  miigenie: {
    before: mgBefore, after: mgAfter,
    /* The voice loop as it is actually used: start, speak, get it wrong. */
    trio: [mgOnboarding, mgListening, mgError],
    pair: [mgConnect, mgCarer],
    solo: [mgMyDay],
    /* The marketing site, in browser shape rather than phone shape. */
    web: [mgSiteHero, mgSiteHow, mgSiteTrial],
  },
  hazop: { wide: hzScenario, wide2: hzAnalytics, wide3: soProducts },
  'api-lifecycle': { wide: apDashboard, wide2: apDetails },
  kinvault: { wide: kvVault, wide2: kvTransfer },
  amble: { wide: amFamily, wide2: amRoutines },
  'sherwin-williams': {},
};

export const getStaticPaths = (() =>
  cutCases.map((c) => ({ params: { slug: c.slug } }))) satisfies GetStaticPaths;

const { slug } = Astro.params;
const data = cutCases.find((c) => c.slug === slug)!;
const project = projects.find((p) => p.slug === slug)!;
const decision = decisions.find((d) => d.slug === slug);
const img = shots[slug] ?? {};

const others = projects.filter((p) => p.slug !== slug).slice(0, 3);

---

<Cut
  title={`${project.short}, Sayantan Dutta`}
  description={data.lead}
  navTone="dark"
  active="work"
>

<main id="main">
<article>
  <!-- ═══ HEADER: scannable before any prose ════════════════════════ -->
  <header class="pagehead">
    <div class="pagehead-in">
      <p class="crumb"><a href="/v/cut#work" data-ab="case:back"><span aria-hidden="true">←</span> Work</a> <span class="sep" aria-hidden="true">/</span> {project.short}</p>
      <p class="meta-row">
        <span class={`status-chip st-${project.status.toLowerCase()}`}>{project.status}</span>
        <span class="kind-chip">{project.kind}</span>
        <span class="field-chip">{project.field}</span>
        <span class="dot" aria-hidden="true">·</span>
        <span>{project.period}</span>
      </p>
      <h1>{project.title}</h1>
      <p class="lead">{data.lead}</p>
    </div>
  </header>

  <div class="case-facts">
    <dl class="glance">
      {data.glance.map((g) => <div><dt>{g.k}</dt><dd>{g.v}</dd></div>)}
    </dl>

    <ul class="scope">
      {data.scope.map((s) => <li>{s}</li>)}
    </ul>
  </div>

  <!-- ═══ SECTIONS ══════════════════════════════════════════════════ -->
  {data.sections.map((sec) => (
    <section class="band">
      <div class="case-sec" data-reveal>
        <div class="cs-head">
          <p class="sec-k">{sec.kicker}</p>
          <h2>{sec.heading}</h2>
        </div>
        <div class="cs-body">
          {sec.body.map((p) => <p class="case-p">{p}</p>)}
          {sec.pull && <p class="case-pull">{sec.pull}</p>}
        </div>
      </div>

      {sec.shot === 'beforeAfter' && img.before && (
        <div class="ba" data-reveal>
          <figure>
            <div class="plate dim"><Image src={img.before} alt="The home screen before the redesign" widths={[320, 640]} sizes="280px" /></div>
            <figcaption><b>Before.</b> Dark tiles, little warmth, no hierarchy guiding the eye to the main voice action.</figcaption>
          </figure>
          <figure>
            <div class="plate"><Image src={img.after} alt="The home screen after the redesign" widths={[320, 640]} sizes="280px" /></div>
            <figcaption><b>After.</b> Warm cream and deep teal, large type, one clear voice action.</figcaption>
          </figure>
        </div>
      )}

      {/* One, two or three phones, each with its own caption. The caption is
          the accessible description, so the image steps out of the way. */}
      {['trio', 'pair', 'solo', 'web'].includes(sec.shot ?? '') && img[sec.shot!] && (
        <div class={sec.shot === 'web' ? 'trio webrow' : 'trio'} data-reveal style={`--n:${img[sec.shot!].length}`}>
          {img[sec.shot!].map((t: any, i: number) => (
            <figure style={`--d:${i * 80}ms`}>
              <div class="plate">
                <Image src={t} alt={sec.alts?.[i] ?? `A screen from ${project.short}`} widths={sec.shot === 'web' ? [400, 800] : [320, 640]} sizes={sec.shot === 'web' ? '330px' : '250px'} loading="lazy" />
              </div>
              {sec.caps?.[i] && <figcaption>{sec.caps[i]}</figcaption>}
            </figure>
          ))}
        </div>
      )}

      {(sec.shot === 'wide' || sec.shot === 'wide2' || sec.shot === 'wide3') && img[sec.shot] && (
        <figure class="wide" data-reveal>
          <div class="wide-frame">
              {/* The caption labels the screen; the alt says what is on it.
                  They are not interchangeable, so the figure carries both. */}
            <Image src={img[sec.shot]} alt={sec.alt ?? `A screen from ${project.short}`} widths={[820, 1600]} sizes="(max-width: 1100px) 92vw, 1060px" loading="lazy" />
          </div>
          {sec.caption && <figcaption>{sec.caption}</figcaption>}
        </figure>
      )}

      {sec.block?.kind === 'cards' && (
        <ol class="cards" data-reveal>
          {sec.block.items.map((c, i) => (
            <li>
              <span class="card-n">{String(i + 1).padStart(2, '0')}</span>
              <h3>{c.t}</h3>
              <p>{c.b}</p>
            </li>
          ))}
        </ol>
      )}

      {sec.block?.kind === 'personas' && (
        <ul class="personas" data-reveal>
          {sec.block.items.map((pr) => (
            <li>
              <p class="pr-top"><span class="pr-role">{pr.role}</span><span class="pr-age">{pr.age}</span></p>
              <h3>{pr.name}</h3>
              <p class="pr-note">{pr.note}</p>
            </li>
          ))}
        </ul>
      )}

      {sec.block?.kind === 'journey' && (
        <div class="tbl-scroll" data-reveal tabindex="0" role="region" aria-label={sec.heading}>
          <table class="tbl">
            <thead><tr>{sec.block.cols.map((c) => <th scope="col">{c}</th>)}</tr></thead>
            <tbody>
              {sec.block.rows.map((r) => (
                <tr><th scope="row">{r[0]}</th><td>{r[1]}</td><td>{r[2]}</td></tr>
              ))}
            </tbody>
          </table>
        </div>
      )}

      {sec.block?.kind === 'compare' && (
        <div class="compare" data-reveal>
          <div class="cmp cmp-before">
            <h3>{sec.block.before.h}</h3>
            <ul>{sec.block.before.items.map((i) => <li>{i}</li>)}</ul>
          </div>
          <div class="cmp cmp-after">
            <h3>{sec.block.after.h}</h3>
            <ul>{sec.block.after.items.map((i) => <li>{i}</li>)}</ul>
          </div>
        </div>
      )}

      {sec.shot === 'figure' && (
        <figure class="statfig" data-reveal>
          <span>30 to 40%</span>
          <figcaption>less rework across six digital products, for a team of more than twenty</figcaption>
        </figure>
      )}
    </section>
  ))}

  <!-- ═══ THE DECISION ══════════════════════════════════════════════ -->
  {decision && (
    <section class="band decision-band">
      <div class="case-sec solo" data-reveal>
        <div class="cs-head">
          <p class="sec-k">The decision it turned on</p>
          <h2>{decision.question}</h2>
        </div>
        <div class="cs-body">
          <div class="forks">
            <div class="fork took"><p class="fork-k">What I did</p><p>{decision.took}</p></div>
            <div class="fork left"><p class="fork-k">What I didn’t</p><p>{decision.left}</p></div>
          </div>
          {decision.cost && (
            <div class="cost"><p class="cost-k">What it cost</p><p>{decision.cost}</p></div>
          )}
        </div>
      </div>
    </section>
  )}

  <!-- ═══ REFLECTION ════════════════════════════════════════════════ -->
  <section class="band">
    <div class="case-sec" data-reveal>
      <div class="cs-head">
        <p class="sec-k">Reflection</p>
        <h2>{data.reflection.heading}</h2>
      </div>
      <div class="cs-body">
        {data.reflection.body.map((p) => <p class="case-p">{p}</p>)}
      </div>
    </div>
  </section>

  <!-- ═══ NEXT ══════════════════════════════════════════════════════ -->
  <section class="band">
    <div class="band-head" data-reveal>
      <p class="sec-k">Next</p>
      <h2>Three more to read</h2>
    </div>
    <ul class="next" data-reveal>
      {others.map((o, i) => (
        <li style={`--d:${i * 70}ms`}>
          <a href={`/v/cut/${o.slug}`} data-ab={`next:${o.slug}`}>
            <span class="nx-t">{o.short}</span>
            <span class="nx-m">{o.field} · {o.period}</span>
            <span class="nx-go" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</article>
</main>

<style>
  .crumb .sep { margin: 0 .2rem; }
  /* The discipline tag, sized to match the status chip beside it. */
  .kind-chip, .field-chip {
    font-size: .62rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
    padding: .2rem .5rem; border-radius: 2px;
  }
  .kind-chip { background: rgba(244,244,243,.13); color: #e8e8e5; }
  /* Same accent the masthead's kicker uses, so the industry reads as the
     highlighted fact here too. */
  .field-chip { background: rgba(111,174,155,.15); color: #6fae9b; }
  /* The back arrow leans the way it is pointing, not the way everything else does. */
  .crumb a:hover > span, .crumb a:focus-visible > span { transform: translateX(-3px); }

  /* ── at a glance ── */
  .case-facts { max-width: var(--measure); margin: 0 auto; padding: clamp(2rem, 5vw, 3rem) var(--pad) 0; }
  .glance { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1.2rem; margin: 0 0 clamp(1.4rem, 3vw, 2rem); padding-bottom: clamp(1.2rem, 3vw, 1.6rem); border-bottom: 1px solid var(--line); }
  .glance dt { font-size: .62rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--faint); }
  .glance dd { font-size: .92rem; margin-top: .2rem; }

  /* Two columns of scope on wide screens: it is a list of facts, not prose,
     so it gains nothing from running the whole width in one file. */
  .scope { display: grid; gap: .6rem clamp(1.5rem, 4vw, 3.5rem); }
  @media (min-width: 900px) { .scope { grid-template-columns: 1fr 1fr; } }
  .scope li { position: relative; padding-left: 1.4rem; color: var(--ink-2); font-size: .95rem; }
  .scope li::before { content: ''; position: absolute; left: 0; top: .6em; width: 7px; height: 7px; background: var(--accent); border-radius: 50%; }

  /* ── the two-column spread ── */
  .case-sec { display: grid; grid-template-columns: minmax(0, 23rem) minmax(0, 1fr); gap: clamp(1.2rem, 4vw, 3.5rem); align-items: start; }
  .case-sec.solo { grid-template-columns: 1fr; }
  @media (max-width: 900px) { .case-sec { grid-template-columns: 1fr; } }
  .cs-head h2 { font-size: clamp(1.45rem, 3.6vw, 2.2rem); margin: .6rem 0 0; max-width: 22ch; }
  @media (max-width: 900px) { .cs-head { margin-bottom: 1.2rem; } }
  .case-p { font-family: var(--read); font-size: clamp(1rem, 2vw, 1.08rem); color: var(--ink-2); max-width: 64ch; }
  .case-p + .case-p { margin-top: 1rem; }
  .case-pull {
    font-family: var(--read); margin-top: 1.4rem; padding-left: 1.2rem;
    border-left: 2.5px solid var(--accent); max-width: 56ch;
    font-size: clamp(1.05rem, 2.3vw, 1.2rem); color: var(--ink);
  }

  /* plates */
  .plate { border-radius: 14px; overflow: hidden; border: 1px solid var(--line); background: #fff; box-shadow: 0 24px 46px -32px rgba(0,0,0,.5); transition: box-shadow var(--slow) var(--ease), transform var(--slow) var(--ease); }
  .plate img { width: 100%; display: block; aspect-ratio: 788 / 1778; object-fit: cover; object-position: top center; }
  .plate:hover { transform: translateY(-5px); box-shadow: 0 34px 56px -30px rgba(0,0,0,.55); }
  .dim { filter: saturate(.45) brightness(.9); }
  .ba { display: grid; grid-template-columns: repeat(2, minmax(0, 280px)); gap: clamp(1.4rem, 4vw, 3rem); margin-top: clamp(2rem, 5vw, 3rem); }
  /* Column count comes from how many phones the section has, so a pair does
     not sit in a three-wide grid with a hole on the end. */
  .trio { display: grid; grid-template-columns: repeat(var(--n, 3), minmax(0, 250px)); gap: clamp(1rem, 3vw, 2rem); margin-top: clamp(2rem, 5vw, 3rem); }
  .trio figcaption { margin-top: .8rem; font-size: .82rem; color: var(--faint); }
  /* Browser shape, not phone shape: the plate keeps the capture's own ratio
     and a smaller radius, and the columns are wider because a page needs
     more room than a screen does. */
  /* Browser shape, not phone shape. The ratio lives on the plate rather than
     the image: these captures are not all the same height, and an `auto`
     ratio on a lazy image reserves nothing, so the row shifted as each one
     arrived. A fixed plate gives three matching tiles and no shift. */
  .webrow { grid-template-columns: repeat(var(--n, 3), minmax(0, 330px)); }
  .webrow .plate { border-radius: 6px; aspect-ratio: 16 / 10; }
  .webrow .plate img { width: 100%; height: 100%; aspect-ratio: auto; object-fit: cover; object-position: top center; }
  @media (max-width: 720px) { .ba, .trio { grid-template-columns: 1fr; max-width: 280px; } }
  .ba figcaption { margin-top: .8rem; font-size: .82rem; color: var(--faint); max-width: 34ch; }
  .ba figcaption b { color: var(--ink); font-weight: 700; }

  .wide { margin-top: clamp(2rem, 5vw, 3rem); }
  .wide-frame { overflow: hidden; border-radius: 8px; border: 1px solid var(--line); box-shadow: 0 28px 54px -36px rgba(0,0,0,.45); }
  .wide-frame img { width: 100%; transition: transform 1.2s var(--ease); }
  .wide-frame:hover img { transform: scale(1.025); }
  .wide figcaption { margin-top: .8rem; font-size: .82rem; color: var(--faint); max-width: 62ch; }

  .statfig { margin-top: clamp(2rem, 5vw, 3rem); background: var(--accent); color: var(--paper); padding: clamp(2rem, 6vw, 3.5rem); text-align: center; border-radius: 8px; }
  .statfig span { display: block; font-size: clamp(2.4rem, 8vw, 4.4rem); font-weight: 800; letter-spacing: -.05em; line-height: 1; }
  .statfig figcaption { margin-top: .8rem; font-size: .9rem; opacity: .88; }

  /* ── numbered cards ── */
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); margin-top: clamp(2rem, 5vw, 2.6rem); }
  .cards li { background: var(--paper); padding: clamp(1.2rem, 2.6vw, 1.7rem); transition: background var(--quick) var(--ease); }
  .cards li:hover { background: #fff; }
  .card-n { font-size: .72rem; font-weight: 700; letter-spacing: .1em; color: var(--accent); }
  .cards h3 { font-size: 1.02rem; font-weight: 700; margin: .5rem 0 .5rem; letter-spacing: -.015em; }
  .cards p { font-family: var(--read); font-size: .92rem; color: var(--ink-2); }

  /* ── personas ── */
  .personas { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: clamp(.9rem, 2vw, 1.3rem); margin-top: clamp(2rem, 5vw, 2.6rem); }
  .personas li {
    border: 1px solid var(--line); border-top: 3px solid var(--accent);
    padding: clamp(1.1rem, 2.4vw, 1.5rem); background: var(--paper);
    transition: box-shadow var(--quick) var(--ease), transform var(--quick) var(--ease);
  }
  .personas li:hover { transform: translateY(-3px); box-shadow: 0 18px 30px -22px rgba(0,0,0,.4); }
  .pr-top { display: flex; justify-content: space-between; gap: .6rem; align-items: baseline; }
  .pr-role { font-size: .6rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--accent); }
  .pr-age { font-size: .74rem; color: var(--faint); }
  .personas h3 { font-size: .98rem; font-weight: 700; margin: .6rem 0 .45rem; letter-spacing: -.015em; }
  .pr-note { font-family: var(--read); font-size: .88rem; color: var(--ink-2); }

  /* ── stage table ── */
  /* Focusable, because on a narrow screen this is the only way to reach the
     right-hand columns without a mouse. */
  .tbl-scroll { overflow-x: auto; margin-top: clamp(2rem, 5vw, 2.6rem); }
  .tbl { width: 100%; border-collapse: collapse; min-width: 680px; }
  .tbl th, .tbl td { text-align: left; vertical-align: top; padding: .95rem .9rem; border-bottom: 1px solid var(--line); }
  .tbl th:first-child, .tbl td:first-child { padding-left: 0; }
  .tbl thead th { font-size: .62rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--faint); border-bottom: 1.5px solid var(--ink); }
  .tbl tbody tr { transition: background var(--quick) var(--ease); }
  .tbl tbody tr:hover { background: var(--paper-2); }
  .tbl tbody th { font-weight: 700; white-space: nowrap; color: var(--accent); width: 1%; }
  .tbl td { font-family: var(--read); font-size: .94rem; color: var(--ink-2); }
  .tbl td:last-child { color: var(--ink); }

  /* ── before / after columns ── */
  .compare { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1rem, 2.5vw, 2rem); margin-top: clamp(2rem, 5vw, 2.6rem); }
  @media (max-width: 720px) { .compare { grid-template-columns: 1fr; } }
  .cmp { padding: clamp(1.1rem, 2.4vw, 1.6rem); border: 1px solid var(--line); }
  .cmp-before { background: var(--paper-2); }
  .cmp-after { background: var(--paper); border-color: var(--accent); }
  .cmp h3 { font-size: .68rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; margin-bottom: .9rem; }
  .cmp-before h3 { color: var(--faint); }
  .cmp-after h3 { color: var(--accent); }
  .cmp li { font-size: .9rem; padding: .45rem 0 .45rem 1.1rem; position: relative; border-bottom: 1px solid var(--line); }
  .cmp li:last-child { border-bottom: 0; }
  .cmp li::before { content: ''; position: absolute; left: 0; top: .95em; width: 5px; height: 5px; border-radius: 50%; background: var(--faint); }
  .cmp-after li::before { background: var(--accent); }
  .cmp-before li { color: var(--faint); }

  /* decision */
  .decision-band { background: var(--paper-2); max-width: none; }
  /* Same inner width as a normal .band, so the left AND right edges line up
     with every other section. `var(--measure)` alone was 2 × --pad too wide. */
  .decision-band > * { max-width: calc(var(--measure) - var(--pad) * 2); margin-inline: auto; }
  .solo .cs-body { margin-top: clamp(1.2rem, 3vw, 1.8rem); }
  .forks { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.2rem, 3vw, 2.4rem); }
  @media (max-width: 680px) { .forks { grid-template-columns: 1fr; } }
  .fork { padding-left: 1.1rem; }
  .fork.took { border-left: 2.5px solid var(--ink); }
  .fork.left { border-left: 2.5px dashed var(--edge); }
  .fork-k { font-size: .66rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; margin-bottom: .6rem; }
  .fork.took .fork-k { color: var(--ink); }
  .fork.left .fork-k { color: var(--faint); }
  .fork p:last-child { font-family: var(--read); }
  .fork.left p:last-child { color: var(--faint); }
  .cost { margin-top: 1.8rem; padding: 1.4rem 1.6rem; border: 1.5px solid var(--accent); border-radius: 4px; max-width: 64ch; }
  .cost-k { font-size: .66rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase; color: var(--accent); margin-bottom: .6rem; }
  .cost p:last-child { font-family: var(--read); }

  /* ── next: three tiles across the band rather than three stacked rows ── */
  .next { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  @media (max-width: 760px) { .next { grid-template-columns: 1fr; } }
  .next li { background: var(--paper); transition: background var(--quick) var(--ease); }
  .next li:hover { background: #fff; }
  .next a {
    display: flex; flex-direction: column; gap: .35rem; min-height: 9.5rem;
    padding: clamp(1.1rem, 2.6vw, 1.6rem);
  }

  /* The back arrow leans the way it is pointing, not the way everything else does. */
  .crumb a:hover > span, .crumb a:focus-visible > span { transform: translateX(-3px); }

  /* ── at a glance ── */
  .case-facts { max-width: var(--measure); margin: 0 auto; padding: clamp(2rem, 5vw, 3rem) var(--pad) 0; }
  .glance { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 1.2rem; margin: 0 0 clamp(1.4rem, 3vw, 2rem); padding-bottom: clamp(1.2rem, 3vw, 1.6rem); border-bottom: 1px solid var(--line); }
  .glance dt { font-size: var(--micro); font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--faint); }
  .glance dd { font-size: .92rem; margin-top: .2rem; }

  /* Two columns of scope on wide screens: it is a list of facts, not prose,

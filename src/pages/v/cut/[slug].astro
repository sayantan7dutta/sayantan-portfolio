  .wide { margin-top: clamp(2rem, 5vw, 3rem); }
  .wide-frame { overflow: hidden; border-radius: 8px; border: 1px solid var(--line); box-shadow: 0 28px 54px -36px rgba(0,0,0,.45); }
  .wide-frame img { width: 100%; display: block; transition: transform 1.2s var(--ease); }
  /* `wide` means a landscape capture running the width of the measure.
     KinVault put two portrait phone screens in that slot, 760x1958 and

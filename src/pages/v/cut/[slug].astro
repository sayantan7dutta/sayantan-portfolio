    .hero-phones { margin-right: 0; justify-content: space-between; gap: .4rem; }
    .hero-phone { width: auto; flex: 1 1 0; min-width: 0; }
  }

  .crumb .sep { margin: 0 .2rem; }
  /* The discipline tag, sized to match the status chip beside it. */
  .kind-chip, .field-chip {

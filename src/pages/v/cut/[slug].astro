  }

  /* plates */
  .plate { border-radius: 14px; overflow: hidden; border: 1px solid var(--line); background: #fff; box-shadow: 0 24px 46px -32px rgba(0,0,0,.5); transition: box-shadow var(--slow) var(--ease), transform var(--slow) var(--ease); }
  .plate img { width: 100%; display: block; aspect-ratio: 788 / 1778; object-fit: cover; object-position: top center; }
  .plate:hover { transform: translateY(-5px); box-shadow: 0 34px 56px -30px rgba(0,0,0,.55); }
  .dim { filter: saturate(.45) brightness(.9); }
  /* Two equal columns, each a padded card with the phone floated in the
     middle of it at a little over half the width. The air around the screen
     is the point: crowding them makes the comparison feel like evidence
     rather than a before and an after. */
  .ba { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(1.2rem, 3vw, 1.8rem); margin-top: clamp(2rem, 5vw, 3rem); }
  .ba figure { display: flex; flex-direction: column; align-items: center; text-align: center; }
  .ba-tag {
    margin-bottom: .9rem; font-size: var(--micro); font-weight: 700;
    letter-spacing: .12em; text-transform: uppercase;

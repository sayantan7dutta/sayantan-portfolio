---
/**
 * About, in the Director's Cut language.
 *
 * Carries the Annual Report's letter (the piece with the most voice in it),
 * the interview answers that are about the person rather than a project, the
 * capabilities, and the full record of engagements.
 */
import { Image } from 'astro:assets';
import Cut from '../../../layouts/Cut.astro';
import { log, contact } from '../../../lib/variants';
import { interview } from '../../../lib/interview';

import portrait from '../../../assets/sayantan-studio.jpg';
import portraitAlt from '../../../assets/sayantan.jpg';

const capabilities = [
  { k: 'Product design', v: 'End to end, discovery through delivery. Flows, journeys, prototypes, interaction detail.' },
  { k: 'UX strategy', v: 'Turning a vague request into something a small team can build inside a quarter.' },
  { k: 'Design systems', v: 'Component libraries, tokens, and a written accessibility baseline. One system held across three products at Ericsson.' },
  { k: 'Research', v: 'Domain immersion, interviews, synthesis, usability testing, heuristic evaluation.' },
  { k: 'Design operations', v: 'File architecture, shared templates, and a research-to-design handoff a team of twenty actually used.' },
  { k: 'Accessibility', v: 'WCAG AA as a starting constraint rather than a pass at the end.' },
];

/** The answers that are about how I work rather than about one project. */
const DUPLICATES_THE_LETTER = 'What kind of designer are you, in one answer?';
const personal = interview.filter(
  (qa) => qa.a.trim().length > 0 && !qa.link && qa.q !== DUPLICATES_THE_LETTER
);

const tools = ['Figma', 'FigJam', 'Miro', 'Notion', 'Jira', 'Linear', 'Framer', 'Webflow'];
---

<Cut
  title="About, Sayantan Dutta"
  description="Product designer for enterprise SaaS and AI, based in Southampton. Five years across industrial safety, API infrastructure, design operations and a voice-first AI companion."
  navTone="dark"
  active="about"
>

<header class="pagehead">
  <div class="pagehead-in about-top">
    <div class="at-copy">
      <p class="sec-k">About</p>
      <h1>I design the software people are handed, not the software they pick.</h1>
      <p class="lead">
        Five years across industrial safety, enterprise SaaS, design operations and
        AI. Founding designer three times over. Based in {contact.base}, working
        with distributed teams since 2020.
      </p>
      <div class="at-cta">
        <a class="btn btn-on-dark" href={`mailto:${contact.email}`} data-ab="about:email">Get in touch</a>
        <a class="btn btn-ghost-dark" href={contact.resume} data-ab="about:cv">CV (PDF)</a>
      </div>
    </div>
    <figure class="at-photo">
      <Image src={portrait} alt="Sayantan Dutta" widths={[520, 920]} sizes="(max-width: 900px) 70vw, 360px" />
    </figure>
  </div>
</header>

<main id="main">

  <!-- ═══ THE LETTER ════════════════════════════════════════════════ -->
  <section class="band">
    <div class="band-head" data-reveal>
      <p class="sec-k">In my own words</p>
      <h2>Why this work, and not the other kind</h2>
      <p class="sec-lede">
        The short version of how five years in enterprise and industrial
        software changed what I think good design is for.
      </p>
    </div>
    <div class="letter-grid">
    <div class="letter" data-reveal>
      <p>
        Most of what I have worked on, people did not choose. A safety engineer
        running a hazard study, a developer wiring up an API, a woman of
        seventy-five checking whether she has taken her tablets. None of them
        picked the software. It arrived with the job, or with the diagnosis.
      </p>
      <p>
        That changes what good means. Delight is not the measure. The measure is
        whether someone can get through the task on a bad day, at speed, while
        worried, without the interface adding to the problem. It is quieter work
        than consumer design and it takes longer to learn, because you cannot
        design the thing until you understand the job, and the job is usually
        more complicated than the brief admits.
      </p>
      <p>
        Over five years that has taken me from a three-year engagement on
        Ericsson’s API vertical, where I grew from product designer to design
        lead, to being the only designer in a room of three at dAIs Genie. The
        large team taught me that most of a design system is negotiation. The
        small one taught me that if you do not write it down, it does not exist.
      </p>
      <p class="sign">Sayantan Dutta</p>
      <p class="sign-role">Product designer · {contact.base}</p>
    </div>

    <aside class="letter-side" data-reveal style="--d:110ms">
      <figure class="ls-photo">
        <Image src={portraitAlt} alt="Sayantan Dutta" widths={[480, 860]} sizes="(max-width: 900px) 70vw, 320px" />
      </figure>
      <dl class="ls-facts">
        <div><dt>Based</dt><dd>{contact.base}</dd></div>
        <div><dt>Now</dt><dd>Founding product designer, dAIs Genie</dd></div>
        <div><dt>Education</dt><dd>MA Design Management, University of Southampton</dd></div>
        <div><dt>Working remotely since</dt><dd>2020</dd></div>
      </dl>
    </aside>
    </div>
  </section>

  <!-- ═══ Q&A ══════════════════════════════════════════════════════ -->
  {personal.length > 0 && (
    <section class="band band-talk">
      <div class="band-head" data-reveal>
        <p class="sec-k">In conversation</p>
        <h2>How I work</h2>
        <p class="sec-lede">
          The questions that usually come up once the portfolio is out of the way.
        </p>
      </div>
      <ol class="qa">
        {personal.map((qa, i) => (
          <li data-reveal style={`--d:${Math.min(i, 3) * 60}ms`}>
            <p class="q-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="q">{qa.q}</h3>
            <p class="a">{qa.a}</p>
          </li>
        ))}
      </ol>
    </section>
  )}

  <!-- ═══ CAPABILITIES ══════════════════════════════════════════════ -->
  <section class="band">
    <div class="band-head" data-reveal>
      <p class="sec-k">Capabilities</p>
      <h2>What I actually do</h2>
      <p class="sec-lede">
        Six things, each one something I have been accountable for on a shipped
        product rather than a line on a skills list.
      </p>
    </div>
    <dl class="caps" data-reveal>
      {capabilities.map((c) => <div><dt>{c.k}</dt><dd>{c.v}</dd></div>)}
    </dl>
    <p class="tools" data-reveal><span>Tools</span> {tools.join(' · ')}</p>
  </section>

  <!-- ═══ RECORD ════════════════════════════════════════════════════ -->
  <section class="band">
    <div class="band-head" data-reveal>
      <p class="sec-k">Record</p>
      <h2>Where I have been</h2>
      <p class="sec-lede">
        Every role in order, with the basis each one ran on.
      </p>
    </div>
    <table class="record" data-reveal>
      <thead><tr><th scope="col">Period</th><th scope="col">Engagement</th><th scope="col">Basis</th></tr></thead>
      <tbody>
        {log.slice().reverse().map((l) => (
          <tr><td class="rc-when">{l.stamp}</td><td>{l.event}</td><td class="rc-kind">{l.kind}</td></tr>
        ))}
      </tbody>
    </table>
  </section>

  <!-- ═══ CLOSE ═════════════════════════════════════════════════════ -->
  <section class="band about-end">
    <div class="ae-copy" data-reveal>
      <h2>Working on something people have to use?</h2>
      <p class="sec-lede">That is the work I am best at. Tell me what you are weighing up.</p>
    </div>
    <div class="ae-side" data-reveal style="--d:110ms">
      <p class="ae-k">Email</p>
      <p class="ae-mail"><a href={`mailto:${contact.email}`} data-ab="about-end:email">{contact.email}</a></p>
    </div>
  </section>
</main>

<style>
  .about-top {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 360px);
    gap: clamp(1.8rem, 5vw, 4rem); align-items: center;
  }
  @media (max-width: 900px) { .about-top { grid-template-columns: 1fr; } .at-photo { max-width: 300px; } }
  .about-top h1 { margin: .8rem 0 0; }
  .at-cta { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: 1.8rem; }
  .at-photo img { width: 100%; aspect-ratio: 4 / 5; object-fit: cover; object-position: center 18%; border-radius: 4px; }

  /* ── the letter ── */
  .letter-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 320px); gap: clamp(2rem, 6vw, 4.5rem); align-items: start; }
  @media (max-width: 900px) { .letter-grid { grid-template-columns: 1fr; } .letter-side { max-width: 380px; } }
  .letter { max-width: 62ch; }
  .letter p { font-family: var(--read); font-size: clamp(1rem, 2vw, 1.08rem); color: var(--ink-2); }
  .letter p + p { margin-top: 1rem; }
  .letter p:first-child::first-letter {
    float: left; font-family: var(--read); font-size: 3.4em; line-height: .84;
    padding: .06em .09em 0 0; color: var(--accent); font-weight: 600;
  }
  .sign { margin-top: 2rem !important; font-family: var(--display) !important; font-size: 1.3rem; font-weight: 700; letter-spacing: -.02em; color: var(--ink) !important; }
  .sign-role { margin-top: .1rem !important; font-size: .82rem; color: var(--faint) !important; font-family: var(--display) !important; }

  .letter-side { position: sticky; top: calc(var(--nav-h) + 1.5rem); }
  @media (max-width: 900px) { .letter-side { position: static; } }
  .ls-photo img { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; object-position: center 15%; border-radius: 4px; }
  .ls-facts { margin-top: 1.6rem; display: grid; gap: 1rem; padding-top: 1.4rem; border-top: 1px solid var(--line); }
  .ls-facts dt { font-size: .6rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--faint); }
  .ls-facts dd { font-size: .9rem; margin-top: .15rem; }

  /* ── capabilities ── */
  .caps { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); }
  .caps > div { background: var(--paper); padding: clamp(1.1rem, 2.5vw, 1.6rem); transition: background var(--quick) var(--ease); }
  .caps > div:hover { background: #fff; }
  .caps dt { font-weight: 700; margin-bottom: .35rem; }
  .caps dd { font-family: var(--read); color: var(--ink-2); font-size: .95rem; }
  .tools { margin-top: 1.6rem; font-size: .9rem; color: var(--ink-2); }
  .tools span { font-size: .62rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--faint); margin-right: .6rem; }

  /* ── close ── */
  .about-end {
    display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 22rem);
    gap: clamp(2rem, 6vw, 4rem); align-items: end;
  }
  @media (max-width: 860px) { .about-end { grid-template-columns: 1fr; align-items: start; } }
  .about-end h2 { font-size: clamp(1.6rem, 4vw, 2.4rem); max-width: 20ch; }
  .about-end .sec-lede { margin-top: 1rem; }
  .ae-side { padding-top: 1.4rem; border-top: 1px solid var(--line); }
  .ae-k { font-size: .62rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--faint); }
  .ae-mail { margin-top: .6rem; font-size: clamp(1.05rem, 2.4vw, 1.5rem); font-weight: 700; letter-spacing: -.03em; word-break: break-word; }
  .ae-mail a { display: inline-block; padding-block: .35rem; border-bottom: 2.5px solid var(--accent); transition: color var(--quick) var(--ease); }
  .ae-mail a:hover { color: var(--accent); }
</style>
</Cut>

---
/**
 * Variant: DIRECTOR'S CUT
 *
 * The three parts that worked, assembled into one page:
 *   · Reel's opening — cinematic black, the face, the proof, poster type
 *   · the Annual Report's review of the work — numbered, with its metadata
 *     stated plainly rather than implied
 *   · the Interview — as a section, because judgment needs someone talking
 *
 * The join is the point. A cinematic opening and long-form substance want
 * opposite things from a page, so the hero stays black and the body turns to
 * paper, deliberately, the way a title sequence gives way to the article.
 * One type system holds both: Inter Tight for display, Literata for reading.
 */
import Cut from '../../../layouts/Cut.astro';
import { Image } from 'astro:assets';
import { projects, log, contact } from '../../../lib/variants';
import { interview } from '../../../lib/interview';

import portrait from '../../../assets/sayantan-studio.jpg';
import miigenieImg from '../../../assets/work/miigenie/home.png';
import kinvaultImg from '../../../assets/work/kinvault/vault.jpg';
import hazopImg from '../../../assets/work/hazop/analytics-dashboard.jpg';
import ericssonImg from '../../../assets/work/api-lifecycle/hero.png';
import ambleImg from '../../../assets/work/amble/hero.jpg';

const shots: Record<string, { img?: any; figure?: string; tall?: boolean }> = {
  miigenie:           { img: miigenieImg, tall: true },
  kinvault:           { img: kinvaultImg, tall: true },
  hazop:              { img: hazopImg },
  'api-lifecycle':    { img: ericssonImg },
  'sherwin-williams': { figure: '30–40%' },
  amble:              { img: ambleImg },
};

const work = projects.map((p, i) => ({ ...p, ...shots[p.slug], n: String(i + 1).padStart(2, '0') }));
const answered = interview.filter((qa) => qa.a.trim().length > 0);

/** Counted off the status field in variants.ts, not estimated. */
const liveOrShipped = projects.filter((p) => p.status === 'LIVE' || p.status === 'SHIPPED').length;

const proof = [
  { n: '5', l: 'years in practice' },
  { n: '3', l: 'as sole designer' },
  { n: String(liveOrShipped), l: 'shipped or live' },
  { n: '20+', l: 'person team supported' },
];

---

<Cut
  title="Sayantan Dutta — Product Designer"
  description="Product designer for enterprise SaaS and AI. Industrial safety, API infrastructure, design operations, and a voice-first AI companion. Six products, founding designer on three."
  navTone="dark"
  active="work"
>

<!-- ═══ 1 · THE OPENING ════════════════════════════════════════════ -->
<header class="open">
  <figure class="open-bg" aria-hidden="true">
    <Image src={portrait} alt="" widths={[900, 1600]} sizes="100vw" />
  </figure>

  <div class="open-in">
    <p class="supra">Sayantan Dutta · Product designer · {contact.base}</p>
    <h1><span>I design the enterprise software </span><span>people can’t opt out of using.</span></h1>
    <p class="logline">
      Industrial safety, API infrastructure, and a voice-first AI companion.
      Five years, six products, founding designer on three of them.
    </p>

    <ul class="proof">
      {proof.map((p) => <li><b>{p.n}</b><span>{p.l}</span></li>)}
    </ul>

    <div class="open-cta">
      <a class="btn btn-on-dark" href="#work" data-ab="open:work">See the work</a>
      <a class="btn btn-ghost-dark" href={`mailto:${contact.email}`} data-ab="open:email">Get in touch</a>
    </div>
  </div>

  <p class="cue" aria-hidden="true"><span></span>Scroll</p>
</header>

<main id="main">

  <!-- ═══ 2 · THE WORK ═════════════════════════════════════════════ -->
  <section class="band" id="work">
    <div class="band-head" data-reveal>
      <p class="sec-k">The work</p>
      <h2>Six products, reviewed in full</h2>
      <p class="sec-lede">
        Every engagement below, with what it was, who it was for, what my role
        actually covered, and where it got to. No curation — this is all of it.
      </p>
    </div>

    <ol class="work">
      {work.map((w, i) => (
        <li data-reveal style={`--d:${Math.min(i, 2) * 70}ms`}>
          <div class="w-main">
            <div class="w-top">
              <span class="w-n">{w.n}</span>
              <span class={`w-status st-${w.status.toLowerCase()}`}>{w.status}</span>
            </div>
            <h3>{w.title}</h3>

            <dl class="w-meta">
              <div><dt>Client</dt><dd>{w.org}</dd></div>
              <div><dt>Role</dt><dd>{w.role}</dd></div>
              <div><dt>Field</dt><dd>{w.sector}</dd></div>
              <div><dt>Period</dt><dd>{w.period}</dd></div>
            </dl>

            <p class="w-sum">{w.summary}</p>
            <p class="w-note">{w.note}</p>
            <a class="w-go" href={`/v/cut/${w.slug}`} data-ab={`cut:${w.slug}`}>Full case study <span aria-hidden="true">→</span></a>
          </div>

          <div class="w-plate">
            {w.img
              ? (
                <div class={w.tall ? 'frame frame-tall' : 'frame'}>
                  <Image class="shot" src={w.img} alt={`A screen from ${w.short}`} widths={[480, 960]} sizes="(max-width: 900px) 70vw, 380px" loading="lazy" />
                </div>
              )
              : (
                <div class="frame frame-fig">
                  <span>{w.figure}</span>
                  <em>less rework, six products, team of 20+</em>
                </div>
              )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- ═══ 3 · IN CONVERSATION ══════════════════════════════════════ -->
  <section class="band band-talk">
    <div class="band-head" data-reveal>
      <p class="sec-k">In conversation</p>
      <h2>The questions people actually ask</h2>
      <p class="sec-lede">
        A portfolio shows what got made. This is the part that usually only comes
        up in the interview, written down so you can skip ahead.
      </p>
    </div>

    <ol class="qa">
      {answered.map((qa, i) => (
        <li data-reveal style={`--d:${Math.min(i, 3) * 60}ms`}>
          <p class="q-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="q">{qa.q}</h3>
          <p class="a">{qa.a}</p>
          {qa.link && (
            <p class="a-link"><a href={qa.link.href.replace("/work/", "/v/cut/")} data-ab={`cut-qa:${qa.link.href}`}>{qa.link.label} <span aria-hidden="true">→</span></a></p>
          )}
        </li>
      ))}
    </ol>
  </section>

  <!-- ═══ 4 · RECORD ═══════════════════════════════════════════════ -->
  <section class="band">
    <div class="band-head" data-reveal>
      <p class="sec-k">Record</p>
      <h2>Where I have been</h2>
      <p class="sec-lede">
        Every role in order, with the basis each one ran on.
      </p>
    </div>
    <table class="record" data-reveal>
      <thead><tr><th scope="col">Period</th><th scope="col">Engagement</th><th scope="col">Basis</th></tr></thead>
      <tbody>
        {log.slice().reverse().map((l) => (
          <tr><td class="rc-when">{l.stamp}</td><td>{l.event}</td><td class="rc-kind">{l.kind}</td></tr>
        ))}
      </tbody>
    </table>
  </section>

  <!-- ═══ 5 · CONTACT ══════════════════════════════════════════════ -->
  <section class="end">
    <div class="end-in">
      <div class="end-copy" data-reveal>
        <h2>Working on something people have to use, not something they choose to?</h2>
        <p>That is the work I am best at. Tell me what you are weighing up.</p>
      </div>
      <div class="end-side" data-reveal style="--d:110ms">
        <p class="end-k">Email</p>
        <p class="end-mail"><a href={`mailto:${contact.email}`} data-ab="end:email">{contact.email}</a></p>
      </div>
    </div>
  </section>
</main>

<style>
  /* ── 1 · opening ── */
  .open {
    position: relative; min-height: 100svh; display: flex; align-items: flex-end;
    padding: clamp(3rem, 10vw, 7rem) var(--pad) clamp(3.5rem, 8vw, 6rem);
    background: var(--black); color: #f4f4f3; overflow: hidden;
  }
  .open-bg { position: absolute; inset: 0; z-index: 0; }
  .open-bg img { width: 100%; height: 100%; object-fit: cover; object-position: 62% 22%; animation: push 26s ease-out forwards; }
  @keyframes push { from { transform: scale(1.1); } to { transform: scale(1); } }
  .open::after {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      linear-gradient(to top, var(--black) 4%, rgba(10,10,10,.88) 32%, rgba(10,10,10,.42) 68%, rgba(10,10,10,.6) 100%),
      linear-gradient(to right, var(--black) 0%, rgba(10,10,10,.56) 46%, transparent 78%);
  }
  .open-in {
    position: relative; z-index: 2;
    width: 100%; max-width: calc(var(--measure) - var(--pad) * 2); margin-inline: auto;
  }
  .supra { font-size: .74rem; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: #a3a3a0; }
  .open h1 { font-size: clamp(1.9rem, 6.2vw, 4.8rem); font-weight: 800; margin: 1.1rem 0 1.3rem; }
  /* The two lines are a deliberate break on anything wide enough to hold the
     longer of them. Below that they rejoin and wrap on their own, which is
     why the first span keeps its trailing space. */
  .open h1 span { display: block; }
  @media (max-width: 680px) { .open h1 span { display: inline; } }
  .logline { font-size: clamp(1rem, 2.1vw, 1.18rem); color: #a3a3a0; max-width: 44ch; }

  /* The proof row runs the full measure on wide screens, so the numbers read
     as a strip across the foot of the frame rather than a huddle on the left. */
  .proof {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1.4rem 2rem; margin: 2.4rem 0;
    padding-top: 1.6rem; border-top: 1px solid rgba(244,244,243,.18);
    max-width: 52rem;
  }
  .proof li { display: flex; flex-direction: column; }
  .proof b { font-size: clamp(1.5rem, 3.4vw, 2.3rem); font-weight: 700; letter-spacing: -.04em; }
  .proof span { font-size: .78rem; color: var(--dim-dark); }
  .open-cta { display: flex; flex-wrap: wrap; gap: .7rem; }
  .cue {
    position: absolute; z-index: 2; bottom: clamp(3.5rem, 8vw, 6rem);
    /* Sits on the measure's right edge, not the viewport's, so it lines up
       with the content rather than floating off on its own. */
    right: max(var(--pad), calc((100vw - var(--measure)) / 2 + var(--pad)));
    display: flex; align-items: center; gap: .6rem;
    font-size: .68rem; letter-spacing: .2em; text-transform: uppercase; color: var(--dim-dark);
  }
  .cue span { width: 34px; height: 1px; background: var(--dim-dark); transform-origin: left; animation: sweep 2.4s ease-in-out infinite; }
  @keyframes sweep { 0%,100% { transform: scaleX(.35); opacity: .5 } 50% { transform: scaleX(1); opacity: 1 } }
  @media (max-width: 860px) { .cue { display: none; } }

  /* The opening assembles itself once, in reading order. Only ever runs when
     the layout has decided the visitor wants motion. */
  @keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  :global(html.anim) .supra { animation: rise .7s var(--ease) both .06s; }
  :global(html.anim) .open h1 span { animation: rise .85s var(--ease) both; }
  :global(html.anim) .open h1 span:nth-child(1) { animation-delay: .16s; }
  :global(html.anim) .open h1 span:nth-child(2) { animation-delay: .28s; }
  :global(html.anim) .logline { animation: rise .7s var(--ease) both .44s; }
  :global(html.anim) .proof { animation: rise .7s var(--ease) both .56s; }
  :global(html.anim) .open-cta { animation: rise .7s var(--ease) both .66s; }
  :global(html.anim) .cue { animation: rise .7s var(--ease) both .95s; }

  /* ── 2 · work ── */
  .work { display: grid; gap: clamp(2.5rem, 6vw, 4rem); }
  .work li {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 380px);
    gap: clamp(1.6rem, 4vw, 3.5rem); align-items: start;
    padding-top: clamp(2rem, 5vw, 3rem); border-top: 1px solid var(--line);
  }
  .work li:first-child { border-top: 0; padding-top: 0; }
  @media (max-width: 900px) { .work li { grid-template-columns: 1fr; } .w-plate { max-width: 320px; } }

  .w-top { display: flex; align-items: center; gap: .8rem; margin-bottom: .7rem; }
  .w-n { font-size: .82rem; font-weight: 700; color: var(--faint); letter-spacing: .06em; }
  .w-status { font-size: .62rem; font-weight: 700; letter-spacing: .14em; padding: .2rem .5rem; border: 1px solid currentColor; color: var(--faint); border-radius: 2px; }
  .st-live { color: var(--live); }
  .work h3 { font-size: clamp(1.25rem, 3vw, 1.9rem); max-width: 22ch; }

  .w-meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: .9rem; margin: 1.2rem 0; padding: .95rem 0; border-block: 1px solid var(--line); }
  .w-meta dt { font-size: .6rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--faint); }
  .w-meta dd { font-size: .88rem; margin-top: .15rem; }

  .w-sum { font-family: var(--read); color: var(--ink-2); max-width: 58ch; }
  .w-note { font-family: var(--read); margin-top: 1rem; padding-left: 1rem; border-left: 2px solid var(--accent); max-width: 54ch; }
  .w-go {
    display: inline-flex; align-items: center; gap: .4rem; min-height: 44px; margin-top: 1rem;
    font-weight: 600; font-size: .92rem; color: var(--accent);
    border-bottom: 1.5px solid transparent; transition: border-color var(--quick) var(--ease);
  }
  .w-go:hover { border-bottom-color: var(--accent); }

  /* The plate is a fixed frame and the image moves inside it, so the hover
     never nudges the text column or the row below. */
  .frame {
    position: relative; overflow: hidden; aspect-ratio: 4 / 3;
    border-radius: 6px; border: 1px solid var(--line); background: #fff;
    box-shadow: 0 24px 44px -30px rgba(0,0,0,.45);
    transition: box-shadow var(--slow) var(--ease);
  }
  .frame-tall { aspect-ratio: 3 / 4; width: min(290px, 92%); border-radius: 14px; }
  .shot { width: 100%; height: 100%; object-fit: cover; object-position: top center; transition: transform 1.1s var(--ease); }
  .work li:hover .frame, .work li:focus-within .frame { box-shadow: 0 32px 58px -28px rgba(0,0,0,.5); }
  .work li:hover .shot, .work li:focus-within .shot { transform: scale(1.045); }
  .frame-fig {
    display: grid; place-content: center; gap: .6rem; text-align: center; padding: 1.8rem;
    background: var(--accent); color: var(--paper); border-color: var(--accent);
  }
  .frame-fig span { font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 800; letter-spacing: -.04em; }
  .frame-fig em { font-style: normal; font-size: .8rem; opacity: .9; }

  @media (prefers-reduced-motion: reduce) {
    .open-bg img { animation: none; transform: none; }
    .cue span { animation: none; }
    .work li:hover .shot, .work li:focus-within .shot { transform: none; }
  }

  /* ── closing ── */
  .end { background: var(--black); color: #f4f4f3; padding: clamp(4rem, 10vw, 7rem) var(--pad); }
  .end-in {
    max-width: calc(var(--measure) - var(--pad) * 2); margin-inline: auto;
    display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 22rem);
    gap: clamp(2rem, 6vw, 4rem); align-items: end;
  }
  @media (max-width: 860px) { .end-in { grid-template-columns: 1fr; align-items: start; } }
  .end h2 { font-size: clamp(1.8rem, 5vw, 3.2rem); max-width: 24ch; }
  .end-copy p { margin-top: 1rem; color: #a3a3a0; max-width: 48ch; font-family: var(--read); }
  .end-side { padding-top: 1.4rem; border-top: 1px solid rgba(244,244,243,.22); }
  .end-k { font-size: .62rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: var(--dim-dark); }
  .end-mail { margin-top: .6rem; font-size: clamp(1.05rem, 2.4vw, 1.5rem); font-weight: 600; letter-spacing: -.03em; word-break: break-word; }
  /* inline-block + padding so the hit area clears the 24px minimum even
     at the smallest type size this link ever renders at. */
  .end-mail a { display: inline-block; padding-block: .35rem; border-bottom: 2px solid var(--edge-dark); transition: border-color var(--quick) var(--ease); }
  .end-mail a:hover { border-bottom-color: #f4f4f3; }
</style>
</Cut>

---
/**
 * Variant: DIRECTOR'S CUT
 *
 * The three parts that worked, assembled into one page:
 *   · Reel's opening — cinematic black, the face, the proof, poster type
 *   · the Annual Report's review of the work — numbered, with its metadata
 *     stated plainly rather than implied
 *   · the Interview — as a section, because judgment needs someone talking
 *
 * The join is the point. A cinematic opening and long-form substance want
 * opposite things from a page, so the hero stays black and the body turns to
 * paper, deliberately, the way a title sequence gives way to the article.
 * One type system holds both: Inter Tight for display, Literata for reading.
 */
import Cut from '../../../layouts/Cut.astro';
import { Image } from 'astro:assets';
import { projects, log, contact, clients } from '../../../lib/variants';
import { interview } from '../../../lib/interview';

import portrait from '../../../assets/sayantan-studio.jpg';
import miigenieImg from '../../../assets/work/miigenie/home.png';
import kinvaultImg from '../../../assets/work/kinvault/dashboard.jpg';
import hazopImg from '../../../assets/work/hazop/analytics-dashboard.jpg';
import ericssonImg from '../../../assets/work/api-lifecycle/hero.png';
import ambleImg from '../../../assets/work/amble/hero.jpg';

/**
 * One plate per project, in the device the thing was actually designed for.
 * Phone work goes in a phone, desktop work goes in a laptop, photography
 * stays a plain rectangle. Nothing is cropped: every frame takes its height
 * from the image, so a 9:20 app screen and a 16:9 console both arrive whole.
 * Sherwin has no UI to screenshot, so it gets the same stats panel the main
 * site gives it.
 */
type Plate = { img?: any; device: 'phone' | 'laptop' | 'flat' | 'ops'; label?: string; alt?: string };
const shots: Record<string, Plate> = {
  miigenie:           { img: miigenieImg, device: 'phone',  label: 'miiGenie', alt: 'The miiGenie home screen on a phone' },
  kinvault:           { img: kinvaultImg, device: 'phone',  label: 'KinVault', alt: 'The KinVault dashboard on a phone' },
  hazop:              { img: hazopImg,    device: 'laptop', label: 'HAZOP Edge', alt: 'The HAZOP Edge analytics dashboard' },
  'api-lifecycle':    { img: ericssonImg, device: 'laptop', label: 'API Console', alt: 'The Ericsson API Console' },
  'sherwin-williams': { device: 'ops' },
  amble:              { img: ambleImg,    device: 'flat',   alt: 'Amble, a bioengineered plant system in a 2065 home' },
};

const work = projects.map((p, i) => ({ ...p, ...shots[p.slug], n: String(i + 1).padStart(2, '0') }));
const answered = interview.filter((qa) => qa.a.trim().length > 0);

---

<Cut
  title="Sayantan Dutta, Product Designer"
  description="Product designer for enterprise SaaS and AI. Industrial safety, API infrastructure, design operations, and a voice-first AI companion. Six products, founding designer on three."
  navTone="dark"
  active="work"
>

<!-- ═══ 1 · THE OPENING ════════════════════════════════════════════ -->
<header class="open">
  <figure class="open-bg" aria-hidden="true">
    <Image src={portrait} alt="" widths={[900, 1600]} sizes="100vw" />
  </figure>

  <div class="open-in">
    <p class="supra">Sayantan Dutta · Product designer · {contact.base}</p>
    <h1><span>Turning complex </span><span>enterprise systems </span><span>into interfaces.</span></h1>
    <p class="logline">
      Five years across industrial safety, enterprise SaaS, and design
      operations. I work on the high-stakes workflows, the ones where getting
      it wrong isn’t an option.
    </p>

    <div class="open-cta">
      <a class="btn btn-on-dark" href="#work" data-ab="open:work">See the work</a>
      <a class="btn btn-ghost-dark" href={`mailto:${contact.email}`} data-ab="open:email">Get in touch</a>
    </div>
  </div>

  <p class="cue" aria-hidden="true"><span></span>Scroll</p>
</header>

<main id="main">

  <!-- ═══ 2 · THE WORK ═════════════════════════════════════════════ -->
  <section class="band" id="work">
    <div class="band-head" data-reveal>
      <p class="sec-k">The work</p>
      <h2>Six products, reviewed in full</h2>
      <p class="sec-lede">
        All six of them, with who each one was for, what my role actually
        covered, and where it got to. Six is the whole list.
      </p>
    </div>

    <ol class="work">
      {work.map((w, i) => (
        <li data-reveal style={`--d:${Math.min(i, 2) * 70}ms`}>
          <div class="w-main">
            <div class="w-top">
              <span class="w-n">{w.n}</span>
              <span class={`w-status st-${w.status.toLowerCase()}`}>{w.status}</span>
              <span class="w-kind">{w.kind}</span>
              <span class="w-field">{w.field}</span>
            </div>
            <h3>{w.title}</h3>

            <dl class="w-meta">
              <div><dt>Client</dt><dd>{w.org}</dd></div>
              <div><dt>Role</dt><dd>{w.role}</dd></div>
              <div><dt>Period</dt><dd>{w.period}</dd></div>
            </dl>

            <p class="w-sum">{w.summary}</p>
            <p class="w-note">{w.note}</p>
            <a class="w-go" href={`/v/cut/${w.slug}`} data-ab={`cut:${w.slug}`}>Full case study <span aria-hidden="true">→</span></a>
          </div>

          <div class="w-plate">
            {w.device === 'phone' && (
              <div class="phone">
                <div class="phone-screen">
                  <Image class="shot" src={w.img} alt={w.alt} widths={[320, 640]} sizes="212px" loading="lazy" />
                </div>
              </div>
            )}

            {w.device === 'laptop' && (
              <div class="laptop">
                <div class="lt-screen">
                  <div class="lt-bar">
                    <span class="lt-label">{w.label}</span>
                    <span class="lt-dots" aria-hidden="true"><span></span><span></span><span></span></span>
                  </div>
                  <div class="lt-view">
                    <Image class="shot" src={w.img} alt={w.alt} widths={[480, 960]} sizes="(max-width: 900px) 70vw, 400px" loading="lazy" />
                  </div>
                </div>
                <div class="lt-base" aria-hidden="true"></div>
              </div>
            )}

            {w.device === 'flat' && (
              <div class="flat">
                <Image class="shot" src={w.img} alt={w.alt} widths={[480, 960]} sizes="(max-width: 900px) 70vw, 420px" loading="lazy" />
              </div>
            )}

            {w.device === 'ops' && (
              <div class="ops">
                <p class="ops-band">Design Operations · Sherwin-Williams</p>
                <dl class="ops-stats">
                  <div><dt>30 to 40%</dt><dd>less rework</dd></div>
                  <div><dt>20+</dt><dd>people supported</dd></div>
                  <div><dt>6</dt><dd>digital products</dd></div>
                </dl>
                <p class="ops-foot">File architecture, shared research templates, and a five-step handoff.</p>
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
  </section>

  <!-- ═══ 3 · SELECTED CLIENTS ═════════════════════════════════════ -->
  <section class="band band-clients">
    <div class="band-head" data-reveal>
      <p class="sec-k">Selected clients</p>
      <h2>Who the work was for</h2>
      <p class="sec-lede">
        Organisations I have designed for, across enterprise software, industrial
        safety, manufacturing technology and financial inclusion.
      </p>
    </div>
    <!-- The second set is a duplicate for the loop only, so it is hidden from
         screen readers and the whole strip carries one group label. -->
    <div class="marquee" role="group" aria-label="Selected client logos" data-reveal>
      <ul class="mq-track">
        {clients.map((c) => (
          <li><img src={c.logo} alt={c.name} width={c.w} height={c.h} style={`height:${c.h}px`} loading="lazy" /></li>
        ))}
        {clients.map((c) => (
          <li class="mq-dupe" aria-hidden="true"><img src={c.logo} alt="" width={c.w} height={c.h} style={`height:${c.h}px`} loading="lazy" /></li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ═══ 4 · IN CONVERSATION ══════════════════════════════════════ -->
  <section class="band band-talk">
    <div class="band-head" data-reveal>
      <p class="sec-k">In conversation</p>
      <h2>The questions people actually ask</h2>
      <p class="sec-lede">
        A portfolio shows what got made. This is the part that usually only comes
        up in the interview, written down so you can skip ahead.
      </p>
    </div>

    <ol class="qa">
      {answered.map((qa, i) => (
        <li data-reveal style={`--d:${Math.min(i, 3) * 60}ms`}>
          <p class="q-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="q">{qa.q}</h3>
          <p class="a">{qa.a}</p>
          {qa.link && (
            <p class="a-link"><a href={qa.link.href.replace("/work/", "/v/cut/")} data-ab={`cut-qa:${qa.link.href}`}>{qa.link.label} <span aria-hidden="true">→</span></a></p>
          )}
        </li>
      ))}
    </ol>
  </section>

  <!-- ═══ 5 · RECORD ═══════════════════════════════════════════════ -->
  <section class="band">
    <div class="band-head" data-reveal>
      <p class="sec-k">Record</p>
      <h2>Where I have been</h2>
      <p class="sec-lede">
        Every role in order, with the basis each one ran on.
      </p>
    </div>
    <table class="record" data-reveal>
      <thead><tr><th scope="col">Period</th><th scope="col">Role</th><th scope="col">Company</th><th scope="col">Basis</th></tr></thead>
      <tbody>
        {log.slice().reverse().map((l) => (
          <tr>
            <td class="rc-when">{l.stamp}</td>
            <td class="rc-role">{l.role}</td>
            <td class="rc-org">{l.org}</td>
            <td class="rc-kind">{l.kind}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>

  <!-- ═══ 6 · CONTACT ══════════════════════════════════════════════ -->
  <section class="end">
    <div class="end-in">
      <div class="end-copy" data-reveal>
        <h2>Working on something people have to use, not something they choose to?</h2>
        <p>That is the work I am best at. Tell me what you are weighing up.</p>
      </div>
      <div class="end-side" data-reveal style="--d:110ms">
        <p class="end-k">Email</p>
        <p class="end-mail"><a href={`mailto:${contact.email}`} data-ab="end:email">{contact.email}</a></p>
      </div>
    </div>
  </section>
</main>

<style>
  /* ── 1 · opening ── */
  .open {
    position: relative; min-height: 100svh; display: flex; align-items: flex-end;
    padding: clamp(3rem, 10vw, 7rem) var(--pad) clamp(3.5rem, 8vw, 6rem);
    background: var(--black); color: #f4f4f3; overflow: hidden;
  }
  .open-bg { position: absolute; inset: 0; z-index: 0; }
  .open-bg img { width: 100%; height: 100%; object-fit: cover; object-position: 62% 22%; animation: push 26s ease-out forwards; }
  @keyframes push { from { transform: scale(1.1); } to { transform: scale(1); } }
  .open::after {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      linear-gradient(to top, var(--black) 4%, rgba(10,10,10,.88) 32%, rgba(10,10,10,.42) 68%, rgba(10,10,10,.6) 100%),
      linear-gradient(to right, var(--black) 0%, rgba(10,10,10,.56) 46%, transparent 78%);
  }
  .open-in {
    position: relative; z-index: 2;
    width: 100%; max-width: calc(var(--measure) - var(--pad) * 2); margin-inline: auto;
  }
  .supra { font-size: .74rem; font-weight: 600; letter-spacing: .2em; text-transform: uppercase; color: #a3a3a0; }
  .open h1 { font-size: clamp(1.9rem, 6.2vw, 4.8rem); font-weight: 800; margin: 1.1rem 0 1.3rem; }
  /* The two lines are a deliberate break on anything wide enough to hold the
     longer of them. Below that they rejoin and wrap on their own, which is
     why the first span keeps its trailing space. */
  .open h1 span { display: block; }
  @media (max-width: 680px) { .open h1 span { display: inline; } }
  /* 46ch, not the usual 44: at 44 the last line is a single word at desktop
     sizes. `pretty` keeps that true at the widths in between. */
  .logline { font-size: clamp(1rem, 2.1vw, 1.18rem); color: #a3a3a0; max-width: 46ch; text-wrap: pretty; }
  @media (min-width: 900px) { .logline { text-wrap: balance; } }

  /* With the numbers gone the logline carries straight into the buttons, so
     it gets the rule that used to sit above the row and the space it held. */
  .open-cta {
    display: flex; flex-wrap: wrap; gap: .7rem;
    margin-top: 2.2rem; padding-top: 1.8rem;
    border-top: 1px solid rgba(244,244,243,.18); max-width: 52rem;
  }
  .cue {
    position: absolute; z-index: 2; bottom: clamp(3.5rem, 8vw, 6rem);
    /* Sits on the measure's right edge, not the viewport's, so it lines up
       with the content rather than floating off on its own. */
    right: max(var(--pad), calc((100vw - var(--measure)) / 2 + var(--pad)));
    display: flex; align-items: center; gap: .6rem;
    font-size: .68rem; letter-spacing: .2em; text-transform: uppercase; color: var(--dim-dark);
  }
  .cue span { width: 34px; height: 1px; background: var(--dim-dark); transform-origin: left; animation: sweep 2.4s ease-in-out infinite; }
  @keyframes sweep { 0%,100% { transform: scaleX(.35); opacity: .5 } 50% { transform: scaleX(1); opacity: 1 } }
  @media (max-width: 860px) { .cue { display: none; } }

  /* The opening assembles itself once, in reading order. Only ever runs when
     the layout has decided the visitor wants motion. */
  @keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  :global(html.anim) .supra { animation: rise .7s var(--ease) both .06s; }
  :global(html.anim) .open h1 span { animation: rise .85s var(--ease) both; }
  :global(html.anim) .open h1 span:nth-child(1) { animation-delay: .16s; }
  :global(html.anim) .open h1 span:nth-child(2) { animation-delay: .26s; }
  :global(html.anim) .open h1 span:nth-child(3) { animation-delay: .36s; }
  :global(html.anim) .logline { animation: rise .7s var(--ease) both .50s; }
  :global(html.anim) .open-cta { animation: rise .7s var(--ease) both .62s; }
  :global(html.anim) .cue { animation: rise .7s var(--ease) both .88s; }

  /* ── 2 · work ── */
  .work { display: grid; gap: clamp(2.5rem, 6vw, 4rem); }
  .work li {
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 420px);
    gap: clamp(1.6rem, 4vw, 3.5rem); align-items: start;
    padding-top: clamp(2rem, 5vw, 3rem); border-top: 1px solid var(--line);
  }
  .work li:first-child { border-top: 0; padding-top: 0; }
  @media (max-width: 900px) { .work li { grid-template-columns: 1fr; } .w-plate { max-width: 400px; } }

  .w-top { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem .8rem; margin-bottom: .7rem; }
  .w-n { font-size: .82rem; font-weight: 700; color: var(--faint); letter-spacing: .06em; }
  .w-status { font-size: .62rem; font-weight: 700; letter-spacing: .14em; padding: .2rem .5rem; border: 1px solid currentColor; color: var(--faint); border-radius: 2px; }
  .st-live { color: var(--live); }
  /* Two tags, same box: what kind of work it was, then the industry it was
     built for. The industry is the one a reader is scanning for, so it takes
     the accent and the kind sits back in neutral. */
  .w-kind, .w-field {
    font-size: .62rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
    padding: .2rem .5rem; border-radius: 2px;
  }
  .w-kind { background: var(--paper-2); color: var(--ink-2); }
  .w-field { background: rgba(21, 89, 74, .1); color: var(--accent); }
  .work h3 { font-size: clamp(1.25rem, 3vw, 1.9rem); max-width: 22ch; }

  .w-meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(130px, 1fr)); gap: .9rem; margin: 1.2rem 0; padding: .95rem 0; border-block: 1px solid var(--line); }
  .w-meta dt { font-size: .6rem; font-weight: 700; letter-spacing: .15em; text-transform: uppercase; color: var(--faint); }
  .w-meta dd { font-size: .88rem; margin-top: .15rem; }

  .w-sum { font-family: var(--read); color: var(--ink-2); max-width: 58ch; }
  .w-note { font-family: var(--read); margin-top: 1rem; padding-left: 1rem; border-left: 2px solid var(--accent); max-width: 54ch; }
  .w-go {
    display: inline-flex; align-items: center; gap: .4rem; min-height: 44px; margin-top: 1rem;
    font-weight: 600; font-size: .92rem; color: var(--accent);
    border-bottom: 1.5px solid transparent; transition: border-color var(--quick) var(--ease);
  }
  .w-go:hover { border-bottom-color: var(--accent); }

  /* ── the plates ──
     Each device takes its height from the image rather than imposing a ratio
     on it, so nothing is cropped. The outer edge of every plate, phone or
     laptop or photograph, lands on the band's right edge. */
  .phone, .laptop, .flat, .ops {
    box-shadow: 0 24px 44px -30px rgba(0,0,0,.45);
    transition: box-shadow var(--slow) var(--ease), transform var(--slow) var(--ease);
  }
  .work li:hover .phone, .work li:focus-within .phone,
  .work li:hover .laptop, .work li:focus-within .laptop,
  .work li:hover .flat, .work li:focus-within .flat,
  .work li:hover .ops, .work li:focus-within .ops {
    box-shadow: 0 32px 58px -28px rgba(0,0,0,.5);
  }
  /* The image moves inside its own clip, never the frame, so a hover cannot
     nudge the text column or the row below it. */
  .shot { width: 100%; height: auto; display: block; transition: transform 1.1s var(--ease); }
  .work li:hover .shot, .work li:focus-within .shot { transform: scale(1.035); }

  /* Phone: a real device body, flush to the band's right edge. */
  .phone {
    width: min(212px, 62%); margin-left: auto;
    padding: 7px; background: #141310; border-radius: 26px;
  }
  .phone-screen { overflow: hidden; border-radius: 19px; background: #fff; }

  /* Laptop: browser chrome over the screen, base a touch wider than it. */
  .lt-screen {
    margin-inline: 11px; overflow: hidden; background: #fff;
    border: 1px solid var(--line); border-bottom: 0; border-radius: 6px 6px 0 0;
  }
  .lt-bar {
    display: flex; align-items: center; justify-content: space-between; gap: .6rem;
    padding: .42rem .65rem; background: var(--paper-2); border-bottom: 1px solid var(--line);
  }
  .lt-label { font-size: .62rem; font-weight: 700; letter-spacing: .14em; text-transform: uppercase; color: var(--faint); }
  .lt-dots { display: flex; gap: .3rem; }
  .lt-dots span { width: 6px; height: 6px; border-radius: 50%; background: var(--edge); opacity: .55; }
  .lt-view { overflow: hidden; }
  .lt-base {
    height: 11px; background: var(--paper-2);
    border: 1px solid var(--line); border-radius: 2px 2px 11px 11px;
  }
  .lt-base::after {
    content: ''; display: block; width: 56px; height: 3px; margin: 3px auto 0;
    background: var(--line); border-radius: 0 0 3px 3px;
  }

  /* Photography keeps the plain rectangle it already had. */
  .flat { overflow: hidden; border: 1px solid var(--line); border-radius: 6px; background: #fff; }

  /* Design ops has no UI to screenshot, so it gets the stats panel instead,
     in the same brand red the main site uses for it. */
  .ops { background: #0e0c0b; color: #f0ead6; border-radius: 6px; overflow: hidden; }
  .ops-band {
    background: #DA291C; color: #fff; padding: .5rem .9rem;
    font-size: .62rem; font-weight: 700; letter-spacing: .13em; text-transform: uppercase;
  }
  .ops-stats { display: grid; gap: .9rem; padding: 1.3rem .9rem 1rem; }
  .ops-stats > div { display: flex; align-items: baseline; gap: .6rem; padding-bottom: .9rem; border-bottom: 1px solid rgba(240,234,214,.1); }
  .ops-stats > div:last-child { border-bottom: 0; padding-bottom: 0; }
  .ops-stats dt { font-size: clamp(1.3rem, 3vw, 1.75rem); font-weight: 800; letter-spacing: -.04em; color: #F03A26; line-height: 1; }
  .ops-stats dd { font-size: .72rem; letter-spacing: .1em; text-transform: uppercase; color: rgba(240,234,214,.52); }
  .ops-foot { padding: 0 .9rem 1.2rem; font-size: .78rem; line-height: 1.55; color: rgba(240,234,214,.62); }

  @media (max-width: 900px) { .phone { margin-left: 0; width: min(212px, 70%); } }

  /* ── selected clients ── */
  .marquee { position: relative; overflow: hidden; }
  .marquee::before, .marquee::after {
    content: ''; position: absolute; top: 0; bottom: 0; width: clamp(2rem, 6vw, 4.5rem);
    pointer-events: none; z-index: 2;
  }
  .marquee::before { left: 0; background: linear-gradient(90deg, var(--paper), rgba(250,249,246,0)); }
  .marquee::after { right: 0; background: linear-gradient(270deg, var(--paper), rgba(250,249,246,0)); }
  .mq-track {
    display: flex; align-items: center; width: max-content;
    gap: clamp(2.5rem, 5.5vw, 4.5rem); padding-right: clamp(2.5rem, 5.5vw, 4.5rem);
    animation: drift 45s linear infinite;
  }
  .marquee:hover .mq-track { animation-play-state: paused; }
  /* Height comes from the inline style, which outranks the reset's
     `img { height: auto }`; the width/height attributes give the browser the
     ratio, so a logo that is still loading already occupies its final width
     and cannot shunt a strip that is mid-slide. */
  .mq-track img { width: auto; opacity: .88; flex-shrink: 0; transition: opacity var(--quick) var(--ease), transform var(--quick) var(--ease); }
  .mq-track li:hover img { opacity: 1; transform: translateY(-2px); }
  @keyframes drift { from { transform: translateX(0); } to { transform: translateX(-50%); } }

  @media (prefers-reduced-motion: reduce) {
    .open-bg img { animation: none; transform: none; }
    .cue span { animation: none; }
    .work li:hover .shot, .work li:focus-within .shot { transform: none; }
    /* A stopped marquee would leave most of the logos parked off screen, so
       the strip becomes a static wrapped row and the duplicate set goes. */
    .mq-track { animation: none; width: auto; flex-wrap: wrap; justify-content: center; row-gap: 1.8rem; padding-right: 0; }
    .mq-dupe { display: none; }
  }

  /* ── closing ── */
  .end { background: var(--black); color: #f4f4f3; padding: clamp(4rem, 10vw, 7rem) var(--pad); }
  .end-in {
    max-width: calc(var(--measure) - var(--pad) * 2); margin-inline: auto;
    display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 22rem);
    gap: clamp(2rem, 6vw, 4rem); align-items: end;
  }
  @media (max-width: 860px) { .end-in { grid-template-columns: 1fr; align-items: start; } }
  .end h2 { font-size: clamp(1.8rem, 5vw, 3.2rem); max-width: 24ch; }

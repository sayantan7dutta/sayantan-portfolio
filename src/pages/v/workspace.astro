---
/**
 * Variant: WORKSPACE
 *
 * The other half of the SaaS argument. The product page talks about the work;
 * this one *is* the work — an app shell with a sidebar, a projects table, a
 * board view, a detail panel and a command palette.
 *
 * The bet: for a B2B SaaS designer, the most direct evidence is a piece of
 * B2B SaaS the reader can operate. Nobody has to take the craft on faith.
 *
 * Deliberately app-UI vernacular (Linear / Notion / Attio), not a developer
 * console: no terminals, no schematics, no jargon.
 */
import Variant from '../../layouts/Variant.astro';
import { projects, log, contact } from '../../lib/variants';

const groups = [
  { id: 'all', label: 'All work', count: projects.length },
  { id: 'product', label: 'Product', count: projects.filter((p) => /AI Companion|Premium Fintech|B2B SaaS/.test(p.sector)).length },
  { id: 'ops', label: 'Design ops', count: projects.filter((p) => /Design Ops/.test(p.sector)).length },
  { id: 'concept', label: 'Concept', count: projects.filter((p) => p.status === 'CONCEPT' || p.status === 'EXHIBITED').length },
];

function groupOf(p: (typeof projects)[number]) {
  if (/Design Ops/.test(p.sector)) return 'ops';
  if (p.status === 'CONCEPT' || p.status === 'EXHIBITED') return 'concept';
  return 'product';
}

const columns = [
  { key: 'LIVE', label: 'In production' },
  { key: 'SHIPPED', label: 'Delivered' },
  { key: 'CONCEPT', label: 'Concept' },
  { key: 'EXHIBITED', label: 'Exhibited' },
];

const rows = projects.map((p) => ({ ...p, group: groupOf(p), initials: p.org.replace(/[^A-Za-z ]/g, '').split(' ').filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase() }));

const fonts = 'https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap';
---

<Variant
  title="Sayantan Dutta · Workspace"
  description="Product designer for B2B SaaS and AI. A portfolio built as the kind of product it documents."
  variant="workspace"
  fonts={fonts}
  themeColor="#ffffff"
>

<div class="app">

  <!-- ═══ SIDEBAR ═══════════════════════════════════════════════════ -->
  <aside class="side" id="side">
    <div class="ws">
      <span class="avatar" aria-hidden="true">SD</span>
      <span class="ws-meta">
        <span class="ws-name">Sayantan Dutta</span>
        <span class="ws-sub">Product designer · {contact.base}</span>
      </span>
    </div>

    <button class="search" id="search" data-ab="palette:open">
      <span class="mag" aria-hidden="true"></span>
      Search work
      <kbd>⌘K</kbd>
    </button>

    <nav aria-label="Views">
      <p class="side-h">Views</p>
      <ul class="side-nav">
        {groups.map((g, i) => (
          <li>
            <button class="side-link" data-group={g.id} aria-current={i === 0 ? 'true' : 'false'} data-ab={`view:${g.id}`}>
              <span>{g.label}</span>
              <span class="count">{g.count}</span>
            </button>
          </li>
        ))}
      </ul>

      <p class="side-h">More</p>
      <ul class="side-nav">
        <li><a class="side-link" href="#history" data-ab="nav:history"><span>History</span></a></li>
        <li><a class="side-link" href={contact.resume} data-ab="nav:cv"><span>CV</span><span class="ext" aria-hidden="true">↗</span></a></li>
        <li><a class="side-link" href={contact.linkedin} target="_blank" rel="me noopener" data-ab="nav:linkedin"><span>LinkedIn</span><span class="ext" aria-hidden="true">↗</span></a></li>
      </ul>
    </nav>

    <a class="side-cta" href={`mailto:${contact.email}`} data-ab="side:email">
      <span class="dot-live" aria-hidden="true"></span>
      Start a conversation
    </a>
  </aside>

  <!-- ═══ MAIN ══════════════════════════════════════════════════════ -->
  <main id="main" class="main">
    <header class="topbar">
      <button class="ham" id="ham" aria-label="Show views" aria-expanded="false"><span aria-hidden="true"></span></button>
      <p class="crumb"><span>Workspace</span><span class="sep" aria-hidden="true">/</span><strong id="crumb-view">All work</strong></p>
      <div class="seg" role="group" aria-label="Layout">
        <button class="seg-btn" data-layout="table" aria-pressed="true" data-ab="layout:table">Table</button>
        <button class="seg-btn" data-layout="board" aria-pressed="false" data-ab="layout:board">Board</button>
      </div>
    </header>

    <section class="intro">
      <h1>Five years of enterprise SaaS, kept the way I keep a product backlog.</h1>
      <p>
        Industrial hazard studies, API infrastructure, design operations for twenty
        people, and a voice companion older adults use every morning. This page is
        the kind of thing I build — open a row and read the rest.
      </p>
    </section>

    <!-- ── TABLE ── -->
    <div class="view view-table" id="view-table">
      <table>
        <caption class="sr-only">Projects, with client, role, period and status.</caption>
        <thead>
          <tr>
            <th scope="col" class="c-name">Project</th>
            <th scope="col">Client</th>
            <th scope="col">Role</th>
            <th scope="col">Period</th>
            <th scope="col">Status</th>
          </tr>
        </thead>
        <tbody>
          {rows.map((p) => (
            <tr data-group={p.group}>
              <th scope="row" class="c-name">
                <button class="row-open" data-open={p.slug} data-ab={`row:${p.slug}`}>
                  <span class="sq" aria-hidden="true">{p.initials}</span>
                  <span class="row-t">{p.short}</span>
                </button>
              </th>
              <td>{p.org}</td>
              <td class="muted">{p.role}</td>
              <td class="muted nowrap">{p.period}</td>
              <td><span class={`pill pill-${p.status.toLowerCase()}`}>{p.status.toLowerCase()}</span></td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="empty" id="empty" hidden>Nothing in this view.</p>
    </div>

    <!-- ── BOARD ── -->
    <div class="view view-board" id="view-board" hidden>
      {columns.map((col) => (
        <section class="col" aria-label={col.label}>
          <header class="col-h">
            <span class={`pill pill-${col.key.toLowerCase()}`}>{col.label}</span>
            <span class="col-n">{rows.filter((p) => p.status === col.key).length}</span>
          </header>
          {rows.filter((p) => p.status === col.key).map((p) => (
            <article class="tile" data-group={p.group}>
              <button class="tile-open" data-open={p.slug} data-ab={`tile:${p.slug}`}>
                <p class="tile-sector">{p.sector}</p>
                <h3>{p.short}</h3>
                <p class="tile-org">{p.org}</p>
                <p class="tile-foot"><span class="sq sq-sm" aria-hidden="true">{p.initials}</span>{p.period}</p>
              </button>
            </article>
          ))}
        </section>
      ))}
    </div>

    <!-- ── HISTORY ── -->
    <section class="history" id="history">
      <h2>History</h2>
      <ol>
        {log.map((l) => (
          <li>
            <span class="h-dot" aria-hidden="true"></span>
            <span class="h-when">{l.stamp}</span>
            <span class="h-what">{l.event}</span>
            <span class="pill pill-quiet">{l.kind}</span>
          </li>
        ))}
      </ol>
    </section>
  </main>

  <!-- ═══ DETAIL PANEL ══════════════════════════════════════════════ -->
  <aside class="panel" id="panel" hidden aria-labelledby="panel-title">
    <header class="panel-h">
      <span class="pill" id="panel-pill"></span>
      <button class="icon-btn" id="panel-close" aria-label="Close details">✕</button>
    </header>
    <div class="panel-b">
      <h2 id="panel-title"></h2>
      <dl class="panel-dl">
        <div><dt>Client</dt><dd id="panel-org"></dd></div>
        <div><dt>Role</dt><dd id="panel-role"></dd></div>
        <div><dt>Sector</dt><dd id="panel-sector"></dd></div>
        <div><dt>Period</dt><dd id="panel-period"></dd></div>
      </dl>
      <p class="panel-sum" id="panel-sum"></p>
      <p class="panel-note" id="panel-note"></p>
      <a class="panel-go" id="panel-go" href="#">Open full case study <span aria-hidden="true">→</span></a>
    </div>
  </aside>
  <div class="scrim" id="scrim" hidden></div>

  <!-- ═══ COMMAND PALETTE ═══════════════════════════════════════════ -->
  <div class="palette-wrap" id="palette" hidden>
    <div class="palette" role="dialog" aria-modal="true" aria-label="Search">
      <input id="pal-input" type="text" placeholder="Search projects…" autocomplete="off" spellcheck="false" />
      <ul id="pal-list"></ul>
      <footer class="pal-foot"><kbd>↑↓</kbd> move <kbd>↵</kbd> open <kbd>esc</kbd> close</footer>
    </div>
  </div>
</div>

<script define:vars={{ data: projects }}>
  // ── detail panel ───────────────────────────────────────────────────
  const panel = document.getElementById('panel');
  const scrim = document.getElementById('scrim');
  const byslug = Object.fromEntries(data.map((p) => [p.slug, p]));
  let lastTrigger = null;

  function openPanel(slug, trigger) {
    const p = byslug[slug];
    if (!p) return;
    lastTrigger = trigger ?? null;
    document.getElementById('panel-title').textContent = p.title;
    document.getElementById('panel-org').textContent = p.org;
    document.getElementById('panel-role').textContent = p.role;
    document.getElementById('panel-sector').textContent = p.sector;
    document.getElementById('panel-period').textContent = p.period;
    document.getElementById('panel-sum').textContent = p.summary;
    document.getElementById('panel-note').textContent = p.note;
    const go = document.getElementById('panel-go');
    go.setAttribute('href', p.href);
    const pill = document.getElementById('panel-pill');
    pill.textContent = p.status.toLowerCase();
    pill.className = 'pill pill-' + p.status.toLowerCase();
    panel.hidden = false;
    scrim.hidden = false;
    requestAnimationFrame(() => panel.classList.add('open'));
    document.getElementById('panel-close').focus();
  }

  function closePanel() {
    panel.classList.remove('open');
    scrim.hidden = true;
    setTimeout(() => { panel.hidden = true; }, 180);
    lastTrigger?.focus();
  }

  document.addEventListener('click', (e) => {
    const t = e.target.closest?.('[data-open]');
    if (t) openPanel(t.dataset.open, t);
  });
  document.getElementById('panel-close').addEventListener('click', closePanel);
  scrim.addEventListener('click', closePanel);

  // ── table / board ──────────────────────────────────────────────────
  const views = { table: document.getElementById('view-table'), board: document.getElementById('view-board') };
  document.querySelectorAll('.seg-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const which = btn.dataset.layout;
      document.querySelectorAll('.seg-btn').forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
      views.table.hidden = which !== 'table';
      views.board.hidden = which !== 'board';
    });
  });

  // ── filter views ───────────────────────────────────────────────────
  const empty = document.getElementById('empty');
  document.querySelectorAll('.side-link[data-group]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const g = btn.dataset.group;
      document.querySelectorAll('.side-link[data-group]').forEach((b) => b.setAttribute('aria-current', String(b === btn)));
      document.getElementById('crumb-view').textContent = btn.querySelector('span').textContent;
      let shown = 0;
      document.querySelectorAll('[data-group]').forEach((el) => {
        if (el.classList.contains('side-link')) return;
        const on = g === 'all' || el.dataset.group === g;
        el.hidden = !on;
        if (on) shown++;
      });
      empty.hidden = shown > 0;
      document.getElementById('side').classList.remove('open');
    });
  });

  // ── mobile sidebar ─────────────────────────────────────────────────
  const ham = document.getElementById('ham');
  ham.addEventListener('click', () => {
    const open = document.getElementById('side').classList.toggle('open');
    ham.setAttribute('aria-expanded', String(open));
  });

  // ── command palette ────────────────────────────────────────────────
  const pal = document.getElementById('palette');
  const input = document.getElementById('pal-input');
  const list = document.getElementById('pal-list');
  let cursor = 0;
  let hits = [];

  function render(q) {
    const needle = q.trim().toLowerCase();
    hits = data.filter((p) =>
      !needle ||
      (p.short + ' ' + p.org + ' ' + p.sector + ' ' + p.role).toLowerCase().includes(needle)
    );
    cursor = 0;
    list.innerHTML = hits.length
      ? hits.map((p, i) =>
          `<li><button data-i="${i}" class="${i === 0 ? 'on' : ''}"><span>${p.short}</span><small>${p.org}</small></button></li>`
        ).join('')
      : '<li class="no-hit">No matches</li>';
  }

  function openPal() {
    pal.hidden = false;
    input.value = '';
    render('');
    input.focus();
  }
  function closePal() { pal.hidden = true; }

  document.getElementById('search').addEventListener('click', openPal);
  input.addEventListener('input', () => render(input.value));

  list.addEventListener('click', (e) => {
    const b = e.target.closest('button');
    if (b) { closePal(); openPanel(hits[Number(b.dataset.i)].slug); }
  });

  addEventListener('keydown', (e) => {
    const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(e.target.tagName);

    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); openPal(); return; }
    if (e.key === 'Escape') { if (!pal.hidden) closePal(); else if (!panel.hidden) closePanel(); return; }
    if (pal.hidden || !hits.length) { if (typing) return; return; }

    if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
      e.preventDefault();
      cursor = (cursor + (e.key === 'ArrowDown' ? 1 : -1) + hits.length) % hits.length;
      list.querySelectorAll('button').forEach((b, i) => b.classList.toggle('on', i === cursor));
      list.querySelectorAll('button')[cursor]?.scrollIntoView({ block: 'nearest' });
    }
    if (e.key === 'Enter') { e.preventDefault(); closePal(); openPanel(hits[cursor].slug); }
  });

  pal.addEventListener('click', (e) => { if (e.target === pal) closePal(); });
</script>

<style>
  :root {
    --bg: #f7f8f9;
    --surface: #ffffff;
    --line: #e6e8ec;
    --line-2: #d3d7de;
    --ink: #16181d;
    --ink-2: #545b66;
    --faint: #858c97;
    --accent: #4f46e5;
    --accent-wash: #eef0fe;
    --green: #067a55;
    --green-wash: #e6f4ef;
    --amber-wash: #fdf2e3;
    --amber-ink: #8a5410;
    --sans: 'Inter', system-ui, sans-serif;
    --side-w: 264px;
    --r: 8px;
  }

  :global(body) { background: var(--bg); color: var(--ink); font-family: var(--sans); line-height: 1.55; font-size: 14px; }
  :global(.skip-link) { background: var(--accent); color: #fff; }
  :global(:focus-visible) { outline: 2px solid var(--accent); outline-offset: 2px; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .muted { color: var(--ink-2); }
  .nowrap { white-space: nowrap; }
  kbd { font: inherit; font-size: .72em; padding: .1rem .3rem; border: 1px solid var(--line-2); border-bottom-width: 2px; border-radius: 4px; color: var(--faint); background: var(--surface); }

  .app { display: grid; grid-template-columns: var(--side-w) minmax(0, 1fr); min-height: 100vh; }

  /* ── sidebar ── */
  .side {
    position: sticky; top: 0; align-self: start; height: 100vh;
    display: flex; flex-direction: column; gap: 1.2rem;
    padding: 1rem .8rem; background: var(--surface); border-right: 1px solid var(--line);
    overflow-y: auto;
  }
  .ws { display: flex; align-items: center; gap: .6rem; padding: .3rem .35rem; }
  .avatar { width: 32px; height: 32px; border-radius: 7px; display: grid; place-items: center; background: var(--ink); color: #fff; font-size: 11px; font-weight: 700; flex: none; }
  .ws-meta { display: flex; flex-direction: column; min-width: 0; }
  .ws-name { font-weight: 600; font-size: 13.5px; }
  .ws-sub { font-size: 11.5px; color: var(--faint); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

  .search {
    display: flex; align-items: center; gap: .5rem; width: 100%;
    min-height: 36px; padding: .45rem .6rem; border-radius: var(--r);
    border: 1px solid var(--line); background: var(--bg); color: var(--faint); font-size: 13px;
  }
  .search:hover { border-color: var(--line-2); }
  .search kbd { margin-left: auto; }
  .mag { width: 12px; height: 12px; border: 1.6px solid currentColor; border-radius: 50%; position: relative; flex: none; }
  .mag::after { content: ''; position: absolute; right: -4px; bottom: -3px; width: 5px; height: 1.6px; background: currentColor; transform: rotate(45deg); }

  .side-h { font-size: 11px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--faint); padding: 0 .35rem; margin-bottom: .35rem; }
  .side-nav { margin-bottom: 1.2rem; }
  .side-link {
    display: flex; align-items: center; gap: .6rem; width: 100%;
    min-height: 34px; padding: .35rem .55rem; border-radius: 6px;
    font-size: 13.5px; font-weight: 500; color: var(--ink-2); text-align: left;
  }
  .side-link:hover { background: var(--bg); color: var(--ink); }
  .side-link[aria-current='true'] { background: var(--accent-wash); color: var(--accent); font-weight: 600; }
  .count, .ext { margin-left: auto; font-size: 11.5px; color: var(--faint); font-weight: 500; }
  .side-link[aria-current='true'] .count { color: var(--accent); }

  .side-cta {
    margin-top: auto; display: flex; align-items: center; justify-content: center; gap: .5rem;
    min-height: 38px; border-radius: var(--r); background: var(--ink); color: #fff;
    font-weight: 600; font-size: 13px;
  }
  .side-cta:hover { background: #000; }
  .dot-live { width: 7px; height: 7px; border-radius: 50%; background: #4ade80; }

  /* ── topbar ── */
  .main { min-width: 0; }
  .topbar {
    position: sticky; top: 0; z-index: 60;
    display: flex; align-items: center; gap: .9rem;
    padding: .7rem clamp(1rem, 3vw, 2rem);
    background: color-mix(in oklab, var(--bg) 90%, transparent);
    backdrop-filter: blur(8px); border-bottom: 1px solid var(--line);
  }
  .crumb { font-size: 13px; color: var(--faint); display: flex; gap: .45rem; }
  .crumb strong { color: var(--ink); font-weight: 600; }
  .sep { color: var(--line-2); }
  .seg { margin-left: auto; display: flex; gap: 2px; padding: 2px; background: var(--line); border-radius: 7px; }
  .seg-btn { padding: .3rem .75rem; border-radius: 5px; font-size: 12.5px; font-weight: 600; color: var(--ink-2); min-height: 30px; }
  .seg-btn[aria-pressed='true'] { background: var(--surface); color: var(--ink); box-shadow: 0 1px 2px rgba(0,0,0,.08); }
  .ham { display: none; width: 34px; height: 34px; border-radius: 6px; border: 1px solid var(--line); }
  .ham span, .ham span::before, .ham span::after { display: block; width: 14px; height: 1.6px; background: var(--ink); margin: 0 auto; position: relative; }
  .ham span::before, .ham span::after { content: ''; position: absolute; }
  .ham span::before { top: -4.5px; } .ham span::after { top: 4.5px; }

  .intro { padding: clamp(1.8rem, 4vw, 3rem) clamp(1rem, 3vw, 2rem) clamp(1.2rem, 3vw, 2rem); max-width: 820px; }
  .intro h1 { font-size: clamp(1.35rem, 3vw, 1.95rem); font-weight: 700; letter-spacing: -.03em; line-height: 1.16; }
  .intro p { margin-top: .8rem; color: var(--ink-2); font-size: 14.5px; max-width: 62ch; }

  /* ── table ── */
  .view-table { padding: 0 clamp(1rem, 3vw, 2rem) 2.5rem; overflow-x: auto; }
  .view-table table { width: 100%; border-collapse: collapse; min-width: 720px; background: var(--surface); border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }
  .view-table th, .view-table td { text-align: left; padding: .1rem .9rem; border-bottom: 1px solid var(--line); font-weight: 400; }
  .view-table thead th { padding: .6rem .9rem; font-size: 11.5px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--faint); background: #fbfcfd; }
  .view-table tbody tr:last-child th, .view-table tbody tr:last-child td { border-bottom: 0; }
  .view-table tbody tr:hover { background: #fbfcfd; }
  .c-name { min-width: 300px; }
  .row-open { display: flex; align-items: center; gap: .65rem; width: 100%; padding: .7rem 0; text-align: left; min-height: 44px; }
  .row-t { font-weight: 600; font-size: 13.5px; }
  .row-open:hover .row-t { color: var(--accent); }
  .sq { width: 24px; height: 24px; border-radius: 5px; display: grid; place-items: center; background: var(--accent-wash); color: var(--accent); font-size: 10px; font-weight: 700; flex: none; }
  .sq-sm { width: 18px; height: 18px; font-size: 8.5px; }
  .view-table td { font-size: 13px; padding-block: .7rem; }

  .pill { display: inline-block; padding: .15rem .5rem; border-radius: 20px; font-size: 11.5px; font-weight: 600; background: #eef0f3; color: var(--ink-2); }
  .pill-live { background: var(--green-wash); color: var(--green); }
  .pill-shipped { background: var(--accent-wash); color: var(--accent); }
  .pill-concept, .pill-exhibited { background: var(--amber-wash); color: var(--amber-ink); }
  .pill-quiet { background: transparent; color: var(--faint); border: 1px solid var(--line); }
  .empty { padding: 2.5rem; text-align: center; color: var(--faint); }

  /* ── board ── */
  .view-board { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(240px, 1fr); gap: 1rem; padding: 0 clamp(1rem, 3vw, 2rem) 2.5rem; overflow-x: auto; align-items: start; }
  .col { background: #f1f3f5; border-radius: 10px; padding: .7rem; }
  .col-h { display: flex; align-items: center; justify-content: space-between; margin-bottom: .7rem; }
  .col-n { font-size: 11.5px; color: var(--faint); font-weight: 600; }
  .tile { background: var(--surface); border: 1px solid var(--line); border-radius: 8px; margin-bottom: .55rem; }
  .tile:hover { border-color: var(--line-2); }
  .tile-open { display: block; width: 100%; text-align: left; padding: .75rem .8rem; }
  .tile-sector { font-size: 11px; color: var(--faint); font-weight: 500; }
  .tile h3 { font-size: 13.5px; font-weight: 600; letter-spacing: -.01em; margin: .3rem 0 .25rem; }
  .tile-open:hover h3 { color: var(--accent); }

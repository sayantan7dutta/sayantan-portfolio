---
/**
 * Variant: DRAWING SET
 *
 * The bet: before software, high-consequence systems were drawn — sheets,
 * title blocks, revisions, and someone's handwriting in the margin arguing
 * with the drawing. Presenting the work that way makes the rigour visible
 * and puts a person back in the margins, which is the thing a card grid
 * sands off first.
 *
 * The REDLINE toggle is the signature control: it lifts the markup layer
 * off the drawing, exactly the way a reviewer would.
 */
import Variant from '../../layouts/Variant.astro';
import { Image } from 'astro:assets';
import { projects, log, contact } from '../../lib/variants';

import miigenieImg from '../../assets/work/miigenie/home.png';
import kinvaultImg from '../../assets/work/kinvault/vault.jpg';
import hazopImg from '../../assets/work/hazop/risk-matrix.jpg';
import ericssonImg from '../../assets/work/api-lifecycle/hero.png';
import ambleImg from '../../assets/work/amble/hero.jpg';

// Phone screenshots are ~1:2.3 — shown full column width they swamp the sheet,
// so they are drawn small and centred, the way a device plate would be.
const plates: Record<string, { img?: any; figure?: string; caption: string; skew: number; portrait?: boolean }> = {
  miigenie:           { img: miigenieImg, caption: 'miiGenie · home, voice-first',        skew: -1.4, portrait: true },
  kinvault:           { img: kinvaultImg, caption: 'KinVault · shared family vault',      skew: 1.1, portrait: true },
  hazop:              { img: hazopImg,    caption: 'HAZOP Edge · risk matrix',            skew: -0.9 },
  'api-lifecycle':    { img: ericssonImg, caption: 'Ericsson · API Console',              skew: 1.5 },
  'sherwin-williams': { figure: '30–40%', caption: 'less rework · 20+ person team',       skew: -1.2 },
  amble:              { img: ambleImg,    caption: 'Amble · the 2065 home',               skew: 1.0 },
};

const sheets = projects.map((p, i) => ({ ...p, ...plates[p.slug], n: i + 2 }));
const TOTAL = projects.length + 3; // cover + projects + notes + RFI

const notes = [
  'Five years in practice. Three of them on one B2B vertical at Ericsson, which is where I learned that a design system is a political document before it is a technical one.',
  'MA Design Management, University of Southampton, 2024–25.',
  'Currently the founding and only designer at dAIs Genie, on miiGenie. Three people. No design department to hide behind, and no one to blame for the type scale.',
  'I work in domains where being wrong is expensive: hazard studies, API infrastructure, care for people who are not in a position to file a bug report.',
  'Accessibility is not a phase near the end. On this set it is a constraint on sheet one, the same as a load case.',
  `Based in ${contact.base}.`,
];

const fonts =
  'https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@400;500&family=Caveat:wght@500;600&family=Instrument+Sans:wght@400;500;600;700&display=swap';

const REV = 'C';
const DATE = '2026-09';
---

<Variant
  title="Sayantan Dutta · Drawing Set"
  description="Product designer working on high-stakes enterprise and AI workflows. Portfolio issued as a drawing set, with the markup left on."
  variant="drawing-set"
  fonts={fonts}
  themeColor="#22262a"
>

<!-- rough-edge filter, used to make CSS boxes look drawn by hand -->
<svg class="defs" aria-hidden="true" focusable="false">
  <filter id="rough">
    <feTurbulence type="fractalNoise" baseFrequency="0.02" numOctaves="3" seed="7" result="n" />
    <feDisplacementMap in="SourceGraphic" in2="n" scale="4" xChannelSelector="R" yChannelSelector="G" />
  </filter>
</svg>

<!-- ── Markup layer control ─────────────────────────────────────────── -->
<div class="control">
  <button id="redline" class="ctl-btn" aria-pressed="true">
    <span class="swatch" aria-hidden="true"></span>
    Redline<span class="ctl-word">&nbsp;layer</span>
    <span class="state" aria-hidden="true">ON</span>
  </button>
</div>

<main id="main">

  <!-- ══ SHEET 01 — COVER ══════════════════════════════════════════ -->
  <section class="sheet cover" aria-labelledby="cover-h">
    <span class="reg tl" aria-hidden="true"></span><span class="reg tr" aria-hidden="true"></span>
    <span class="reg bl" aria-hidden="true"></span><span class="reg br" aria-hidden="true"></span>

    <div class="sheet-body">
      <p class="stamp-line">ISSUED FOR REVIEW</p>
      <h1 id="cover-h">
        <span class="h-sm">Drawing set</span>
        Sayantan Dutta
        <span class="h-sm h-sub">Product designer · enterprise &amp; AI</span>
      </h1>

      <p class="cover-lead">
        Six projects, drawn up. Industrial hazard studies, enterprise API infrastructure,
        design operations for a twenty-person team, and a voice companion older adults
        use every morning. The high-consequence end of the trade.
      </p>

      <p class="marginal redline" data-rl>
        I left the markup on. It is the honest part.
      </p>

      <h2 class="idx-h">Drawing index</h2>
      <ol class="idx">
        {sheets.map((s) => (
          <li>
            <a href={`#sheet-${s.slug}`} data-ab={`index:${s.slug}`}>
              <span class="idx-n">{String(s.n).padStart(2, '0')}</span>
              <span class="idx-t">{s.short}</span>
              <span class="idx-dots" aria-hidden="true"></span>
              <span class="idx-meta">{s.period}</span>
            </a>
          </li>
        ))}
        <li>
          <a href="#sheet-notes" data-ab="index:notes">
            <span class="idx-n">{String(TOTAL - 1).padStart(2, '0')}</span>
            <span class="idx-t">General notes</span>
            <span class="idx-dots" aria-hidden="true"></span>
            <span class="idx-meta">About</span>
          </a>
        </li>
        <li>
          <a href="#sheet-rfi" data-ab="index:rfi">
            <span class="idx-n">{String(TOTAL).padStart(2, '0')}</span>
            <span class="idx-t">Request for information</span>
            <span class="idx-dots" aria-hidden="true"></span>
            <span class="idx-meta">Contact</span>
          </a>
        </li>
      </ol>
    </div>

    <table class="tblock">
      <tbody>
        <tr><th scope="row">Drawn</th><td>S. Dutta</td><th scope="row">Sheet</th><td>01 / {TOTAL}</td></tr>
        <tr><th scope="row">Scale</th><td>1:1</td><th scope="row">Rev</th><td>{REV}</td></tr>
        <tr><th scope="row">Date</th><td>{DATE}</td><th scope="row">Status</th><td class="hot">FOR REVIEW</td></tr>
      </tbody>
    </table>
  </section>

  <!-- ══ PROJECT SHEETS ════════════════════════════════════════════ -->
  {sheets.map((s) => (
    <section class="sheet" id={`sheet-${s.slug}`} aria-labelledby={`h-${s.slug}`}>
      <span class="reg tl" aria-hidden="true"></span><span class="reg tr" aria-hidden="true"></span>
      <span class="reg bl" aria-hidden="true"></span><span class="reg br" aria-hidden="true"></span>

      <div class="sheet-body sheet-grid">
        <div class="s-head">
          <p class="s-tag">{s.tag} · {s.sector}</p>
          <h2 id={`h-${s.slug}`}>{s.title}</h2>
          <p class="s-org">{s.org} <span class="sep" aria-hidden="true">/</span> {s.role}</p>
        </div>

        <div class="s-plate">
          <figure class={`plate${s.portrait ? ' portrait' : ''}`} style={`--skew:${s.skew}deg`}>
            <span class="tape tape-l" aria-hidden="true"></span>
            <span class="tape tape-r" aria-hidden="true"></span>
            {s.img
              ? <Image src={s.img} alt={s.caption} widths={[480, 900]} sizes="(max-width: 900px) 90vw, 560px" loading="lazy" />
              : <div class="plate-figure"><span class="fig">{s.figure}</span></div>}
            <figcaption>{s.caption}</figcaption>
          </figure>

          <p class="marginal redline plate-note" data-rl>{s.note}</p>
        </div>

        <div class="s-text">
          <p class="s-summary">{s.summary}</p>

          <div class="dim-line" aria-hidden="true">
            <span class="dim-tick"></span>
            <span class="dim-rule"></span>
            <span class="dim-val">{s.period}</span>
            <span class="dim-rule"></span>
            <span class="dim-tick"></span>
          </div>
          <p class="sr-only">Engagement period: {s.period}.</p>

          <a class="drawn-btn" href={s.href} data-ab={`sheet:${s.slug}`}>
            Open case study <span aria-hidden="true">→</span>
          </a>
        </div>
      </div>

      <table class="tblock">
        <tbody>
          <tr><th scope="row">Drawn</th><td>S. Dutta</td><th scope="row">Sheet</th><td>{String(s.n).padStart(2, '0')} / {TOTAL}</td></tr>
          <tr><th scope="row">Project</th><td class="ell">{s.short}</td><th scope="row">Rev</th><td>{REV}</td></tr>
          <tr><th scope="row">Date</th><td>{s.period}</td><th scope="row">Status</th><td class="hot">{s.status}</td></tr>
        </tbody>
      </table>
    </section>
  ))}

  <!-- ══ GENERAL NOTES ═════════════════════════════════════════════ -->
  <section class="sheet" id="sheet-notes" aria-labelledby="h-notes">
    <span class="reg tl" aria-hidden="true"></span><span class="reg tr" aria-hidden="true"></span>
    <span class="reg bl" aria-hidden="true"></span><span class="reg br" aria-hidden="true"></span>

    <div class="sheet-body">
      <p class="s-tag">GEN-001 · ABOUT</p>
      <h2 id="h-notes">General notes</h2>

      <ol class="notes">
        {notes.map((n, i) => (
          <li><span class="note-n">{String(i + 1).padStart(2, '0')}</span><span>{n}</span></li>
        ))}
      </ol>

      <h3 class="rev-h">Revision history</h3>
      <table class="revs">
        <caption class="sr-only">Career history, oldest first.</caption>
        <thead><tr><th scope="col">Rev</th><th scope="col">Date</th><th scope="col">Description</th><th scope="col">Type</th></tr></thead>
        <tbody>
          {log.map((l, i) => (
            <tr>
              <td class="mono">{String.fromCharCode(65 + i)}</td>
              <td class="mono nowrap">{l.stamp}</td>
              <td>{l.event}</td>
              <td class="mono small">{l.kind}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <table class="tblock">
      <tbody>
        <tr><th scope="row">Drawn</th><td>S. Dutta</td><th scope="row">Sheet</th><td>{String(TOTAL - 1).padStart(2, '0')} / {TOTAL}</td></tr>
        <tr><th scope="row">Scale</th><td>NTS</td><th scope="row">Rev</th><td>{REV}</td></tr>
        <tr><th scope="row">Date</th><td>{DATE}</td><th scope="row">Status</th><td class="hot">CURRENT</td></tr>
      </tbody>
    </table>
  </section>

  <!-- ══ RFI / CONTACT ═════════════════════════════════════════════ -->
  <section class="sheet" id="sheet-rfi" aria-labelledby="h-rfi">
    <span class="reg tl" aria-hidden="true"></span><span class="reg tr" aria-hidden="true"></span>
    <span class="reg bl" aria-hidden="true"></span><span class="reg br" aria-hidden="true"></span>

    <div class="sheet-body rfi">
      <p class="s-tag">RFI-001 · CONTACT</p>
      <h2 id="h-rfi">Request for information</h2>
      <p class="rfi-lead">
        If you have a workflow people dread using, send it over. I read everything,
        and I will tell you honestly whether I am the right person for it.
      </p>

      <dl class="rfi-dl">
        <div><dt>Email</dt><dd><a href={`mailto:${contact.email}`} data-ab="contact:email">{contact.email}</a></dd></div>
        <div><dt>LinkedIn</dt><dd><a href={contact.linkedin} target="_blank" rel="me noopener" data-ab="contact:linkedin">in/sayantan7dutta ↗</a></dd></div>
        <div><dt>CV</dt><dd><a href={contact.resume} data-ab="contact:cv">resume.pdf</a></dd></div>
        <div><dt>Based</dt><dd>{contact.base}</dd></div>
      </dl>

      <p class="marginal redline rfi-note" data-rl>Reply within a couple of days, usually.</p>
    </div>

    <table class="tblock">
      <tbody>
        <tr><th scope="row">Drawn</th><td>S. Dutta</td><th scope="row">Sheet</th><td>{String(TOTAL).padStart(2, '0')} / {TOTAL}</td></tr>
        <tr><th scope="row">Scale</th><td>NTS</td><th scope="row">Rev</th><td>{REV}</td></tr>
        <tr><th scope="row">Date</th><td>{DATE}</td><th scope="row">Status</th><td class="hot">END OF SET</td></tr>
      </tbody>
    </table>
  </section>
</main>

<script>
  // The markup layer comes off the drawing the way a reviewer would lift it.
  const btn = document.getElementById('redline') as HTMLButtonElement | null;
  const root = document.documentElement;

  const saved = localStorage.getItem('ds.redline');
  const start = saved === null ? true : saved === '1';
  apply(start);

  function apply(on: boolean) {
    root.classList.toggle('no-redline', !on);
    if (btn) {
      btn.setAttribute('aria-pressed', String(on));
      const state = btn.querySelector('.state');
      if (state) state.textContent = on ? 'ON' : 'OFF';
    }
  }

  btn?.addEventListener('click', () => {
    const on = btn.getAttribute('aria-pressed') !== 'true';
    apply(on);
    localStorage.setItem('ds.redline', on ? '1' : '0');
  });
</script>

<style>
  :root {
    --board: #24282c;
    --paper: #f6f2e8;
    --ink: #1b2430;
    --ink-2: #4a5563;
    --blue: #2f4f7a;
    --red: #c2412f;
    --pencil: #8a8477;
    --rule: #c9c2b1;
    --mono: 'Azeret Mono', ui-monospace, Menlo, monospace;
    --sans: 'Instrument Sans', system-ui, sans-serif;
    --hand: 'Caveat', 'Bradley Hand', cursive;
  }

  :global(body) {
    background: var(--board);
    background-image: radial-gradient(circle at 22% 12%, #2c3136 0%, #1d2125 70%);
    color: var(--ink);
    font-family: var(--sans);
    line-height: 1.6;
    padding: clamp(1rem, 3vw, 2.5rem) clamp(.6rem, 3vw, 2rem) 4rem;
  }
  :global(.skip-link) { background: var(--red); color: #fff; }
  :global(:focus-visible) { outline: 2px solid var(--red); outline-offset: 3px; }
  :global(html.no-redline) [data-rl] { opacity: 0; pointer-events: none; }

  .defs { position: absolute; width: 0; height: 0; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .mono { font-family: var(--mono); }
  .small { font-size: .72rem; }
  .nowrap { white-space: nowrap; }

  /* ── markup control ── */
  .control { position: fixed; top: clamp(.6rem, 2vw, 1.2rem); right: clamp(.6rem, 2vw, 1.2rem); z-index: 500; }
  .ctl-btn {
    display: inline-flex; align-items: center; gap: .55rem;
    min-height: 44px; padding: .5rem .9rem;
    background: var(--paper); color: var(--ink);
    border: 1.5px solid var(--ink);
    font-family: var(--mono); font-size: .68rem;
    letter-spacing: .1em; text-transform: uppercase;
    box-shadow: 3px 3px 0 rgba(0,0,0,.35);
  }
  .ctl-btn:active { transform: translate(1px, 1px); box-shadow: 2px 2px 0 rgba(0,0,0,.35); }
  .swatch { width: 10px; height: 10px; border-radius: 50%; background: var(--red); }
  .ctl-btn[aria-pressed='false'] .swatch { background: transparent; border: 1.5px solid var(--pencil); }
  .state { padding-left: .35rem; border-left: 1px solid var(--rule); color: var(--ink-2); }
  @media (max-width: 560px) {
    .ctl-btn { font-size: .6rem; padding: .5rem .6rem; gap: .4rem; }
    .ctl-word { display: none; }
  }

  /* ── the sheet ── */
  .sheet {
    position: relative;
    max-width: 1060px; margin: 0 auto clamp(1.4rem, 3vw, 2.6rem);
    background: var(--paper);
    /* 5 mm drafting grid, barely there */
    background-image:
      linear-gradient(rgba(47,79,122,.07) 1px, transparent 1px),
      linear-gradient(90deg, rgba(47,79,122,.07) 1px, transparent 1px);
    background-size: 22px 22px;
    box-shadow: 0 18px 40px -20px rgba(0,0,0,.75), 0 2px 0 rgba(0,0,0,.25);
    padding: clamp(1.6rem, 4vw, 3rem);
  }
  /* the drawn border frame */
  .sheet::before {
    content: ''; position: absolute; inset: 10px;
    border: 1.5px solid var(--ink); pointer-events: none;
  }
  .sheet::after {
    content: ''; position: absolute; inset: 16px;
    border: 1px solid var(--rule); pointer-events: none;
  }
  .sheet-body { position: relative; z-index: 1; padding: clamp(.8rem, 2vw, 1.6rem) clamp(.4rem, 1.5vw, 1.2rem) 0; }

  /* corner registration marks */
  .reg { position: absolute; width: 16px; height: 16px; pointer-events: none; }
  .reg::before, .reg::after { content: ''; position: absolute; background: var(--ink); }
  .reg::before { left: 50%; top: 0; width: 1px; height: 100%; }
  .reg::after { top: 50%; left: 0; height: 1px; width: 100%; }
  .reg.tl { left: 2px; top: 2px; } .reg.tr { right: 2px; top: 2px; }
  .reg.bl { left: 2px; bottom: 2px; } .reg.br { right: 2px; bottom: 2px; }

  /* ── title block ── */
  .tblock {
    position: relative; z-index: 1;
    margin: clamp(1.6rem, 4vw, 2.6rem) 0 0 auto;
    border-collapse: collapse; font-family: var(--mono); font-size: .62rem;
    width: min(100%, 460px);
  }
  .tblock th, .tblock td { border: 1px solid var(--ink); padding: .32rem .5rem; text-align: left; }
  .tblock th {
    font-weight: 400; letter-spacing: .1em; text-transform: uppercase;
    color: var(--ink-2); background: rgba(27,36,48,.045); width: 4.6rem;
  }
  .tblock .hot { color: var(--red); }
  .tblock .ell { max-width: 12rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* ── cover ── */
  .stamp-line {
    display: inline-block; font-family: var(--mono); font-size: .68rem;
    letter-spacing: .28em; text-transform: uppercase; color: var(--red);
    border: 1.5px solid var(--red); padding: .3rem .7rem;
    transform: rotate(-1.6deg); margin-bottom: 1.6rem;
  }
  .cover h1 {
    font-size: clamp(2.6rem, 9vw, 6rem); font-weight: 700;
    line-height: .95; letter-spacing: -.035em; margin-bottom: 1.4rem;
  }
  .h-sm {
    display: block; font-family: var(--mono); font-size: clamp(.66rem, 1.4vw, .78rem);
    font-weight: 400; letter-spacing: .22em; text-transform: uppercase;
    color: var(--ink-2); margin-bottom: .7rem;
  }
  .h-sub { margin: .9rem 0 0; color: var(--blue); }
  .cover-lead { max-width: 54ch; font-size: clamp(1rem, 2vw, 1.12rem); color: var(--ink-2); }

  .idx-h {
    margin: clamp(2.4rem, 6vw, 4rem) 0 .9rem;
    font-family: var(--mono); font-size: .7rem; font-weight: 400;
    letter-spacing: .22em; text-transform: uppercase; color: var(--ink-2);
    border-bottom: 1.5px solid var(--ink); padding-bottom: .5rem;
  }
  .idx li { border-bottom: 1px solid var(--rule); }
  .idx a {
    display: grid; grid-template-columns: 2.6rem auto 1fr auto;
    gap: .7rem; align-items: baseline;
    padding: .8rem .2rem; min-height: 44px;
  }
  .idx a:hover { background: rgba(47,79,122,.06); }
  .idx a:hover .idx-t { color: var(--red); }
  .idx-n { font-family: var(--mono); font-size: .72rem; color: var(--ink-2); }
  .idx-t { font-weight: 600; font-size: clamp(.98rem, 2vw, 1.14rem); }
  .idx-dots { border-bottom: 1px dotted var(--pencil); transform: translateY(-.25rem); }
  .idx-meta { font-family: var(--mono); font-size: .68rem; color: var(--ink-2); white-space: nowrap; }
  @media (max-width: 620px) {
    .idx a { grid-template-columns: 2.2rem 1fr; }
    .idx-dots { display: none; }
    .idx-meta { grid-column: 2; }
  }

  /* ── redline marginalia ── */
  .marginal {
    font-family: var(--hand); font-size: clamp(1.05rem, 2.2vw, 1.35rem);
    line-height: 1.3; color: var(--red);
    transition: opacity .35s ease;
  }
  .marginal.redline { position: relative; padding-left: 1.5rem; }
  .marginal.redline::before {
    content: ''; position: absolute; left: 0; top: .55em;
    width: 1rem; height: 1px; background: var(--red);
  }
  .cover .marginal { margin-top: 1.6rem; transform: rotate(-.8deg); }

  /* ── project sheet layout ── */
  .sheet-grid { display: grid; grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: clamp(1.4rem, 4vw, 3rem) clamp(1.6rem, 4vw, 3.4rem); }
  .s-head { grid-column: 1 / -1; border-bottom: 1.5px solid var(--ink); padding-bottom: 1rem; }
  .s-tag { font-family: var(--mono); font-size: .66rem; letter-spacing: .2em; text-transform: uppercase; color: var(--blue); }
  .s-head h2 { font-size: clamp(1.45rem, 3.4vw, 2.3rem); font-weight: 700; letter-spacing: -.025em; line-height: 1.1; margin: .55rem 0 .6rem; max-width: 22ch; }
  .s-org { font-family: var(--mono); font-size: .74rem; color: var(--ink-2); }
  .s-org .sep { color: var(--rule); padding: 0 .3rem; }
  @media (max-width: 860px) { .sheet-grid { grid-template-columns: 1fr; } }

  /* taped plate */
  .plate { position: relative; transform: rotate(var(--skew)); }
  .plate.portrait { width: min(280px, 78%); margin-inline: auto; }
  .plate.portrait img { max-height: 540px; object-fit: cover; object-position: top center; }
  .plate img, .plate-figure {
    width: 100%; border: 1px solid var(--ink);
    box-shadow: 0 10px 22px -14px rgba(0,0,0,.7);
    background: #fff;
  }
  .plate-figure { display: grid; place-items: center; aspect-ratio: 4 / 3; background: var(--blue); }
  .plate-figure .fig { font-size: clamp(2.4rem, 7vw, 4rem); font-weight: 700; letter-spacing: -.03em; color: var(--paper); }
  .plate figcaption { margin-top: .6rem; font-family: var(--mono); font-size: .64rem; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-2); }
  .tape {
    position: absolute; top: -12px; width: 76px; height: 24px; z-index: 2;
    background: rgba(214, 203, 168, .62);
    border-left: 1px solid rgba(160,150,120,.35); border-right: 1px solid rgba(160,150,120,.35);
    box-shadow: 0 1px 3px rgba(0,0,0,.16);
  }
  .tape-l { left: 6%; transform: rotate(-4deg); }
  .tape-r { right: 6%; transform: rotate(3.5deg); }
  .plate-note { margin-top: 1.1rem; max-width: 34ch; }

  /* text column */

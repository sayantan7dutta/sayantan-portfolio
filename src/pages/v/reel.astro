---
/**
 * Variant: REEL
 *
 * The cinematic one. Black ground, product lit on it, type at poster scale,
 * and the career running out as end credits.
 *
 * Grounded in the hiring research rather than decoration: a reviewer gives a
 * homepage 10 to 15 seconds, so the first screen carries the face, the
 * positioning and the proof with nothing to scroll past first. Every chapter
 * leads with whether the thing shipped, because "is it live?" is the
 * screening question.
 */
import Variant from '../../layouts/Variant.astro';
import { Image } from 'astro:assets';
import { projects, log, contact } from '../../lib/variants';

import portrait from '../../assets/sayantan-studio.jpg';
import miigenieImg from '../../assets/work/miigenie/home.png';
import kinvaultImg from '../../assets/work/kinvault/dashboard.jpg';
import hazopImg from '../../assets/work/hazop/analytics-dashboard.jpg';
import ericssonImg from '../../assets/work/api-lifecycle/hero.png';
import ambleImg from '../../assets/work/amble/hero.jpg';

/** `glow` lights the plate from behind, picked off each screenshot's own palette. */
const reels: Record<string, { img?: any; figure?: string; glow: string; tall?: boolean }> = {
  miigenie:           { img: miigenieImg, glow: '18,92,74',   tall: true },
  kinvault:           { img: kinvaultImg, glow: '63,48,120',  tall: true },
  hazop:              { img: hazopImg,    glow: '26,72,122' },
  'api-lifecycle':    { img: ericssonImg, glow: '34,64,96' },
  'sherwin-williams': { figure: '30–40%', glow: '140,58,30' },
  amble:              { img: ambleImg,    glow: '96,78,40' },
};

const chapters = projects.map((p, i) => ({ ...p, ...reels[p.slug], n: String(i + 1).padStart(2, '0') }));

/** Title cards between chapters — the lines worth stopping on. */
const cards: Record<number, string> = {
  2: 'A HAZOP study is a room of engineers working through the ways a plant might kill someone.',
  4: 'Twenty people, six products, and a filing system nobody could navigate.',
};

const fonts = 'https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700;800&display=swap';
---

<Variant
  title="Sayantan Dutta — Product Designer"
  description="Product designer for enterprise SaaS and AI. Industrial safety platforms, API infrastructure, and a voice-first AI companion. Selected work 2020 to 2026."
  variant="reel"
  fonts={fonts}
  themeColor="#000000"
>

<!-- ═══ OPENING ═══════════════════════════════════════════════════ -->
<header class="open">
  <figure class="open-bg" aria-hidden="true">
    <Image src={portrait} alt="" widths={[900, 1600]} sizes="100vw" />
  </figure>

  <div class="open-copy">
    <p class="supra">Sayantan Dutta · Product designer</p>
    <h1>
      <span>I design the enterprise software</span>
      <span>people can’t opt out of using.</span>
    </h1>
    <p class="logline">
      Industrial safety, API infrastructure, and a voice-first AI companion.
      Five years, six products, founding designer on three of them.
    </p>

    <ul class="proof">
      <li><b>5</b><span>years in practice</span></li>
      <li><b>3</b><span>as sole designer</span></li>
      <li><b>2</b><span>live in production</span></li>
      <li><b>20+</b><span>team I built ops for</span></li>
    </ul>

    <div class="open-cta">
      <a class="btn" href="#c-1" data-ab="open:work">See the work</a>
      <a class="btn btn-ghost" href={`mailto:${contact.email}`} data-ab="open:email">Get in touch</a>
    </div>
  </div>

  <p class="scroll-cue" aria-hidden="true"><span></span>Scroll</p>
</header>

<main id="main">
  {chapters.map((c, i) => (
    <>
      <section class="chapter" id={`c-${i + 1}`} aria-labelledby={`h-${c.slug}`} style={`--glow:${c.glow}`}>
        <div class="ch-inner">
          <div class="ch-copy reveal">
            <p class="ch-meta">
              <span class="ch-n">{c.n}</span>
              <span class={`status s-${c.status.toLowerCase()}`}>{c.status}</span>
              <span class="ch-year">{c.period}</span>
            </p>
            <h2 id={`h-${c.slug}`}>{c.title}</h2>
            <p class="ch-sum">{c.summary}</p>

            <dl class="ch-facts">
              <div><dt>Client</dt><dd>{c.org}</dd></div>
              <div><dt>Role</dt><dd>{c.role}</dd></div>
              <div><dt>Field</dt><dd>{c.sector}</dd></div>
            </dl>

            <a class="ch-go" href={c.href} data-ab={`reel:${c.slug}`}>
              Open the case study <span aria-hidden="true">→</span>
            </a>
          </div>

          <div class="ch-plate reveal">
            <div class="plate-glow" aria-hidden="true"></div>
            {c.img
              ? <Image class={c.tall ? 'shot tall' : 'shot'} src={c.img} alt="" widths={[600, 1100]} sizes="(max-width: 900px) 80vw, 520px" loading="lazy" />
              : <div class="shot figure"><span>{c.figure}</span><em>less rework, six products, team of 20+</em></div>}
          </div>
        </div>
      </section>

      {cards[i] && (
        <aside class="card">
          <p class="reveal">{cards[i]}</p>
        </aside>
      )}
    </>
  ))}

  <!-- ═══ CREDITS ═══════════════════════════════════════════════════ -->
  <section class="credits" aria-labelledby="credits-h">
    <h2 id="credits-h" class="credits-h">Credits</h2>
    <ol>
      {log.slice().reverse().map((l) => (
        <li class="reveal">
          <span class="cr-role">{l.event.split(' · ')[0]}</span>
          <span class="cr-org">{l.event.split(' · ')[1] ?? ''}</span>
          <span class="cr-when">{l.stamp}</span>
        </li>
      ))}
      <li class="reveal">
        <span class="cr-role">MA Design Management</span>
        <span class="cr-org">University of Southampton</span>
        <span class="cr-when">2024–25</span>
      </li>
    </ol>
  </section>

  <!-- ═══ END ═══════════════════════════════════════════════════════ -->
  <section class="end">
    <p class="end-k">End of reel</p>
    <h2>Working on something people have to use, not something they choose to?</h2>
    <p class="end-mail"><a href={`mailto:${contact.email}`} data-ab="end:email">{contact.email}</a></p>
    <ul class="end-links">
      <li><a href={contact.linkedin} target="_blank" rel="me noopener" data-ab="end:linkedin">LinkedIn ↗</a></li>
      <li><a href={contact.resume} data-ab="end:cv">CV (PDF)</a></li>
      <li>{contact.base}</li>
    </ul>
  </section>
</main>

<script>
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Reveal on entry. Everything starts visible in CSS and is only hidden once
  // JS confirms it can put it back, so a failed script never blanks the page.
  const items = Array.from(document.querySelectorAll<HTMLElement>('.reveal'));
  if (!reduce && 'IntersectionObserver' in window) {
    // Never hide what is already on screen — otherwise the first paint is blank
    // until the observer gets round to it.
    const below = items.filter((el) => el.getBoundingClientRect().top > innerHeight * 0.9);
    below.forEach((el) => el.classList.add('armed'));

    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      });
    }, { rootMargin: '0px 0px -12% 0px' });
    below.forEach((el) => io.observe(el));

    // Dead man's switch. If the observer never fires — a stalled tab, a headless
    // render, a browser quirk — the copy must still be there to read.
    setTimeout(() => below.forEach((el) => el.classList.add('in')), 2500);
  }

  // Plates drift against the scroll. One rAF pass for every plate on screen.
  if (!reduce) {
    const plates = Array.from(document.querySelectorAll<HTMLElement>('.ch-plate'));
    let ticking = false;
    const frame = () => {
      ticking = false;
      const h = innerHeight;
      for (const p of plates) {
        const r = p.getBoundingClientRect();
        if (r.bottom < -200 || r.top > h + 200) continue;
        const mid = (r.top + r.height / 2 - h / 2) / h;   // -0.5 … 0.5 through the viewport
        p.style.setProperty('--drift', `${(-mid * 42).toFixed(1)}px`);
      }
    };
    addEventListener('scroll', () => {
      if (!ticking) { ticking = true; requestAnimationFrame(frame); }
    }, { passive: true });
    frame();
  }
</script>

<style>
  :root {
    --bg: #000;
    --ink: #f4f4f3;
    --ink-2: #a3a3a0;
    --faint: #6d6d6a;
    --line: #232322;
    --live: #4ade80;
    --sans: 'Inter Tight', system-ui, sans-serif;
    --pad: clamp(1.2rem, 5vw, 5rem);
    --measure: 1280px;
  }

  :global(body) { background: var(--bg); color: var(--ink); font-family: var(--sans); line-height: 1.5; }
  :global(.skip-link) { background: var(--ink); color: #000; }
  :global(:focus-visible) { outline: 2px solid var(--ink); outline-offset: 4px; }
  :global(.ab-switch) { background: #0d0d0d; }

  h1, h2 { letter-spacing: -.04em; line-height: 1.02; font-weight: 700; text-wrap: balance; }

  .reveal.armed { opacity: 0; transform: translateY(22px); }
  .reveal.armed.in { opacity: 1; transform: none; transition: opacity .7s cubic-bezier(.2,.7,.3,1), transform .7s cubic-bezier(.2,.7,.3,1); }

  .btn {
    display: inline-flex; align-items: center; min-height: 48px; padding: .8rem 1.5rem;
    background: var(--ink); color: #000; font-weight: 600; font-size: .95rem; border-radius: 2px;
    transition: opacity .2s;
  }
  .btn:hover { opacity: .82; }
  .btn-ghost { background: transparent; color: var(--ink); border: 1px solid #3a3a38; }
  .btn-ghost:hover { border-color: var(--ink); opacity: 1; }

  /* ── opening ── */
  .open {
    position: relative; min-height: 100svh; display: flex; align-items: flex-end;
    padding: clamp(3rem, 10vw, 7rem) var(--pad) clamp(3.5rem, 8vw, 6rem);
    overflow: hidden;
  }
  .open-bg { position: absolute; inset: 0; z-index: 0; }
  .open-bg img {
    width: 100%; height: 100%; object-fit: cover; object-position: 62% 22%;
    animation: push 26s ease-out forwards;
  }
  @keyframes push { from { transform: scale(1.1); } to { transform: scale(1); } }
  .open::after {
    content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background:
      linear-gradient(to top, #000 4%, rgba(0,0,0,.86) 34%, rgba(0,0,0,.45) 68%, rgba(0,0,0,.65) 100%),
      linear-gradient(to right, #000 0%, rgba(0,0,0,.55) 46%, transparent 78%);
  }
  .open-copy { position: relative; z-index: 2; max-width: 46rem; }

  .supra { font-size: .76rem; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; color: var(--ink-2); }
  .open h1 { font-size: clamp(2.3rem, 6.4vw, 5rem); font-weight: 800; margin: 1.1rem 0 1.4rem; }
  .open h1 span { display: block; }
  .logline { font-size: clamp(1rem, 2.1vw, 1.2rem); color: var(--ink-2); max-width: 44ch; }

  .proof { display: flex; flex-wrap: wrap; gap: 1.6rem 2.6rem; margin: 2.2rem 0 2.4rem; }
  .proof li { display: flex; flex-direction: column; }
  .proof b { font-size: clamp(1.5rem, 3.4vw, 2.1rem); font-weight: 700; letter-spacing: -.04em; }
  .proof span { font-size: .78rem; color: var(--faint); }
  .open-cta { display: flex; flex-wrap: wrap; gap: .7rem; }

  .scroll-cue {
    position: absolute; z-index: 2; right: var(--pad); bottom: clamp(3.5rem, 8vw, 6rem);
    display: flex; align-items: center; gap: .6rem;
    font-size: .68rem; letter-spacing: .2em; text-transform: uppercase; color: var(--faint);
  }
  .scroll-cue span { width: 34px; height: 1px; background: var(--faint); transform-origin: left; animation: sweep 2.4s ease-in-out infinite; }
  @keyframes sweep { 0%,100% { transform: scaleX(.35); opacity: .5 } 50% { transform: scaleX(1); opacity: 1 } }
  @media (max-width: 760px) { .scroll-cue { display: none; } }

  /* ── chapters ── */
  .chapter { padding: clamp(4rem, 12vw, 9rem) var(--pad); border-top: 1px solid var(--line); }
  .ch-inner {
    max-width: var(--measure); margin: 0 auto;
    display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem); align-items: center;
  }
  .chapter:nth-child(even) .ch-copy { order: 2; }
  @media (max-width: 900px) {
    .ch-inner { grid-template-columns: 1fr; }
    .chapter:nth-child(even) .ch-copy { order: 0; }
  }

  .ch-meta { display: flex; align-items: center; gap: .9rem; flex-wrap: wrap; margin-bottom: 1.1rem; }
  .ch-n { font-size: .8rem; font-weight: 700; letter-spacing: .1em; color: var(--faint); }
  .status {
    font-size: .64rem; font-weight: 700; letter-spacing: .16em; text-transform: uppercase;
    padding: .25rem .55rem; border: 1px solid currentColor; border-radius: 2px; color: var(--ink-2);
  }
  .s-live { color: var(--live); }
  .ch-year { font-size: .78rem; color: var(--faint); }
  .chapter h2 { font-size: clamp(1.7rem, 4vw, 2.9rem); max-width: 20ch; }
  .ch-sum { margin-top: 1.1rem; color: var(--ink-2); max-width: 48ch; font-size: clamp(.98rem, 1.9vw, 1.05rem); }

  .ch-facts { display: flex; flex-wrap: wrap; gap: 1.4rem 2.2rem; margin: 1.8rem 0; }
  .ch-facts dt { font-size: .64rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--faint); }
  .ch-facts dd { font-size: .9rem; margin-top: .2rem; }
  .ch-go {
    display: inline-flex; align-items: center; gap: .5rem; min-height: 44px;
    font-weight: 600; font-size: .95rem; border-bottom: 1.5px solid #3a3a38; padding-bottom: 2px;
  }
  .ch-go:hover { border-bottom-color: var(--ink); }

  /* plate */
  .ch-plate { position: relative; display: grid; place-items: center; transform: translateY(var(--drift, 0)); }
  .plate-glow {
    position: absolute; inset: -14% -6%; z-index: 0; pointer-events: none;
    background: radial-gradient(ellipse at center, rgba(var(--glow), .5), transparent 68%);
    filter: blur(44px);
  }
  .shot {
    position: relative; z-index: 1; width: 100%; max-height: 520px;
    object-fit: cover; object-position: top center;
    border: 1px solid #262625; border-radius: 6px;
    box-shadow: 0 40px 80px -40px rgba(0,0,0,.95);
    background: #0a0a0a;
  }
  .shot.tall { width: min(270px, 62%); max-height: 560px; border-radius: 18px; }
  .shot.figure {
    display: grid; place-content: center; gap: .7rem; text-align: center;
    aspect-ratio: 4 / 3; padding: 2rem;
  }
  .shot.figure span { font-size: clamp(2.6rem, 7vw, 4.4rem); font-weight: 800; letter-spacing: -.05em; }
  .shot.figure em { font-style: normal; font-size: .82rem; color: var(--ink-2); }

  /* ── title cards ── */
  .card {
    display: grid; place-items: center; min-height: 72svh;
    padding: clamp(3rem, 10vw, 7rem) var(--pad);
    border-top: 1px solid var(--line);
  }
  .card p {
    max-width: 22ch; text-align: center;
    font-size: clamp(1.6rem, 5vw, 3.4rem); font-weight: 700;
    letter-spacing: -.04em; line-height: 1.08; text-wrap: balance;
  }

  /* ── credits ── */
  .credits { max-width: 900px; margin: 0 auto; padding: clamp(4rem, 11vw, 8rem) var(--pad); border-top: 1px solid var(--line); }
  .credits-h { font-size: .76rem; font-weight: 600; letter-spacing: .24em; text-transform: uppercase; color: var(--faint); text-align: center; margin-bottom: clamp(2rem, 5vw, 3.5rem); }
  .credits li {
    display: grid; grid-template-columns: 1fr auto 9rem; gap: 1.2rem; align-items: baseline;
    padding: 1rem 0; border-bottom: 1px solid var(--line);
  }
  .cr-role { font-size: clamp(1rem, 2.2vw, 1.25rem); font-weight: 600; letter-spacing: -.02em; }
  .cr-org { color: var(--ink-2); font-size: .92rem; }
  .cr-when { color: var(--faint); font-size: .82rem; text-align: right; }
  @media (max-width: 680px) {
    .credits li { grid-template-columns: 1fr auto; }
    .cr-org { grid-column: 1; }
  }

  /* ── end ── */
  .end { text-align: center; padding: clamp(4rem, 12vw, 9rem) var(--pad) clamp(5rem, 14vw, 10rem); border-top: 1px solid var(--line); }
  .end-k { font-size: .7rem; font-weight: 600; letter-spacing: .24em; text-transform: uppercase; color: var(--faint); }
  .end h2 { font-size: clamp(1.7rem, 5vw, 3.2rem); max-width: 18ch; margin: 1.2rem auto 0; }
  .end-mail { margin-top: 2.4rem; font-size: clamp(1.1rem, 3.2vw, 1.8rem); font-weight: 600; letter-spacing: -.03em; word-break: break-word; }
  .end-mail a { border-bottom: 2px solid #3a3a38; }
  .end-mail a:hover { border-bottom-color: var(--ink); }
  .end-links { display: flex; justify-content: center; flex-wrap: wrap; gap: 1.6rem; margin-top: 1.8rem; font-size: .9rem; color: var(--faint); }
  .end-links a { color: var(--ink); font-weight: 500; }

  @media (prefers-reduced-motion: reduce) {
    .open-bg img { animation: none; transform: none; }
    .scroll-cue span { animation: none; }
    .ch-plate { transform: none; }
  }
</style>
</Variant>

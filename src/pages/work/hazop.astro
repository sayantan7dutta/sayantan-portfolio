---
import { Image } from 'astro:assets';
import CaseStudy from '../../layouts/CaseStudy.astro';
import CaseStudyHero from '../../components/CaseStudyHero.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import StatCards from '../../components/StatCards.astro';
import MoreCaseStudies from '../../components/MoreCaseStudies.astro';
import ServiceBlueprint from '../../components/ServiceBlueprint.astro';
import BrowserFrame from '../../components/BrowserFrame.astro';
import Lightbox from '../../components/Lightbox.astro';

import analyticsImg from '../../assets/work/hazop/analytics-dashboard.jpg';
import scenarioImg from '../../assets/work/hazop/scenario-summary.jpg';
import riskMatrixImg from '../../assets/work/hazop/risk-matrix.jpg';
import sitesImg from '../../assets/work/hazop/sites-dashboard.jpg';

// Parallel engagement: the Soter Software marketing site, rebuilt alongside
// the HAZOP Edge MVP for the same company.
import siteHomeImg from '../../assets/work/soter-software/hero.jpg';
import siteProductsImg from '../../assets/work/soter-software/products.jpg';
import siteKnowledgeImg from '../../assets/work/soter-software/knowledge-centre.jpg';

const processSteps = [
  {
    title: 'Domain research and stakeholder interviews',
    body: 'I ran in-depth interviews with safety professionals to understand the HAZOP study lifecycle, from identifying nodes through to tracking action items. The finding that shaped everything: safety engineers spent most of a study on data entry and format compliance, not on the safety analysis itself. The tool was meant to support the thinking, not replace it.',
  },
  {
    title: 'A service blueprint of the full system',
    body: 'I mapped the human and digital layers of a HAZOP study: the facilitator, the scribe, the engineers, the compliance officer. The service mattered as much as the UI. A study runs on handoffs between people, so the platform had to support those handoffs, not only individual tasks. The blueprint shaped the information architecture directly.',
  },
  {
    title: 'Information architecture and user flows',
    body: 'I structured the navigation around the four stages of a HAZOP study, Identify, Assess, Mitigate, Report, so users always knew where they were and what came next. Progressive disclosure ran throughout. Experienced engineers could go deep, while new users were not overwhelmed on first entry.',
  },
  {
    title: 'A design system for compliance environments',
    body: 'I built a design system covering components, states, content patterns, and accessibility standards. It gave the engineering team a foundation to expand on without reintroducing inconsistency. The visual language stayed deliberately calm. In a compliance environment, trust comes from predictability, not delight.',
  },
  {
    title: 'Prototype, test, iterate',
    body: 'I built high-fidelity prototypes and tested them with safety professionals. The main usability insight: during long, multi-node studies, users needed to understand the system status at every step. I refined the progress indicators, state labels, and confirmation patterns from the testing feedback.',
  },
];

const stats = [
  { num: '50%', label: 'Decrease in time spent on manual data entry' },
  { num: '40%', label: 'Reduction in reporting errors compared to spreadsheets' },
  { num: '35%', label: 'Faster overall completion of hazard studies' },
];
---

<CaseStudy
  title="HAZOP Edge, UX Strategy for Industrial Safety"
  description="UX strategy for HAZOP Edge, a B2B SaaS platform that simplifies hazard and operability studies for safety professionals, from domain research through to MVP delivery."
>
  <CaseStudyHero
    title="UX Strategy for a B2B SaaS Platform in Industrial Safety"
    lead="HAZOP Edge changed how safety assessments move through an organisation, not just how a screen looks. As the sole designer on the engagement, I redesigned the service behind hazard and operability studies in industrial environments: who does what, where accountability sits, how duplication and rework are removed, and how compliance evidence is produced. I owned it from the first domain research through to MVP delivery, alongside a parallel rebuild of the company website; the interface is the evidence of that service change."
    tags={['B2B SaaS', 'Industrial Safety', 'UK · 2025']}
    meta={[
      { key: 'Role', val: 'Founding Product Designer' },
      { key: 'Company', val: 'Soter Safety Consulting' },
      { key: 'Industry', val: 'Industrial Safety / SaaS' },
      { key: 'Timeline', val: 'Jun-Aug 2025' },
    ]}
    heroPlaceholder="HAZOP Edge dashboard"
  >
    <Image slot="hero-image" src={analyticsImg} alt="HAZOP Edge analytics dashboard" class="cs-hero-img-el" loading="eager" />
  </CaseStudyHero>

  <div class="cs-body">
    <div class="container">

      <!-- Problem / Solution -->
      <div class="cs-section">
        <div class="cs-two">
          <div class="reveal">
            <span class="cs-section-lbl">Problem</span>
            <h2 class="cs-subheading">Complexity was the workflow, not a bug in it</h2>
            <p class="t-body" style="margin-top:1rem;">
              Industrial hazard and operability (HAZOP) studies run on dense, technical workflows. The people doing them, process engineers, safety managers, risk analysts, needed a system that could manage rigorous, compliance-heavy work without burying them in convoluted interfaces.
            </p>
            <p class="t-body" style="margin-top:.75rem;">
              The existing tools were built by engineers, for engineers. They were dense, unintuitive, and poorly suited to the cross-functional work a HAZOP study actually involves. Teams fell back on spreadsheets, Word documents, and email chains to track safety assessments that could decide whether a refinery was safe to operate.
            </p>
          </div>
          <div class="reveal" style="transition-delay:.1s;">
            <span class="cs-section-lbl">Solution</span>
            <h2 class="cs-subheading">UX strategy from domain research through MVP delivery</h2>
            <p class="t-body" style="margin-top:1rem;">
              I owned the UX strategy across the whole project, translating dense technical requirements into something accessible. A scalable design system and a navigation structure anchored to the HAZOP lifecycle meant the MVP earned trust quickly, with safety professionals who had never had a tool built for this work.
            </p>
            <p class="t-body" style="margin-top:.75rem;">
              The platform reduced manual data entry, standardised compliance reporting, and laid a foundation that the engineering team could build on without reintroducing inconsistency.
            </p>
          </div>
        </div>
      </div>

      <!-- Design Process -->
      <div class="cs-section">
        <span class="cs-section-lbl">Design process</span>
        <h2 class="cs-heading reveal">How I approached a domain I'd never worked in before</h2>
        <p class="t-body cs-intro reveal" style="transition-delay:.08s;">
          Industrial safety was entirely new territory for me. The first three weeks were almost all research, understanding the domain before I opened a design tool.
        </p>

        <ProcessSteps steps={processSteps} />

        <!-- Service blueprint -->
        <div class="reveal" style="margin-top:2rem;">
          <ServiceBlueprint />
        </div>

        <!-- Research insight -->
        <blockquote class="cs-insight reveal">
          <p>"Safety engineers were spending over half of every study on data entry and report formatting, time that should have gone to the safety thinking itself."</p>
          <cite>Domain research finding · Soter Safety Consulting · 2025</cite>
        </blockquote>
      </div>

      <!-- UX Strategy & Design Decisions -->
      <div class="cs-section">
        <span class="cs-section-lbl">UX Strategy &amp; Design Decisions</span>
        <h2 class="cs-heading reveal">Designing for <em>trust</em> in a compliance environment</h2>
        <p class="t-body cs-intro reveal" style="transition-delay:.08s;">
          The core design principle was reducing cognitive load. The goal was never simplification for its own sake. It was stripping out friction so users could focus on the safety thinking instead of fighting the tooling.
        </p>

        <figure class="cs-figure reveal" style="margin-top:2rem;">
          <BrowserFrame label="Scenario Summary">
            <Image src={scenarioImg} alt="HAZOP Edge scenario summary table with risk assessment and actions" data-lightbox loading="lazy" />
          </BrowserFrame>
          <figcaption class="cs-figure-cap">Scenario Summary: every deviation, its risk rating, and its tracked action in one scannable table</figcaption>
        </figure>

        <div class="cs-grid-4">
          <div class="reveal">
            <h3>Lifecycle-anchored navigation</h3>
            <p class="t-body">Navigation and page structure mapped directly to the safety assessment lifecycle: identify risks → evaluate operability → track mitigations → generate compliance reports. Users always knew their next step without asking a colleague.</p>
          </div>
          <div class="reveal" style="transition-delay:.1s;">
            <h3>Scannable layouts for data-heavy views</h3>
            <p class="t-body">Risk matrices and technical safety logs used scannable, grid-based layouts with meaningful defaults and progressive disclosure. Seasoned engineers could go deep; first-time users weren't overwhelmed.</p>
          </div>
          <div class="reveal">
            <h3>Consistent visual language</h3>
            <p class="t-body">A deliberately calm, purposeful visual system. In compliance environments, trust comes from predictability, so status indicators, state colours, and confirmation patterns stayed consistent across every screen.</p>
          </div>
          <div class="reveal" style="transition-delay:.1s;">
            <h3>Scalable design system</h3>
            <p class="t-body">A component library covering states, patterns, and accessibility, so the engineering team could ship new features without reintroducing visual inconsistency or breaking the trust model.</p>
          </div>
        </div>

        <div class="cs-two" style="margin-top:2rem;">
          <figure class="cs-figure reveal" style="margin:0;">
            <BrowserFrame label="Risk Matrix · Data Entry">
              <Image src={riskMatrixImg} alt="HAZOP Edge risk matrix data entry screen" data-lightbox loading="lazy" />
            </BrowserFrame>
            <figcaption class="cs-figure-cap">Risk Matrix: severity and probability captured on a guided grid, not a spreadsheet</figcaption>
          </figure>
          <figure class="cs-figure reveal" style="margin:0;transition-delay:.1s;">
            <BrowserFrame label="Sites Overview">
              <Image src={sitesImg} alt="HAZOP Edge sites overview dashboard" data-lightbox loading="lazy" />
            </BrowserFrame>
            <figcaption class="cs-figure-cap">Sites overview: the entry point, organised around how safety teams actually work</figcaption>
          </figure>
        </div>
      </div>

      <!-- Business Impact -->
      <div class="cs-section">
        <span class="cs-section-lbl">Service impact</span>
        <h2 class="cs-heading reveal">A safety assessment that moves through the organisation cleanly</h2>
        <p class="t-body cs-intro reveal" style="transition-delay:.08s;">
          The change was operational, not cosmetic. Studies that lived in scattered spreadsheets now move through one accountable process: clear ownership at each step, duplication and reporting rework removed, and compliance evidence produced as a by-product of the work rather than a scramble at the end. It maps onto how safety professionals already think, so it didn't try to replace the safety thinking, that part was never the problem.
        </p>
        <StatCards stats={stats} />
      </div>

      <!-- Parallel engagement: the company website -->
      <div class="cs-section">
        <span class="cs-section-lbl">Parallel engagement</span>
        <h2 class="cs-heading reveal">Parallel engagement: rebuilding the company website</h2>
        <p class="t-body cs-intro reveal" style="transition-delay:.08s;">
          Alongside the HAZOP Edge MVP I rebuilt Soter Software's own website, migrating it off WordPress and into Wix. Same company, two outputs at the same time: a product platform their customers could trust, and a marketing site that could actually represent the company behind it. The website was the lighter brief, but its impact compounded the product, because every prospect now landed in the right place before the demo.
        </p>

        <div class="cs-two" style="margin-top:2rem;">
          <div class="reveal">
            <span class="cs-section-lbl">Problem</span>
            <h3 class="cs-subheading">A WordPress site that under-sold a serious product</h3>
            <p class="t-body" style="margin-top:1rem;">The existing site read like a brochure: a long homepage, a thin About page, and a Products page that listed features without explaining who they were for. Two compounding issues. The information architecture did not match how engineering buyers evaluate process-safety software, so visitors bounced before they understood the product. And every content change needed a developer, so marketing couldn't keep the site current with the roadmap.</p>
          </div>
          <div class="reveal" style="transition-delay:.1s;">
            <span class="cs-section-lbl">Solution</span>
            <h3 class="cs-subheading">A site that maps to how buyers actually evaluate</h3>
            <p class="t-body" style="margin-top:1rem;">I rebuilt the information architecture around six top-level sections, each answering a specific question a process-safety buyer brings to the site, and organised the Products page by the four personas who touch a study. I delivered it inside Wix, hand-building every page, the navigation, and the responsive behaviour, so the team was left with a site they could update themselves. Zero developers needed for content changes.</p>
          </div>
        </div>

        <!-- IA: six questions, six sections -->
        <div class="ia-flow reveal" style="margin-top:2.5rem;">
          <div class="ia-row">
            <span class="ia-row-tag is-after">Sitemap, after</span>
            <ol class="sm-list">
              <li><span class="sm-num">01</span><div><span class="sm-name">Home</span><span class="sm-q">What does this company do?</span></div></li>
              <li><span class="sm-num">02</span><div><span class="sm-name">About</span><span class="sm-q">Who's behind this, and can I trust them?</span></div></li>
              <li><span class="sm-num">03</span><div><span class="sm-name">Products</span><span class="sm-q">What does HAZOP Edge do, and is it for me?</span></div></li>
              <li><span class="sm-num">04</span><div><span class="sm-name">Knowledge Centre</span><span class="sm-q">How do these people think about safety?</span></div></li>
              <li><span class="sm-num">05</span><div><span class="sm-name">FAQs</span><span class="sm-q">What's the catch, what does it cost, how does it deploy?</span></div></li>
              <li><span class="sm-num">06</span><div><span class="sm-name">Contact</span><span class="sm-q">I'm in. How do I talk to a human?</span></div></li>
            </ol>
            <p class="ia-note">Each section earns its place by answering one question. The Knowledge Centre, in particular, was a deliberate addition. Buyers in process safety read before they buy, and giving them a place to read built credibility before any sales conversation.</p>
          </div>
        </div>

        <!-- Product page, organised by persona -->
        <h3 class="cs-subheading reveal" style="margin-top:2.5rem;">A product page that speaks to four people at once</h3>
        <p class="t-body reveal" style="margin-top:1rem;max-width:62ch;">
          HAZOP Edge is used by four very different people on the same study. The old page listed features in one long flow, leaving each persona to find their own relevance. The rebuilt page is structured by user role, so each visitor finds their own job described in their own language within the first scroll of their section. It also gave the sales team a cleaner share artefact: drop one persona-anchored section into a follow-up email rather than sending a deck.
        </p>

        <div class="persona-grid reveal" style="margin-top:1.5rem;">
          <div class="persona-card">
            <span class="persona-num">01</span>
            <p class="persona-role">Facilitators &amp; Scribes</p>
            <p class="persona-job">Set up workshops, document decisions, cut manual rework.</p>
          </div>
          <div class="persona-card">
            <span class="persona-num">02</span>
            <p class="persona-role">Team Members</p>
            <p class="persona-job">Access studies, collaborate live, see risks in context.</p>
          </div>
          <div class="persona-card">
            <span class="persona-num">03</span>
            <p class="persona-role">Project Managers</p>
            <p class="persona-job">Real-time dashboards, bottleneck visibility, consolidated insights.</p>
          </div>
          <div class="persona-card">
            <span class="persona-num">04</span>
            <p class="persona-role">Senior Management</p>
            <p class="persona-job">Risk trend visibility, data-driven decisions, compliance evidence.</p>
          </div>
        </div>

        <!-- Built in Wix -->
        <div class="cs-grid-3" style="margin-top:2.5rem;">
          <figure class="cs-figure reveal" style="margin:0;">
            <BrowserFrame label="sotersoftware.com">
              <Image src={siteHomeImg} alt="Soter Software homepage, 'Clarity to Prevent Major Accidents'" data-lightbox loading="lazy" />
            </BrowserFrame>
            <figcaption class="cs-figure-cap">Home: clarity-to-prevent-major-accidents positioning, above the fold</figcaption>
          </figure>
          <figure class="cs-figure reveal" style="margin:0;transition-delay:.08s;">
            <BrowserFrame label="sotersoftware.com/products">
              <Image src={siteProductsImg} alt="HAZOP Edge product page, four persona-anchored sections for Facilitators, Team Members, Project Managers, and Senior Management" data-lightbox loading="lazy" />
            </BrowserFrame>
            <figcaption class="cs-figure-cap">Products: HAZOP Edge organised by the four user personas</figcaption>
          </figure>
          <figure class="cs-figure reveal" style="margin:0;transition-delay:.16s;">
            <BrowserFrame label="sotersoftware.com/knowledge-centre">
              <Image src={siteKnowledgeImg} alt="Knowledge Centre landing page with article listings" data-lightbox loading="lazy" />
            </BrowserFrame>
            <figcaption class="cs-figure-cap">Knowledge Centre: a publishing surface owned by marketing, not engineering</figcaption>
          </figure>
        </div>

        <p class="t-body reveal" style="margin-top:2rem;max-width:62ch;">
          Wix wasn't the fashionable choice, and it wasn't meant to be. Soter's team is small and fast, and they needed a surface they could run themselves. A custom build would have looked better in a portfolio and worked worse in the business. Choosing the boring tool was the design decision.
        </p>
      </div>

      <!-- Learnings -->
      <div class="cs-section">
        <span class="cs-section-lbl">Learnings &amp; Reflections</span>
        <h2 class="cs-heading reveal">What this project taught me</h2>
        <div class="cs-two" style="margin-top:1.5rem;">
          <div class="reveal">
            <p class="t-body">
              Working in industrial safety forced me to confront the limits of pattern-matching. Most of the UX patterns I'd built up over several years of enterprise work were only partly useful here. Safety professionals have a very specific mental model, shaped by regulatory frameworks and a deep risk-aversion, and a lot of consumer-influenced design patterns work against it.
            </p>
            <p class="t-body" style="margin-top:.75rem;">
              The domain research, which I almost compressed under timeline pressure, turned out to be the most valuable work I did. The service blueprint session with stakeholders surfaced requirements that no amount of user-story refinement would have uncovered.
            </p>
          </div>
          <div class="reveal" style="transition-delay:.1s;">
            <p class="t-body">
              If I revisited this project, I'd push harder for at least one round of usability testing with safety engineers in their own context, with a screen recording rather than a facilitated lab session. HAZOP tasks are long and sequential, and lab-style sessions are poorly suited to validating that kind of flow.
            </p>
            <p class="t-body" style="margin-top:.75rem;">
              I'd also bring accessibility constraints in earlier. In a compliance environment, accessibility is a legal requirement, not a nice-to-have, and retrofitting it later created rework I could have avoided.
            </p>
          </div>
        </div>
      </div>

    </div>
  </div>

  <MoreCaseStudies current="hazop" />
  <Lightbox />
</CaseStudy>

<style>
/* ─── Parallel engagement: company website section ───
   Moved here from the former standalone soter-software case study. */

/* Sitemap list */
.sm-list {
  list-style: none;
  margin: 1rem 0 0;
  padding: 0;
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: .75rem 1.25rem;
}
.sm-list li {
  display: grid;
  grid-template-columns: auto 1fr;
  align-items: baseline;
  gap: .75rem;
  padding: .9rem 1rem;
  border: 1px solid var(--border);
  border-radius: 2px;
  background: var(--surface);
}
.sm-num {
  font-family: var(--font-mono);
  font-size: .6rem;
  letter-spacing: .12em;
  color: var(--text-3);
}
.sm-name {
  display: block;
  font-family: var(--font-display);
  font-size: 1.05rem;
  font-weight: 600;
  color: var(--text-1);
}
.sm-q {
  display: block;
  font-size: .78rem;
  color: var(--text-2);
  margin-top: .15rem;
  line-height: 1.45;
}

/* IA flow wrapper */
.ia-flow { display: flex; flex-direction: column; gap: 1rem; }
.ia-row {
  border: 1px solid var(--border);
  border-radius: 2px;
  padding: 1.5rem 1.6rem;
}
.ia-row-tag {
  font-family: var(--font-mono);
  font-size: .58rem;
  letter-spacing: .12em;
  text-transform: uppercase;
  display: inline-block;
}
.ia-row-tag.is-after { color: var(--accent); }
/* .ia-note is defined globally in global.css (a11y-fixed) */

/* Persona cards */
.persona-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
}
.persona-card {
  padding: 1.2rem 1.25rem;
  border: 1px solid var(--border);
  border-radius: 2px;
  background: var(--surface);
  transition: border-color .25s, background .25s;
}
.persona-card:hover { border-color: var(--accent); background: var(--accent-bg); }
.persona-num {
  font-family: var(--font-mono);
  font-size: .58rem;
  letter-spacing: .14em;
  color: var(--text-3);
}
.persona-role {
  font-family: var(--font-display);
  font-size: 1.1rem;
  font-weight: 500;
  color: var(--text-1);
  margin: .35rem 0 .4rem;
  line-height: 1.3;
}
.persona-job {
  font-size: .82rem;
  color: var(--text-2);
  line-height: 1.5;
  margin: 0;
}

@media (max-width: 640px) {
  .sm-list { grid-template-columns: 1fr; }
  .persona-grid { grid-template-columns: 1fr; }
}
</style>

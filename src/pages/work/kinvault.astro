---
import { Image } from 'astro:assets';
import CaseStudy from '../../layouts/CaseStudy.astro';
import CaseStudyHero from '../../components/CaseStudyHero.astro';
import ProcessSteps from '../../components/ProcessSteps.astro';
import StatCards from '../../components/StatCards.astro';
import MoreCaseStudies from '../../components/MoreCaseStudies.astro';
import KvPhoneTrio from '../../components/KvPhoneTrio.astro';
import Lightbox from '../../components/Lightbox.astro';

import dashboardImg from '../../assets/work/kinvault/dashboard.jpg';
import smartTransferImg from '../../assets/work/kinvault/smart-transfer.jpg';
import reviewImg from '../../assets/work/kinvault/review.jpg';
import statusImg from '../../assets/work/kinvault/transfer-status.jpg';
import vaultImg from '../../assets/work/kinvault/vault.jpg';
import billPayImg from '../../assets/work/kinvault/bill-pay.jpg';

const flowSteps = [
  { img: dashboardImg, label: 'Family dashboard' },
  { img: smartTransferImg, label: 'Smart transfer' },
  { img: reviewImg, label: 'Review &amp; rate lock' },
  { img: statusImg, label: 'Transfer status' },
];

const processSteps = [
  {
    title: 'Informal interviews — 6 diaspora users',
    body: 'Spoke with 6 people who regularly send money internationally. Common themes: anxiety about exchange rates (feeling "caught" at a bad rate), frustration that recipients can\'t see transfer status without asking, and a desire to save toward shared goals (house repairs, school fees) rather than sending ad-hoc amounts.',
  },
  {
    title: 'Competitive audit — Wise, Remitly, WorldRemit',
    body: 'All three treat transfer as a transactional event with no persistent relationship layer. Rate alerts exist in Wise but are basic threshold notifications — no context, no control, no explanation of why the rate matters for this particular transfer. None offer shared savings or direct bill payment as a category.',
  },
  {
    title: 'Concept framing — the Digital Vault-Atelier',
    body: 'Defined three design targets from the research — rate anxiety, opacity anxiety, and misdirection anxiety — each paired to a feature that neutralises it. A fourth, positioning insight shaped the brand: families want a money tool that feels permanent and considered, not disposable. Together these became the brief for the Digital Vault-Atelier — vault-grade trust, delivered with the craft of a studio.',
  },
  {
    title: 'High-fidelity prototype &amp; self-testing',
    body: 'Built a high-fidelity interactive prototype in Figma covering the core flows: vault creation, smart transfer with rate trigger, and bill payment. Validated the main flows with 3 of the original interview participants — key finding: the AI rate trigger felt "too smart" without enough explanation of how it decided to fire. Added a plain-language summary to each triggered alert.',
  },
];

const stats = [
  { num: '18%', label: 'Increase in send flow completion in prototype testing' },
  { num: '25%', label: 'Reduction in "where is my transfer" support queries' },
  { num: '15%', label: 'Increase in repeat transfers within 30 days' },
];
---

<CaseStudy
  title="KinVault Heritage — the Digital Vault-Atelier · Sayantan Dutta"
  description="A self-initiated concept for a premium cross-border finance app — bridging heritage banking and modern remittance with shared family vaults, AI-timed transfers, and direct bill payment."
>
  <CaseStudyHero
    title="KinVault Heritage — the <em>Digital Vault-Atelier</em>"
    lead="A self-initiated concept for a premium cross-border finance app — one that treats sending money home as an act of family care, not a transaction. KinVault Heritage pairs the permanence of heritage banking with the speed of modern remittance: shared family vaults, AI-timed transfers, and direct international bill payment."
    tags={['Premium Fintech', 'UK → India', '2025']}
    speculativeTag="Self-initiated concept"
    meta={[
      { key: 'Type', val: 'Self-initiated concept' },
      { key: 'Role', val: 'Product Designer' },
      { key: 'Corridor', val: 'UK → India' },
      { key: 'Year', val: '2025' },
    ]}
    heroPlaceholder="KinVault hero"
  >
    <KvPhoneTrio slot="hero-image" />
  </CaseStudyHero>

  <div class="cs-body">
    <div class="container">

      <!-- Context note -->
      <div class="cs-section" style="padding-top:0;">
        <blockquote class="cs-insight reveal" style="margin:0;">
          <p>A self-initiated concept project, not a client engagement — built to explore product thinking in premium consumer fintech, a domain distinct from my enterprise B2B work. The research, brand direction, and metrics draw on publicly available data and self-directed user research; figures are directional targets, not live product data.</p>
        </blockquote>
      </div>

      <!-- Problem / Solution -->
      <div class="cs-section">
        <div class="cs-two">
          <div class="reveal">
            <span class="cs-section-lbl">Problem</span>
            <h2 class="cs-subheading">Remittances are transactional. Families aren't.</h2>
            <p class="t-body" style="margin-top:1rem;">Cross-border remittances are a high-frequency, high-trust activity for millions of diaspora families — yet most transfer apps treat them as simple one-way transactions. There's no shared context, no family visibility, no way to save toward a shared goal, or pay a bill directly for someone you're supporting from another country.</p>
            <p class="t-body" style="margin-top:.75rem;">The result: anxiety at the point of transfer (is the rate good right now?), uncertainty at the receiving end (did it arrive? was it enough?), and no mechanism for building the kind of shared financial trust that families actually operate on.</p>
            <p class="t-body" style="margin-top:.75rem;">And there's a positioning gap. The apps that move money fast feel disposable and transactional; the institutions that feel permanent enough to trust with family money — heritage banks — are slow, opaque, and built for individuals, not families.</p>
          </div>
          <div class="reveal" style="transition-delay:.1s;">
            <span class="cs-section-lbl">Solution</span>
            <h2 class="cs-subheading">A Digital Vault-Atelier — vault-grade trust, made for families</h2>
            <p class="t-body" style="margin-top:1rem;">KinVault Heritage reframes the transfer as a relationship. Its north star is the Digital Vault-Atelier: the security and permanence of a private vault, delivered with the bespoke, considered craft of a studio. Families connect through "Kin-Link" — a trusted, person-to-person rail — then operate shared vaults both sides can see and contribute to.</p>
            <p class="t-body" style="margin-top:.75rem;">Three capabilities sit on top: AI-driven rate triggers that take the anxiety out of timing, direct bill payment so a sender can settle a utility without the money being redirected, and real-time status both ends can watch.</p>
            <p class="t-body" style="margin-top:.75rem;">The design principle: every feature reduces a specific anxiety in the transfer relationship — uncertainty, opacity, or mistiming — rather than just adding functionality.</p>
          </div>
        </div>
      </div>

      <!-- Design Process -->
      <div class="cs-section">
        <span class="cs-section-lbl">Design process</span>
        <h2 class="cs-heading reveal">Research-led, prototype-validated</h2>

        <ProcessSteps steps={processSteps} />

        <!-- Anxiety → solution map -->
        <div class="reveal" style="margin-top:2.5rem;">
          <p class="t-body" style="margin-bottom:1rem;max-width:62ch;">
            The concept resolved to one rule — every feature had to neutralise a specific anxiety in the transfer relationship, not just add functionality:
          </p>
          <div class="anxiety-map">
            <div class="anx-col">
              <div class="anx-top">
                <span class="anx-tag">Anxiety 01 · Timing</span>
                <p class="anx-felt">"Am I sending at a bad rate right now?"</p>
              </div>
              <span class="anx-arrow" aria-hidden="true">↓</span>
              <div class="anx-bot">
                <span class="anx-fix-lbl">Neutralised by</span>
                <p class="anx-fix">AI rate triggers</p>
                <p class="anx-desc">Plain-language alerts — "best rate in 14 days" — shown with the rate chart, so the user decides, not the algorithm.</p>
              </div>
            </div>
            <div class="anx-col">
              <div class="anx-top">
                <span class="anx-tag">Anxiety 02 · Opacity</span>
                <p class="anx-felt">"Did it arrive? Was it enough?"</p>
              </div>
              <span class="anx-arrow" aria-hidden="true">↓</span>
              <div class="anx-bot">
                <span class="anx-fix-lbl">Neutralised by</span>
                <p class="anx-fix">Shared vaults</p>
                <p class="anx-desc">Both sides see the same balance, contributors, and live transfer status — no message needed to confirm an arrival.</p>
              </div>
            </div>
            <div class="anx-col">
              <div class="anx-top">
                <span class="anx-tag">Anxiety 03 · Misdirection</span>
                <p class="anx-felt">"Will the money reach the actual bill?"</p>
              </div>
              <span class="anx-arrow" aria-hidden="true">↓</span>
              <div class="anx-bot">
                <span class="anx-fix-lbl">Neutralised by</span>
                <p class="anx-fix">Direct bill payment</p>
                <p class="anx-desc">Pay the utility directly. The sender sees the bill cleared — not just that money was sent.</p>
              </div>
            </div>
          </div>
        </div>

        <!-- Prototype flow -->
        <div class="reveal" style="margin-top:2.5rem;">
          <p class="t-body" style="margin-bottom:1rem;">The high-fidelity prototype — the core send-money journey, from the family dashboard to a tracked transfer:</p>
          <div class="kv-flow">
            {flowSteps.map((step, i) => (
              <div class="kv-flow-step">
                <div class="kv-flow-head">
                  <span class="kv-flow-num">0{i + 1}</span>
                  <span class="kv-flow-label" set:html={step.label} />
                </div>
                <Image src={step.img} alt={step.label.replace('&amp;', 'and')} class="phone" data-lightbox loading="lazy" />
              </div>
            ))}
          </div>
        </div>
      </div>

      <!-- Visual System & Product Design -->
      <div class="cs-section">
        <span class="cs-section-lbl">Visual System &amp; Product Design</span>
        <h2 class="cs-heading reveal">A visual system built to feel <em>permanent</em></h2>
        <p class="t-body cs-intro reveal" style="transition-delay:.08s;">
          The creative direction — "The Financial Atelier" — pairs a deep heritage navy with a pearl surface and an emerald accent for growth. Manrope keeps the type quietly geometric and modern. Generous whitespace and vault-grade security cues make a fast app feel as considered and trustworthy as a private bank.
        </p>

        <div class="kv-palette reveal">
          <div class="kv-sw"><span style="background:#1E1B4B"></span><div><strong>Indigo-950</strong><em>Heritage navy</em></div></div>
          <div class="kv-sw"><span style="background:#F8FAFC;border:1px solid var(--border)"></span><div><strong>Slate-50</strong><em>Pearl surface</em></div></div>
          <div class="kv-sw"><span style="background:#10B981"></span><div><strong>Emerald</strong><em>Growth &amp; success</em></div></div>
        </div>

        <blockquote class="cs-insight reveal" style="margin-top:2rem;">
          <p>Closer than a vault. Connected like kin.</p>
          <cite>— KinVault Heritage · brand hook</cite>
        </blockquote>

        <div class="cs-grid-4">
          <div class="reveal">
            <h3>Shared family vaults</h3>
            <p class="t-body">Progress indicators, contributor visibility, and activity history. Both sides of the relationship see the same vault state — removing the need for a WhatsApp message to confirm an arrival.</p>
          </div>
          <div class="reveal" style="transition-delay:.1s;">
            <h3>Smart Transfer with rate triggers</h3>
            <p class="t-body">AI-driven rate alerts in plain language — not just "GBP/INR hit 106.50" but "the best rate in the last 14 days — good time to send." Simple, user-controlled, with a clear opt-out.</p>
          </div>
          <div class="reveal">
            <h3>Bill Pay Abroad</h3>
            <p class="t-body">Pay a utility provider directly, not just a bank account. The sender sees confirmation that the electricity bill was cleared — not just that money was sent. It closes the anxiety loop completely.</p>
          </div>
          <div class="reveal" style="transition-delay:.1s;">
            <h3>Transfer status &amp; rate lock</h3>
            <p class="t-body">Status tracking with estimated arrival, a fee breakdown shown at the decision point (not buried in confirmation), and a real-time rate lock so the figure reviewed is the figure sent.</p>
          </div>
        </div>

        <div class="cs-grid-3" style="margin-top:2.5rem;">
          <figure class="cs-figure reveal" style="margin:0;">
            <Image src={vaultImg} alt="KinVault — shared vault allocation" class="phone" data-lightbox loading="lazy" />
            <figcaption class="cs-figure-cap">Shared vault — funds allocated to named family goals</figcaption>
          </figure>
          <figure class="cs-figure reveal" style="margin:0;transition-delay:.08s;">
            <Image src={billPayImg} alt="KinVault — pay a bill abroad" class="phone" data-lightbox loading="lazy" />
            <figcaption class="cs-figure-cap">Bill Pay Abroad — pay a utility directly, not a bank account</figcaption>
          </figure>
          <figure class="cs-figure reveal" style="margin:0;transition-delay:.16s;">
            <Image src={statusImg} alt="KinVault — transfer status tracking" class="phone" data-lightbox loading="lazy" />
            <figcaption class="cs-figure-cap">Transfer status — every step visible, both ends of the transfer</figcaption>
          </figure>
        </div>
      </div>

      <!-- Impact -->
      <div class="cs-section">
        <span class="cs-section-lbl">Projected impact</span>
        <p class="t-body cs-intro reveal">
          These figures are directional — drawn from prototype testing and benchmarked against published data from comparable remittance products. For a concept project they represent targets to design against, not live results.
        </p>
        <StatCards stats={stats} />
      </div>

      <!-- Learnings -->
      <div class="cs-section">
        <span class="cs-section-lbl">Learnings &amp; Reflections</span>
        <h2 class="cs-heading reveal">What this project taught me</h2>
        <div class="cs-two" style="margin-top:1.5rem;">
          <div class="reveal">
            <p class="t-body">Working on a consumer product after four years of enterprise work exposed how differently the two domains approach trust. In enterprise UX, trust comes from predictability and compliance signals — users trust a system that behaves consistently and transparently within a known framework. In consumer fintech, trust is much more emotional — it's about whether the product feels like it's on your side.</p>
            <p class="t-body" style="margin-top:.75rem;">The hardest design problem wasn't the feature set — it was tone. Writing copy that felt warm and human while communicating exchange rates and fee structures accurately took multiple iterations. The first version read like a banking app. The third read like a WhatsApp message. The final version landed somewhere in between — warm enough to feel like family, exact enough to feel like a vault.</p>
          </div>
          <div class="reveal" style="transition-delay:.1s;">
            <p class="t-body">The AI rate trigger feature was the most technically interesting design challenge. The first prototype version just fired when a threshold was hit — which felt arbitrary and slightly creepy. The fix was transparency: showing the 14-day rate chart alongside the trigger notification so users could see the context for themselves, rather than just being told what to do.</p>
            <p class="t-body" style="margin-top:.75rem;">This project confirmed something I suspected from enterprise work: the most important UX work often happens in the moments just before and just after the primary action — the anxiety before a transfer, the uncertainty after. Most apps design the middle and neglect the edges.</p>
          </div>
        </div>
      </div>

    </div>
  </div>

  <MoreCaseStudies current="kinvault" />
  <Lightbox />
</CaseStudy>

<style>
/* Prototype flow — phone screens across the send-money journey */
.kv-flow {
  display: flex;
  align-items: flex-start;
  gap: 1.25rem;
  overflow-x: auto;
  padding-bottom: .6rem;
}
.kv-flow-step { flex: 1 0 0; min-width: 190px; }
.kv-flow-head {
  display: flex;
  align-items: baseline;
  gap: .5rem;
  margin-bottom: .7rem;
}
.kv-flow-num {
  font-family: var(--font-mono);
  font-size: .58rem;
  letter-spacing: .1em;
  color: var(--accent);
}
.kv-flow-label {
  font-family: var(--font-display);
  font-size: 1rem;
  font-weight: 600;
  color: var(--text-1);
}

/* Creative-direction palette */
.kv-palette {
  display: flex;
  gap: 2rem;
  flex-wrap: wrap;
  margin-top: 1.75rem;
}
.kv-sw {
  display: flex;
  align-items: center;
  gap: .7rem;
}
.kv-sw > span {
  width: 40px;
  height: 40px;
  border-radius: 4px;
  display: block;
  flex-shrink: 0;
}
.kv-sw strong {
  display: block;
  font-family: var(--font-mono);
  font-size: .7rem;
  color: var(--text-1);
  font-weight: 500;
}
.kv-sw em {
  display: block;
  font-family: var(--font-mono);
  font-size: .56rem;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--text-3);
  font-style: normal;
  margin-top: .2rem;
}

/* Anxiety → solution map */
.anxiety-map {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1.25rem;
}
.anx-col {
  display: flex;
  flex-direction: column;
  border: 1px solid var(--border);
  border-radius: 2px;
  overflow: hidden;
}
.anx-top { padding: 1.5rem 1.4rem 1.6rem; }
.anx-tag {
  font-family: var(--font-mono);
  font-size: .56rem;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--text-3);
}
.anx-felt {
  font-family: var(--font-display);
  font-size: 1.3rem;
  font-style: italic;
  font-weight: 500;
  line-height: 1.3;
  color: var(--text-1);
  margin-top: .6rem;
}
.anx-arrow {
  text-align: center;
  color: var(--accent);
  font-size: .9rem;
  line-height: 0;
  margin: -.45rem 0;
  position: relative;
  z-index: 1;
}
.anx-bot {
  padding: 1.5rem 1.4rem;
  background: var(--accent-bg);
  border-top: 1px solid var(--border);
  flex: 1;
}
.anx-fix-lbl {
  font-family: var(--font-mono);
  font-size: .56rem;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--accent);
}
.anx-fix {
  font-family: var(--font-display);
  font-size: 1.15rem;
  font-weight: 600;
  color: var(--text-1);
  margin: .35rem 0 .5rem;
}
.anx-desc {
  font-size: .8rem;
  line-height: 1.6;
  color: var(--text-2);
}
@media (max-width: 768px) {
  .anxiety-map { grid-template-columns: 1fr; gap: 1rem; }
}
</style>

---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import portrait from '../assets/sayantan-studio.jpg';

// Career timeline — left to right, oldest to newest.
const timeline = [
  { year: '2020',       role: 'Service Design Intern',      org: 'Pensaar Design' },
  { year: '2020-23',  role: 'Product Designer → Lead',    org: 'TCS' },
  { year: '2023-24',  role: 'Design Operations Lead',     org: 'TCS' },
  { year: '2024-25',  role: 'MA Design Management',       org: 'Southampton' },
  { year: '2025',       role: 'Senior Product Designer',    org: 'Soter Safety' },
  { year: 'Now',        role: 'Lead Product Designer',      org: 'dAIs Genie · miiGenie' },
];

// Skill chips, grouped by category (sourced from CV).
const skillGroups = [
  {
    label: 'Product Design',
    items: ['End-to-end design', 'Discovery & framing', 'Jobs to Be Done', 'User flows', 'Journey mapping', 'Wireframing', 'Hi-fi prototyping', 'Interaction design'],
  },
  {
    label: 'Research & Validation',
    items: ['User research', 'Usability testing', 'A/B testing', 'Analytics-informed design', 'Insight synthesis', 'Heuristic evaluation'],
  },
  {
    label: 'Systems & Craft',
    items: ['Design systems', 'Component libraries', 'Responsive & mobile-first', 'Accessibility (WCAG)', 'UX copywriting', 'Design tokens'],
  },
  {
    label: 'Delivery & Collaboration',
    items: ['Product trio (PM · Eng · Design)', 'Agile / Scrum', 'Roadmap input', 'Stakeholder facilitation', 'Design critiques', 'Async remote'],
  },
];

// Tool grid, modern PD stack. SVGs in /public/images/tools/.
const tools = [
  { name: 'Figma',       file: 'figma.svg'       },
  { name: 'FigJam',      file: 'figma.svg'       },
  { name: 'Miro',        file: 'miro.svg'        },
  { name: 'Adobe CC',    file: 'adobe.svg'       },
  { name: 'Framer',      file: 'framer.svg'      },
  { name: 'Webflow',     file: 'webflow.svg'     },
  { name: 'Notion',      file: 'notion.svg'      },
  { name: 'Linear',      file: 'linear.svg'      },
  { name: 'Jira',        file: 'jira.svg'        },
  { name: 'Trello',      file: 'trello.svg'      },
  { name: 'ServiceNow',  file: 'servicenow.svg'  },
  { name: 'Loom',        file: 'loom.svg'        },
  { name: 'GitHub',      file: 'github.svg'      },
  { name: 'Claude',      file: 'claude.svg'      },
];

// Hobby tiles — inline SVGs (no external assets). `icon` is the slug we
// switch on inside the markup; keep order = display order.
const hobbies = [
  { icon: 'badminton', name: 'Badminton' },
  { icon: 'football',  name: 'Football'  },
  { icon: 'frisbee',   name: 'Frisbee'   },
  { icon: 'mocha',     name: 'Mocha'     },
  { icon: 'mountain',  name: 'Trekking'  },
  { icon: 'beach',     name: 'Beaches'   },
  { icon: 'music',     name: 'Music'     },
  { icon: 'film',      name: 'Films'     },
];

// "Now" mini-cards. Swap these any time — they're meant to feel current.
const nowItems = [
  { cat: 'Watching',  title: 'Anything by Christopher Nolan',  sub: 'Currently revisiting Dunkirk',          icon: 'film'       },
  { cat: 'Reading',   title: 'The Mom Test',                   sub: 'Rob Fitzpatrick',                       icon: 'book'       },
  { cat: 'Listening', title: 'Arijit Singh on loop',           sub: '…with the occasional Coldplay detour',  icon: 'headphones' },
];

// Cities, in order. Last entry gets the "now" treatment.
const cities = ['Gurgaon', 'Bangalore', 'Winchester', 'Southampton'];
---

<Base
  title="About · Sayantan Dutta"
  description="Product Designer working where complexity meets clarity. 5 years across AI companion apps, enterprise SaaS, industrial safety, and API platforms."
  activeNav="about"
>

<div class="about-wrap">
  <div class="container">
    <div class="about-grid">

      <!-- Photo column -->
      <div class="about-photo-col">
        <div class="about-photo reveal">
          <Image src={portrait} alt="Sayantan Dutta" class="about-photo-img" loading="eager" />
        </div>
      </div>

      <!-- Content column -->
      <div>
        <span class="t-label">About</span>
        <p class="about-intro reveal" style="transition-delay:.1s;">
          I'm a Product Designer who works best where <em>complexity meets clarity</em>, turning systems that are genuinely difficult into experiences that feel obvious.
        </p>

        <!-- Background -->
        <div class="about-block reveal">
          <p class="about-block-lbl">Background</p>
          <p class="t-body">
            Five years in, my work runs from a service design internship in Bengaluru to UX strategy for industrial-safety software in the UK. It began with a Bachelor's in Communication Design and four months at <strong>Pensaar Design</strong>, doing field research and brand work for clients including <strong>McAfee</strong>, <strong>CGAP</strong>, and <strong>ITC</strong>. That internship taught me, early on, that design wasn't about making things beautiful. It was about making decisions visible.
          </p>
          <p class="t-body" style="margin-top:.75rem;">
            That instinct led me to <strong>Tata Consultancy Services</strong>, where I designed across enterprise SaaS, manufacturing technology, and API platforms for clients including <strong>Ericsson</strong> and <strong>Sherwin-Williams</strong>, growing from product designer to design lead. Working at that scale, on platforms with complex stakeholder structures and tight compliance requirements, taught me that good UX is as much about operational rigour as it is about craft.
          </p>
          <p class="t-body" style="margin-top:.75rem;">
            I moved to the UK in 2024 for an MA in Design Management at the University of Southampton, which sharpened how I think about design strategy and leading at a systems level. After that I led UX strategy for HAZOP Edge at Soter Safety Consulting, the project I'm most proud of, before moving into my current role.
          </p>
        </div>

        <!-- Career timeline -->
        <div class="about-block reveal">
          <p class="about-block-lbl">Career, at a glance</p>
          <ol class="timeline" aria-label="Career timeline">
            {timeline.map((t, i) => (
              <li class={`tl-item ${i === timeline.length - 1 ? 'is-now' : ''}`}>
                <span class="tl-year">{t.year}</span>
                <span class="tl-dot" aria-hidden="true"></span>
                <span class="tl-role">{t.role}</span>
                <span class="tl-org">{t.org}</span>
              </li>
            ))}
          </ol>
        </div>

        <!-- Currently: miiGenie AI work -->
        <div class="about-block reveal">
          <p class="about-block-lbl">
            <span class="now-dot" aria-hidden="true"></span>
            Currently
          </p>
          <div class="now-card">
            <p class="now-headline">Leading product design for <em>miiGenie</em>, a voice-first AI companion for elderly users.</p>
            <p class="t-body" style="margin-top:.9rem;">
              I own the full product design end-to-end, from discovery with elderly users and caregivers, through conversational flows, onboarding, and the Figma component library powering iOS and Android. I work in a product trio with the PM and engineering lead, and run the design system that keeps the product consistent and accessible as it scales.
            </p>
            <ul class="now-meta">
              <li><span class="now-meta-k">Role</span><span class="now-meta-v">Lead Product Designer</span></li>
              <li><span class="now-meta-k">Company</span><span class="now-meta-v">dAIs Genie, UK</span></li>
              <li><span class="now-meta-k">Surface</span><span class="now-meta-v">iOS · Android</span></li>
              <li><span class="now-meta-k">Focus</span><span class="now-meta-v">Voice-first AI · Design system · Accessibility</span></li>
            </ul>
          </div>
        </div>

        <!-- What I do -->
        <div class="about-block reveal">
          <p class="about-block-lbl">What I do</p>
          <p class="t-body">
            I specialise in product design where workflows are high-stakes, the users are domain experts, and ambiguity is expensive, from AI companion apps to enterprise B2B SaaS. I bridge design operations and hands-on craft: I can build a design system and lead scrum ceremonies in the same week.
          </p>
          <p class="t-body" style="margin-top:.75rem;">
            I prioritise clarity, accessibility, and measurable outcomes over aesthetic novelty. I've collaborated with founders, product owners, engineers, safety professionals, and enterprise clients across Europe, the US, and the UK.
          </p>
        </div>

        <!-- Tools & Skills -->
        <div class="about-block reveal">
          <p class="about-block-lbl">Tools &amp; Skills</p>

          <!-- Tool grid -->
          <div class="tool-grid" role="list" aria-label="Tools I work with">
            {tools.map((t) => (
              <div class="tool-tile" role="listitem">
                <img src={`/images/tools/${t.file}`} alt="" class="tool-mark" loading="lazy" />
                <span class="tool-name">{t.name}</span>
              </div>
            ))}
          </div>

          <!-- Skill groups -->
          <div class="skill-stack">
            {skillGroups.map((g) => (
              <div class="skill-row">
                <p class="skill-row-lbl">{g.label}</p>
                <ul class="skill-chips">
                  {g.items.map((s) => <li class="skill-chip">{s}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </div>

        <!-- Outside of work -->
        <div class="about-block reveal">
          <p class="about-block-lbl">Outside of work</p>

          <p class="t-body" style="margin:0 0 1.6rem;">
            A curious person, happiest in the mountains, on a beach, or wandering somewhere new. Learning German (slowly). Always looking for a good mocha, never the flat white.
          </p>

          <!-- Hobby tiles -->
          <div class="hobby-grid" role="list" aria-label="Hobbies and interests">
            {hobbies.map((h) => (
              <div class="hobby-tile" role="listitem">
                <span class="hobby-icon" aria-hidden="true">
                  {h.icon === 'badminton' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="5.5" r="2.2" />
                      <path d="M9.8 6.5 5 21M14.2 6.5 19 21M11 7.5 8 21M13 7.5 16 21M12 7.5V21" />
                    </svg>
                  )}
                  {h.icon === 'football' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="12" cy="12" r="9" />
                      <polygon points="12,7.5 15.7,10.2 14.3,14.5 9.7,14.5 8.3,10.2" />
                      <path d="M12 3v4.5M3.5 9.2 8.3 10.2M20.5 9.2l-4.8 1M6 19.5l3.7-5M18 19.5l-3.7-5" />
                    </svg>
                  )}
                  {h.icon === 'frisbee' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                      <ellipse cx="12" cy="11" rx="9" ry="3.5" />
                      <path d="M3 11c0 2 4 3.5 9 3.5s9-1.5 9-3.5" />
                      <ellipse cx="12" cy="11" rx="4" ry="1.5" opacity=".5" />
                    </svg>
                  )}
                  {h.icon === 'mocha' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M17 8h1a4 4 0 1 1 0 8h-1" />
                      <path d="M3 8h14v9a4 4 0 0 1-4 4H7a4 4 0 0 1-4-4Z" />
                      <line x1="6" y1="2" x2="6" y2="4" />
                      <line x1="10" y1="2" x2="10" y2="4" />
                      <line x1="14" y1="2" x2="14" y2="4" />
                    </svg>
                  )}
                  {h.icon === 'mountain' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m8 3 4 8 3-3 6 13H2L8 3z" />
                      <path d="m10.5 7.7 1.5-1.7" opacity=".4" />
                    </svg>
                  )}
                  {h.icon === 'beach' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 4c-2 0-4 1.4-5 3.5C9 6.8 11 7 12 7s3-.2 5-.5C16 4.4 14 3 12 3" />
                      <path d="M12 3v6" />
                      <path d="M9 8.5c-1.5 1.5-2 4.5-1 6.5l4-4" />
                      <path d="M15 8.5c1.5 1.5 2 4.5 1 6.5l-4-4" />
                      <path d="M12 9v12" />
                      <path d="M3 21c2-.7 4-1 6-1 1.5 0 3 .3 3 1 0-.7 1.5-1 3-1 2 0 4 .3 6 1" />
                    </svg>
                  )}
                  {h.icon === 'music' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M9 18V5l12-2v13" />
                      <circle cx="6" cy="18" r="3" />
                      <circle cx="18" cy="16" r="3" />
                    </svg>
                  )}
                  {h.icon === 'film' && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                      <rect width="18" height="18" x="3" y="3" rx="2" />
                      <path d="M7 3v18M3 7.5h4M3 12h18M3 16.5h4M17 3v18M17 7.5h4M17 16.5h4" />
                    </svg>
                  )}
                </span>
                <span class="hobby-name">{h.name}</span>
              </div>
            ))}
          </div>

          <!-- Now -->
          <div class="now-stack">
            <p class="now-stack-lbl">Now</p>
            <div class="now-row">
              {nowItems.map((n) => (
                <div class="now-mini">
                  <span class="now-mini-icon" aria-hidden="true">
                    {n.icon === 'film' && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="18" height="18" x="3" y="3" rx="2" />
                        <path d="M7 3v18M3 7.5h4M3 12h18M3 16.5h4M17 3v18M17 7.5h4M17 16.5h4" />
                      </svg>
                    )}
                    {n.icon === 'book' && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20" />
                        <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
                      </svg>
                    )}
                    {n.icon === 'headphones' && (
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 14h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2H4a1 1 0 0 1-1-1v-6Z" />
                        <path d="M21 14h-3a2 2 0 0 0-2 2v3a2 2 0 0 0 2 2h2a1 1 0 0 0 1-1v-6Z" />
                        <path d="M3 14a9 9 0 0 1 18 0" />
                      </svg>
                    )}
                  </span>
                  <span class="now-mini-cat">{n.cat}</span>
                  <span class="now-mini-title">{n.title}</span>
                  <span class="now-mini-sub">{n.sub}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Lived in -->
          <div class="path-block">
            <p class="path-lbl">Lived in</p>
            <ol class="path" aria-label="Cities I've lived in">
              {cities.map((c, i) => (
                <>
                  <li class={`path-step ${i === cities.length - 1 ? 'is-now' : ''}`}>
                    <span class="path-dot" aria-hidden="true"></span>
                    <span class="path-city">{c}</span>
                  </li>
                  {i < cities.length - 1 && <span class="path-arrow" aria-hidden="true">→</span>}
                </>
              ))}
            </ol>
          </div>
        </div>

        <div class="about-cta reveal">
          <a href="mailto:sayantan7dutta@gmail.com" class="btn btn-primary">
            Get in touch <span class="arrow">→</span>
          </a>
          <a href="https://linkedin.com/in/sayantan-dutta-968033105/" target="_blank" rel="noopener" class="btn">LinkedIn ↗</a>
        </div>
      </div>

    </div>
  </div>
</div>

</Base>

<style>
.about-wrap {
  padding-top: calc(var(--nav-h) + clamp(3rem, 8vw, 5rem));
  padding-bottom: clamp(4rem, 10vw, 7rem);
}
.about-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 5rem;
  align-items: stretch;
}
.about-photo-col { height: 100%; }
.about-photo {
  aspect-ratio: 4/5;
  overflow: hidden;
  border: 1px solid var(--border);
  position: sticky;
  top: calc(var(--nav-h) + 2rem);
}
.about-photo-img {
  width: 100%; height: 100%;
  object-fit: cover;
  filter: grayscale(20%);
  transition: filter .4s;
}
.about-photo:hover .about-photo-img { filter: grayscale(0%); }
.about-intro {
  font-family: var(--font-display);
  font-size: clamp(1.3rem, 3vw, 2.1rem);
  font-weight: 500;
  line-height: 1.3;
  color: var(--text-1);
  margin: 1.5rem 0 2.5rem;
}
.about-intro em { font-style: italic; color: var(--accent); }
.about-block {
  padding: 1.75rem 0;
  border-top: 1px solid var(--border);
}
.about-block:last-of-type { border-bottom: 1px solid var(--border); }
.about-block-lbl {
  font-family: var(--font-mono);
  font-size: .62rem;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--text-3);
  margin-bottom: .875rem;
  display: flex;
  align-items: center;
  gap: .5rem;
}
.about-cta {
  margin-top: 2.5rem;
  display: flex;
  gap: .75rem;
  flex-wrap: wrap;
}

/* ─── Career timeline ─── */
.timeline {
  list-style: none;
  margin: .5rem 0 0;
  padding: 0;
  display: grid;
  grid-template-columns: 1fr;
  gap: 0;
  position: relative;
}
.tl-item {
  display: grid;
  grid-template-columns: 8.5rem 1.5rem 1fr;
  grid-template-areas:
    "year dot role"
    "year dot org";
  column-gap: 0;
  align-items: baseline;
  padding: 1rem 0;
  border-top: 1px dashed var(--border);
  position: relative;
}
.tl-item:first-child { border-top: 0; padding-top: 0; }
.tl-year {
  grid-area: year;
  font-family: var(--font-mono);
  font-size: .68rem;
  letter-spacing: .08em;
  color: var(--text-3);
  align-self: center;
}
.tl-dot {
  grid-area: dot;
  width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--text-3);
  align-self: center;
  justify-self: start;
  transition: background .25s, transform .25s;
}
.tl-role {
  grid-area: role;
  font-family: var(--font-display);
  font-size: 1.1rem;
  font-weight: 500;
  color: var(--text-1);
  line-height: 1.3;
}
.tl-org {
  grid-area: org;
  font-family: var(--font-mono);
  font-size: .68rem;
  color: var(--text-2);
  margin-top: .15rem;
}
.tl-item.is-now .tl-dot {
  background: var(--accent);
  box-shadow: 0 0 0 4px var(--accent-bg);
}
.tl-item.is-now .tl-role { color: var(--accent); }
.tl-item:hover .tl-dot { transform: scale(1.4); background: var(--accent); }

/* ─── Currently: miiGenie callout ─── */
.now-dot {
  width: 8px; height: 8px;
  border-radius: 50%;
  background: var(--accent);
  display: inline-block;
  box-shadow: 0 0 0 4px var(--accent-bg);
  animation: now-pulse 2.4s ease-in-out infinite;
}
@keyframes now-pulse {
  0%, 100% { box-shadow: 0 0 0 4px var(--accent-bg); }
  50%      { box-shadow: 0 0 0 8px transparent; }
}
.now-card {
  border: 1px solid var(--border);
  border-left: 3px solid var(--accent);
  background: var(--accent-bg);
  padding: 1.6rem 1.7rem;
  border-radius: 2px;
}
.now-headline {
  font-family: var(--font-display);
  font-size: clamp(1.15rem, 2vw, 1.45rem);
  font-weight: 500;
  line-height: 1.35;
  color: var(--text-1);
  margin: 0;
}
.now-headline em { font-style: italic; color: var(--accent); }
.now-meta {
  list-style: none;
  margin: 1.2rem 0 0;
  padding: 1.1rem 0 0;
  border-top: 1px solid var(--border);
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: .65rem 1.5rem;
}
.now-meta li {
  display: flex;
  flex-direction: column;
  gap: .15rem;
}
.now-meta-k {
  font-family: var(--font-mono);
  font-size: .55rem;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--text-3);
}
.now-meta-v {
  font-size: .82rem;
  color: var(--text-1);
  line-height: 1.4;
}

/* ─── Tools & Skills ─── */
.tool-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(86px, 1fr));
  gap: .55rem;
  margin: .5rem 0 2.25rem;
}
.tool-tile {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: .55rem;
  padding: 1rem .5rem .7rem;
  border: 1px solid var(--border);
  border-radius: 2px;
  background: var(--surface);
  transition: border-color .25s, transform .25s, background .25s;
}
.tool-mark {
  width: 26px; height: 26px;
  object-fit: contain;
  filter: grayscale(100%) opacity(.55);
  transition: filter .25s, transform .25s;
}
.tool-name {
  font-family: var(--font-mono);
  font-size: .58rem;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--text-3);
  transition: color .25s;
}
.tool-tile:hover {
  border-color: var(--accent);
  background: var(--accent-bg);
  transform: translateY(-2px);
}
.tool-tile:hover .tool-mark { filter: grayscale(0%) opacity(1); transform: scale(1.05); }
.tool-tile:hover .tool-name { color: var(--text-1); }

.skill-stack {
  display: flex;
  flex-direction: column;
  gap: 1.4rem;
}
.skill-row-lbl {
  font-family: var(--font-mono);
  font-size: .58rem;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--text-3);
  margin: 0 0 .65rem;
}
.skill-chips {
  list-style: none;
  margin: 0; padding: 0;
  display: flex;
  flex-wrap: wrap;
  gap: .4rem;
}
.skill-chip {
  font-size: .76rem;
  line-height: 1;
  color: var(--text-2);
  border: 1px solid var(--border);
  border-radius: 2px;
  padding: .5rem .7rem;
  background: var(--surface);
  transition: border-color .2s, color .2s, background .2s;
}
.skill-chip:hover {
  border-color: var(--accent);
